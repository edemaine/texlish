{ compile, generate } from ../src/main.civet
type { Argument, ASTNode } from ../src/types.civet
{ find, iterate } from ../src/util.civet
assert from assert

function findNode(source: string, type: ASTNode["type"]): ASTNode
  ast := compile source, ast: true, fragment: true
  node := find ast, (node): node is ASTNode =>
    node is like { ^type }
  assert node, `Missing ${type} node`
  node

describe 'semantic shorthand AST', ->
  it 'records generic command and environment arguments with body aliases', ->
    for [source, forms, delimiters] of [
      ['\\custom: *body*', ['colon'], ['required']]
      ['\\custom:\n  ~ short\n  - *body*\n  final', ['bullet', 'bullet', 'final'], ['optional', 'required', 'required']]
      [': custom[short]{*body*}\n  text', ['bracketed', 'braced'], ['optional', 'required']]
      [': custom: *body*\n  text', ['colon'], ['required']]
      [': custom:\n  ~ short\n  - *body*\n  text', ['bullet', 'bullet'], ['optional', 'required']]
    ] as const
      ast := compile source, ast: true, fragment: true
      args := [...iterate(ast)].filter (node): node is Argument => node is like { type: 'Argument' }
      assert.deepEqual args.map(.form), forms
      assert.deepEqual args.map(.delimiter), delimiters
      for arg of args
        assert.equal arg.specIndex, undefined
        assert [...iterate(arg.children)].includes arg.body
      assert generate(ast).includes '\\emph{body}'

  it 'records reference targets and variants', ->
    node := findNode '@^note', 'Ref'
    assert node is like { type: "Ref" }
    assert.equal node.variant, '@^'
    assert.equal node.target, 'footnote:note'
    assert.equal generate(node), `${node.style}{footnote:note}`

  it 'records citation keys without normalizing emitted whitespace', ->
    node := findNode '[[first, second]]', 'Citation'
    assert node is like { type: "Citation" }
    assert.deepEqual node.keys, ['first', 'second']
    assert.equal generate(node), `${node.style}{first, second}`

  it 'exposes image destinations and aliases parsed alternative text', ->
    node := findNode '![*caption*](image.pdf)', 'Image'
    assert node is like { type: "Image" }
    assert.equal node.url, 'image.pdf'
    assert [...iterate(node.children)].includes node.alt
    assert.equal generate(node.alt), '\\emph{caption}'

  it 'keeps literal inline code content when escaping its output', ->
    node := findNode '` a%b `', 'CodeSpan'
    assert node is like { type: "CodeSpan" }
    assert.equal node.style, '\\texttt'
    assert.equal node.delimiter, undefined
    assert.equal node.code, 'a%b'
    assert.deepEqual node.body, { type: "Raw", token: 'a\\%b' }
    assert.strictEqual node.children[2], node.body
    assert.equal generate(node.body), 'a\\%b'
    assert.equal generate(node), '\\texttt{a\\%b}'

  it 'aliases literal inline code for a configured verbatim style', ->
    ast := compile '::styles ` = \\verb\n` a%b `', ast: true, fragment: true
    node := find ast, (node) => node is like { type: "CodeSpan" }
    assert node is like { type: "CodeSpan" }
    assert.equal node.delimiter, '`'
    assert.equal node.code, 'a%b'
    assert.deepEqual node.body, { type: "Verbatim", token: 'a%b' }
    assert.strictEqual node.children[2], node.body
    assert.equal generate(node.body), 'a%b'
    assert.equal generate(node), '\\verb`a%b`'

  it 'aliases inline code for a braced verbatim argument', ->
    ast := compile '::styles ` = \\hyperbaseurl\n` a%b `', ast: true, fragment: true
    node := find ast, (node) => node is like { type: "CodeSpan" }
    assert node is like { type: "CodeSpan" }
    assert.equal node.code, 'a%b'
    assert.equal node.delimiter, undefined
    assert.deepEqual node.body, { type: "Verbatim", token: 'a%b' }
    assert.strictEqual node.children[2], node.body
    assert.equal generate(node), '\\hyperbaseurl{a%b}'

  it 'aliases escaped inline code for both EscVerb styles', ->
    for style of ['\\EscVerb', '\\EscVerb*']
      ast := compile '`\\^~`', ast: true, fragment: true, styles: {'`': style}
      node := find ast, (node) => node is like { type: "CodeSpan" }
      assert node is like { type: "CodeSpan" }
      assert.equal node.code, '\\^~'
      assert.equal node.delimiter, undefined
      assert.deepEqual node.body, { type: "Raw", token: '\\\\\\^\\~' }
      assert.strictEqual node.children[2], node.body
      assert.equal generate(node), style + '{\\\\\\^\\~}'

  it 'keeps literal code content when escaping a link label', ->
    node := findNode '[`a%b`](https://example.com)', 'CodeSpan'
    assert node is like { type: "CodeSpan" }
    assert.equal node.style, '\\texttt'
    assert.equal node.delimiter, undefined
    assert.equal node.code, 'a%b'
    assert.deepEqual node.body, { type: "Raw", token: 'a\\%b' }
    assert.strictEqual node.children[2], node.body
    assert.equal generate(node), '\\texttt{a\\%b}'

  it 'distinguishes fenced code from ordinary environments', ->
    node := findNode '```text\na%b\n```', 'CodeBlock'
    assert node is like { type: "CodeBlock" }
    assert.equal node.info, 'text'
    assert.equal node.env, 'verbatim'
    assert.deepEqual node.body, { type: "Verbatim", token: 'a%b\n' }
    assert node.children.includes node.body
    assert.equal generate(node), '\\begin{verbatim}\na%b\n\\end{verbatim}'

  it 'records horizontal-rule markers and selected styles', ->
    node := findNode '- - -', 'HorizontalRule'
    assert node is like { type: "HorizontalRule" }
    assert.equal node.marker, '- - -'
    assert.equal generate(node), node.style
