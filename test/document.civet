{ r, testCase } from ./helper.civet

describe '\\begin/\\end{document}', ->
  testCase r'''
    add around text
    ---
    Hello, world!
    ---
    \documentclass[11pt]{article}

    \begin{document}
    Hello, world!
    \end{document}

  ''', fragment: false

  testCase r'''
    existing braced end
    ---
    \end{document}
    Hello, world!
    ---
    \documentclass[11pt]{article}

    \begin{document}
    \end{document}
    Hello, world!
  ''', fragment: false

  testCase r'''
    existing braced end with space
    ---
    \end {document}
    Hello, world!
    ---
    \documentclass[11pt]{article}

    \begin{document}
    \end {document}
    Hello, world!
  ''', fragment: false

  testCase r'''
    existing begin colon
    ---
    \begin: document
    Hello, world!
    ---
    \documentclass[11pt]{article}
    \begin{document}%
    Hello, world!
    \end{document}

  ''', fragment: false

  testCase r'''
    existing end colon
    ---
    \end: document
    Hello, world!
    ---
    \documentclass[11pt]{article}

    \begin{document}
    \end{document}%
    Hello, world!
  ''', fragment: false

  testCase r'''
    existing environment
    ---
    : document
      Hello, world!
    ---
    \documentclass[11pt]{article}
    \begin{document}
      Hello, world!
    \end{document}
  ''', fragment: false

  testCase r'''
    begin placement
    ---
    % comment
      % comment
    \usepackage{foo}
    :: use foo
    :: preamble cheating
    \foo
      {bar}
    # Hello
    ---
    \documentclass[11pt]{article}
    % comment
      % comment
    \usepackage{foo}
    \usepackage{foo}
    cheating
    \foo
      {bar}

    \begin{document}
    \section{Hello}
    \end{document}

  ''', fragment: false

  testCase r'''
    begin placement before environment
    ---
    : theorem
    ---
    \documentclass[11pt]{article}

    \begin{document}
    \begin{theorem}
    \end{theorem}
    \end{document}

  ''', fragment: false

  testCase r'''
    begin placement before list
    ---
    * hi
    ---
    \documentclass[11pt]{article}

    \begin{document}
    \begin{itemize}
    \item hi
    \end{itemize}
    \end{document}

  ''', fragment: false

describe 'automatic \\defn', ->
  testCase r'''
    add \defn definition when default *** style is used
    ---
    That's ***important***.
    ---
    \documentclass[11pt]{article}
    \providecommand\defn[1]{\textbf{\textit{\boldmath #1}}}

    \begin{document}
    That's \defn{important}.
    \end{document}

  ''', fragment: false

  testCase r'''
    add \defn definition when explicit command is used
    ---
    That's \defn{important}.
    ---
    \documentclass[11pt]{article}
    \providecommand\defn[1]{\textbf{\textit{\boldmath #1}}}

    \begin{document}
    That's \defn{important}.
    \end{document}

  ''', fragment: false

  testCase r'''
    no \defn definition when custom *** style is used
    ---
    ::styles
      *** = \texttt
    That's ***literal***.
    ---
    \documentclass[11pt]{article}

    \begin{document}
    That's \texttt{literal}.
    \end{document}

  ''', fragment: false

  testCase r'''
    add \defn definition after user preamble
    ---
    ::preamble \newcommand\foo{bar}
    That's ***important***.
    ---
    \documentclass[11pt]{article}
    \newcommand\foo{bar}
    \providecommand\defn[1]{\textbf{\textit{\boldmath #1}}}

    \begin{document}
    That's \defn{important}.
    \end{document}

  ''', fragment: false

  testCase r'''
    no \defn definition after user \newcommand
    ---
    \newcommand\defn[1]{\emph{#1}}
    That's ***important***.
    ---
    \documentclass[11pt]{article}
    \newcommand\defn[1]{\emph{#1}}

    \begin{document}
    That's \defn{important}.
    \end{document}

  ''', fragment: false

  testCase r'''
    no \defn definition after user braced \newcommand
    ---
    \newcommand{\defn}[1]{\emph{#1}}
    That's ***important***.
    ---
    \documentclass[11pt]{article}
    \newcommand{\defn}[1]{\emph{#1}}

    \begin{document}
    That's \defn{important}.
    \end{document}

  ''', fragment: false

  testCase r'''
    no \defn definition after user \def
    ---
    \def\defn#1{\emph{#1}}
    That's ***important***.
    ---
    \documentclass[11pt]{article}
    \def\defn#1{\emph{#1}}

    \begin{document}
    That's \defn{important}.
    \end{document}

  ''', fragment: false

  testCase r'''
    no \defn definition after user ::preamble definition
    ---
    ::preamble \newcommand\defn[1]{\emph{#1}}
    That's ***important***.
    ---
    \documentclass[11pt]{article}
    \newcommand\defn[1]{\emph{#1}}

    \begin{document}
    That's \defn{important}.
    \end{document}

  ''', fragment: false

  testCase r'''
    add \defn definition before existing document environment
    ---
    : document
      That's ***important***.
    ---
    \documentclass[11pt]{article}
    \providecommand\defn[1]{\textbf{\textit{\boldmath #1}}}
    \begin{document}
      That's \defn{important}.
    \end{document}
  ''', fragment: false

  testCase r'''
    add \defn definition before existing braced begin
    ---
    \begin{document}
    That's ***important***.
    \end{document}
    ---
    \documentclass[11pt]{article}
    \providecommand\defn[1]{\textbf{\textit{\boldmath #1}}}
    \begin{document}
    That's \defn{important}.
    \end{document}
  ''', fragment: false

describe '\\maketitle', ->
  testCase r'''
    begin placement before \maketitle
    ---
    \maketitle
    Hello
    ---
    \documentclass[11pt]{article}

    \begin{document}
    \maketitle
    Hello
    \end{document}

  ''', fragment: false

  testCase r'''
    existing \title and \maketitle
    ---
    \title{Title}
    \maketitle
    Hello
    ---
    \documentclass[11pt]{article}
    \title{Title}

    \begin{document}
    \maketitle
    Hello
    \end{document}

  ''', fragment: false

  testCase r'''
    \title and no \maketitle
    ---
    \title{Title}
    Hello
    ---
    \documentclass[11pt]{article}
    \title{Title}

    \begin{document}
    \maketitle
    Hello
    \end{document}

  ''', fragment: false

  testCase r'''
    \title and existing document
    ---
    \title{Title}
    \begin{document}
    Hello
    \end{document}
    ---
    \documentclass[11pt]{article}
    \title{Title}
    \begin{document}
    Hello
    \end{document}
  ''', fragment: false

describe '::preamble', ->
  testCase r'''
    preamble after text
    ---
    Hello
    :: preamble \newtheorem{thm}{Theorem}
    : thm
    ::preamble \newtheorem{lem}{Lemma}
    : lem
    ::preamble
      %more text
    ::use foo
    ---
    \documentclass[11pt]{article}
    \newtheorem{thm}{Theorem}
    \newtheorem{lem}{Lemma}

      %more text
    \usepackage{foo}

    \begin{document}
    Hello
    \begin{thm}
    \end{thm}
    \begin{lem}
    \end{lem}
    \end{document}

  ''', fragment: false

  testCase r'''
    preamble before text
    ---
    :: preamble \newtheorem{thm}{Theorem}
    ::preamble
      %more text
    ::use foo
    Hello
    ---
    \documentclass[11pt]{article}
    \newtheorem{thm}{Theorem}

      %more text
    \usepackage{foo}

    \begin{document}
    Hello
    \end{document}

  ''', fragment: false

  testCase r'''
    preamble before explicit begin
    ---
    Hello
    :: preamble \newtheorem{thm}{Theorem}
    ::preamble
      %more text
    ::use foo
    \begin{document}
    ---
    \documentclass[11pt]{article}
    Hello
    \newtheorem{thm}{Theorem}

      %more text
    \usepackage{foo}
    \begin{document}
    \end{document}

  ''', fragment: false

  testCase r'''
    preamble inside : document
    ---
    : document
      :: preamble \newtheorem{thm}{Theorem}
      ::preamble
        %more text
      ::use foo
      Hello
    ---
    \documentclass[11pt]{article}
      \newtheorem{thm}{Theorem}
      
        %more text
      \usepackage{foo}
    \begin{document}
      Hello
    \end{document}
  ''', fragment: false

  testCase r'''
    ::preamble and ::uses
    ---
    ::preamble \newtheorem{thm}{Theorem}
    :: use
      amsthm
    ::preamble \newtheorem{lem}{Lemma}
    \newtheorem:
      - theorem
      - Theorem
    ---
    \documentclass[11pt]{article}
    \newtheorem{thm}{Theorem}

      \usepackage{amsthm}
    \newtheorem{lem}{Lemma}
    \newtheorem
       {theorem}%
       {Theorem}%
    \begin{document}

    \end{document}

  ''', fragment: false

  testCase r'''
    nested ::preamble
    ---
    Hello
    ::preamble
      before
      ::preamble nested
      after
    ---
    \documentclass[11pt]{article}

      before
      nested
      after

    \begin{document}
    Hello
    \end{document}

  ''', fragment: false

describe '\\documentclass', ->
  testCase r'''
    existing
    ---
    \documentclass[12pt,letterpaper]{article}
    ---
    \documentclass[12pt,letterpaper]{article}
  '''
