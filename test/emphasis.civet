    // Markdown allows \* to precede a delimiter block.
    // This isn't useful in LaTeX (\* is a line-breakable multiplication).
    // Instead, {*} is how we write an escaped asterisk.
    testCase r'''
      437
      ---
      foo *{*}*
      ---
      foo \emph{{*}}
    '''

    testCase r'''
      438
      ---
      foo *_*
      ---
      foo \emph{_}
    '''

