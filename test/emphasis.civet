{ r, testCase } from ./helper.civet

describe 'Markdown emphasis (*/**/***)', ->
  testCase r'''
    single word at the beginning
    ---
    *emphasized* text
    ---
    \emph{emphasized} text
  '''

  testCase r'''
    single word in the middle
    ---
    hello **world**!
    ---
    hello \textbf{world}!
  '''

  testCase r'''
    single word at the end
    ---
    that's ***it***
    ---
    that's \defn{it}
  '''

  testCase r'''
    multiple words
    ---
    *emphasized* and **really emphasized** and ***super emphasized***
    ---
    \emph{emphasized} and \textbf{really emphasized} and \defn{super emphasized}
  '''

  testCase r'''
    multiple lines
    ---
    *emphasized* and **really
    emphasized** and ***super
    emphasized***
    ---
    \emph{emphasized} and \textbf{really
    emphasized} and \defn{super
    emphasized}
  '''

  testCase r'''
    custom style
    ---
    :: styles
      * = \textit
      ** = \textsf
      *** = \texttt
    *italic*
    **sans-serif**
    ***teletype***
    ---
    \textit{italic}
    \textsf{sans-serif}
    \texttt{teletype}
  '''

  testCase r'''
    empty styles
    ---
    ::styles
    *italic*
    ---
    \emph{italic}
  '''

  testCase r'''
    nested styles
    ---
    ::styles
      family:
        serif = \textrm
    *serif*
    ---
    \emph{serif}
  '''

  testCase r'''
    {} escaping
    ---
    {*}not italic{*}
    {**}not bold{**}
    {***}not bold italic{***}
    ---
    {*}not italic{*}
    {**}not bold{**}
    {***}not bold italic{***}
  '''

  // https://spec.commonmark.org/0.31.2/#emphasis-and-strong-emphasis
  describe 'commonmark spec examples', ->
    testCase r'''
      350
      ---
      *foo bar*
      ---
      \emph{foo bar}
    '''

    testCase r'''
      351
      ---
      a * foo bar*
      ---
      a * foo bar*
    '''

    testCase r'''
      352
      ---
      a*"foo"*
      ---
      a*"foo"*
    '''

    testCase r'''
      353
      ---
      a * a *
      ---
      a * a *
    '''

    testCase r'''
      354
      ---
      *£*bravo.
      ---
      *£*bravo.
    '''

    testCase r'''
      355
      ---
      foo*bar*
      ---
      foo\emph{bar}
    '''

    testCase r'''
      356
      ---
      5*6*78
      ---
      5\emph{6}78
    '''

    testCase.skip r'''
      357
      ---
      _foo bar_
      ---
      \emph{foo bar}
    '''

    testCase r'''
      358
      ---
      _ foo bar_
      ---
      _ foo bar_
    '''

    testCase r'''
      359
      ---
      a_"foo"_
      ---
      a_"foo"_
    '''

    testCase r'''
      360
      ---
      foo_bar_
      ---
      foo_bar_
    '''

    testCase r'''
      361
      ---
      5_6_78
      ---
      5_6_{78}
    '''

    testCase r'''
      362
      ---
      пристаням_стремятся_
      ---
      пристаням_стремятся_
    '''

    testCase r'''
      363
      ---
      aa_"bb"_cc
      ---
      aa_"bb"_cc
    '''

    testCase.skip r'''
      364
      ---
      foo-_(bar)_
      ---
      foo-\emph{bar}
    '''

    testCase r'''
      365
      ---
      _foo*
      ---
      _foo*
    '''

    testCase r'''
      366
      ---
      *foo bar *
      ---
