assert from assert
fs from node:fs/promises
os from node:os
path from node:path
{ parseCompilerOption, parseConfigAssignment } from ../src/config.civet
{ findInDir, loadConfig } from ../src/config-file.civet

describe 'project config', ->
  it 'finds and loads texlishconfig.json', ->
    dir := await fs.mkdtemp path.join(os.tmpdir(), 'texlish-config-')
    try
      configPath := path.join dir, 'texlishconfig.json'
      await fs.writeFile configPath, JSON.stringify({
        scriptGrouping: 'alpha'
      })
      found := await findInDir dir
      assert.equal found, configPath
      config := await loadConfig found!
      assert.equal config.scriptGrouping, 'alpha'
    finally
      await fs.rm dir,
        recursive: true
        force: true

  it 'loads nested style config and latexCompat', ->
    dir := await fs.mkdtemp path.join(os.tmpdir(), 'texlish-config-')
    try
      configPath := path.join dir, 'texlishconfig.json'
      await fs.writeFile configPath, JSON.stringify({
        styles:
          '*': '\\textit'
          '@': '\\cref'
        latexCompat: true
      })
      config := await loadConfig configPath
      assert.equal config.scriptGrouping, 'none'
      assert.equal config.scriptParens, false
      assert.equal config.styles!['*'], '\\textit'
      assert.equal config.styles!['@'], '\\cref'
      assert.equal config.styles!['**'], '\\textbf'
    finally
      await fs.rm dir,
        recursive: true
        force: true

  it 'loads markdown compatibility flag', ->
    dir := await fs.mkdtemp path.join(os.tmpdir(), 'texlish-config-')
    try
      configPath := path.join dir, 'texlishconfig.json'
      await fs.writeFile configPath, JSON.stringify({
        markdownCompat: false
      })
      config := await loadConfig configPath
      assert.equal config.markdownEmphasis, false
      assert.equal config.markdownFootnotes, false
      assert.equal config.markdownHeadings, false
      assert.equal config.markdownHorizontalRules, false
      assert.equal config.markdownLinks, false
      assert.equal config.markdownLists, false
      assert.equal config.smartQuotes, false
    finally
      await fs.rm dir,
        recursive: true
        force: true

  it 'loads markdown backtick threshold', ->
    dir := await fs.mkdtemp path.join(os.tmpdir(), 'texlish-config-')
    try
      configPath := path.join dir, 'texlishconfig.json'
      await fs.writeFile configPath, JSON.stringify({
        markdownBackticks: 3
      })
      config := await loadConfig configPath
      assert.equal config.markdownBackticks, 3
    finally
      await fs.rm dir,
        recursive: true
        force: true

  it 'loads nested quote config', ->
    dir := await fs.mkdtemp path.join(os.tmpdir(), 'texlish-config-')
    try
      configPath := path.join dir, 'texlishconfig.json'
      await fs.writeFile configPath, JSON.stringify({
        quotes:
          '"':
            open: '<<'
            close: '>>'
      })
      config := await loadConfig configPath
      doubleQuotes := config.quotes!['"']!
      singleQuotes := config.quotes!["'"]!
      assert.equal doubleQuotes.open, '<<'
      assert.equal doubleQuotes.close, '>>'
      assert.equal singleQuotes.open, '`'
    finally
      await fs.rm dir,
        recursive: true
        force: true

  it 'terminates trailing quote macros in project config', ->
    dir := await fs.mkdtemp path.join(os.tmpdir(), 'texlish-config-')
    try
      configPath := path.join dir, 'texlishconfig.json'
      await fs.writeFile configPath, JSON.stringify({
        quotes:
          '"':
            open: '\\quotedblbase'
            close: '\\textquotedblleft{}'
          "'":
            open: '\\quotesinglbase'
            close: "\\textquoteleft\\,"
      })
      config := await loadConfig configPath
      doubleQuotes := config.quotes!['"']!
      singleQuotes := config.quotes!["'"]!
      assert.equal doubleQuotes.open, '\\quotedblbase{}'
      assert.equal doubleQuotes.close, '\\textquotedblleft{}'
      assert.equal singleQuotes.open, '\\quotesinglbase{}'
      assert.equal singleQuotes.close, "\\textquoteleft\\,"
    finally
      await fs.rm dir,
        recursive: true
        force: true

  it 'loads YAML quote-first dotted quote config', ->
    dir := await fs.mkdtemp path.join(os.tmpdir(), 'texlish-config-')
    try
      configPath := path.join dir, 'texlishconfig.yaml'
      await fs.writeFile configPath, "quotes:\n  '\".open': \"``\"\n  '\".close': \"''\"\n"
      config := await loadConfig configPath
      doubleQuotes := config.quotes!['"']!
      assert.equal doubleQuotes.open, '``'
      assert.equal doubleQuotes.close, "''"
    finally
      await fs.rm dir,
        recursive: true
        force: true

  it 'loads project config dotted key shorthand', ->
    dir := await fs.mkdtemp path.join(os.tmpdir(), 'texlish-config-')
    try
      configPath := path.join dir, 'texlishconfig.json'
      await fs.writeFile configPath, JSON.stringify({
        'styles.*': '\\textit'
        'quotes."':
          close: '>>'
      })
      config := await loadConfig configPath
      assert.equal config.styles!['*'], '\\textit'
      assert.equal config.quotes!['"']!.close, '>>'
    finally
      await fs.rm dir,
        recursive: true
        force: true

describe '--config assignment', ->
  it 'parses key=value', ->
    assert.deepEqual parseConfigAssignment('scriptGrouping=alphanumeric'),
      key: 'scriptGrouping'
      value: 'alphanumeric'

  it 'parses key with implicit true', ->
    assert.deepEqual parseConfigAssignment('latexCompat'),
      key: 'latexCompat'
      value: true

  it 'parses -key shorthand with implicit false', ->
    assert.deepEqual parseConfigAssignment('-markdownLinks'),
      key: 'markdownLinks'
      value: false

  it 'rejects invalid assignment syntax', ->
    assert.throws (
      => parseConfigAssignment('scriptGrouping alpha')
    ), /Expected key or key=value/

  it 'rejects missing scriptGrouping value', ->
    assert.throws (
      => parseCompilerOption('scriptGrouping', true)
    ), /must be a string/

  it 'parses style key paths', ->
    assert.deepEqual parseCompilerOption('styles.*', '\\textit'),
      key: 'styles'
      value:
        '*': '\\textit'

  it 'parses boolean config options', ->
    assert.deepEqual parseCompilerOption('colonCommands', false),
      key: 'colonCommands'
      value: false
    assert.deepEqual parseCompilerOption('colonEnvironments', false),
      key: 'colonEnvironments'
      value: false
    assert.deepEqual parseCompilerOption('citeShorthand', false),
      key: 'citeShorthand'
      value: false
    assert.deepEqual parseCompilerOption('scriptParens', false),
      key: 'scriptParens'
      value: false
    assert.deepEqual parseCompilerOption('markdownEmphasis', false),
      key: 'markdownEmphasis'
      value: false
    assert.deepEqual parseCompilerOption('markdownFootnotes', false),
      key: 'markdownFootnotes'
      value: false
    assert.deepEqual parseCompilerOption('markdownHeadings', false),
      key: 'markdownHeadings'
      value: false
    assert.deepEqual parseCompilerOption('markdownLinks', false),
      key: 'markdownLinks'
      value: false
    assert.deepEqual parseCompilerOption('markdownLists', false),
      key: 'markdownLists'
      value: false
    assert.deepEqual parseCompilerOption('smartQuotes', false),
      key: 'smartQuotes'
      value: false
    assert.deepEqual parseCompilerOption('markdownHorizontalRules', false),
      key: 'markdownHorizontalRules'
      value: false
    assert.deepEqual parseCompilerOption('markdownCompat', false),
      key: 'markdownCompat'
      value: false
    assert.deepEqual parseCompilerOption('refShorthand', false),
      key: 'refShorthand'
      value: false

  it 'parses quote config options', ->
    assert.deepEqual parseCompilerOption(['quotes', '"', 'open'], '<<'),
      key: 'quotes'
      value:
        '"':
          open: '<<'
    assert.deepEqual parseCompilerOption(['quotes', '"', 'close'], '>>'),
      key: 'quotes'
      value:
        '"':
          close: '>>'
    assert.throws (
      => parseCompilerOption(['quotes', 'open', '"'], '<<')
    ), /Unknown config option/

  it 'parses markdown backtick threshold', ->
    assert.deepEqual parseCompilerOption('markdownBackticks', '3'),
      key: 'markdownBackticks'
      value: 3
    assert.deepEqual parseCompilerOption('markdownBackticks', true),
      key: 'markdownBackticks'
      value: 1
    assert.deepEqual parseCompilerOption('markdownBackticks', false),
      key: 'markdownBackticks'
      value: 0
    assert.deepEqual parseCompilerOption('markdownBackticks', 'ON'),
      key: 'markdownBackticks'
      value: 1
    assert.deepEqual parseCompilerOption('markdownBackticks', 'OFF'),
      key: 'markdownBackticks'
      value: 0

  it 'rejects invalid markdown backtick thresholds', ->
    assert.throws (
      => parseCompilerOption('markdownBackticks', '-1')
    ), /nonnegative integer/
    assert.throws (
      => parseCompilerOption('markdownBackticks', '1.5')
    ), /nonnegative integer/
