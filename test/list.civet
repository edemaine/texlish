{ r, testCase } from ./helper.civet

describe 'unordered lists', ->
  testCase r'''
    single-line bullets
    ---
    - one
    * two
    ~ three
    ---
    \begin{itemize}
    \item one
    \item two
    \item three
    \end{itemize}
  '''

  testCase r'''
    bullets with indentation
    ---
    - hello
      world
      !
    *
      goodbye
    ---
    \begin{itemize}
    \item hello
      world
      !
    \item
      goodbye
    \end{itemize}
  '''

  testCase r'''
    nested bullets
    ---
    - hello
      - world
      - you
    * goodbye
      - cruel
        - world
    ---
    \begin{itemize}
    \item hello
      \begin{itemize}
      \item world
      \item you
      \end{itemize}
    \item goodbye
      \begin{itemize}
      \item cruel
        \begin{itemize}
        \item world
        \end{itemize}
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    same-line environment bullet
    ---
    - : environment
        content
    ---
    \begin{itemize}
    \item \begin{environment}
        content
      \end{environment}
    \end{itemize}
  '''

  // No `r` because this fixture relies on \t becoming real tabs.
  testCase '''
    same-line environment bullet with tab marker
    ---
    -\t: environment
    \t\tcontent
    ---
    \\begin{itemize}
    \\item\t\\begin{environment}
    \t\tcontent
     \t\\end{environment}
    \\end{itemize}
  '''

  testCase r'''
    same-line environment bullet with list-item body
    ---
    - : environment
      body
    ---
    \begin{itemize}
    \item \begin{environment}
      \end{environment}
      body
    \end{itemize}
  '''

  testCase r'''
    same-line environment bullet with argument
    ---
    - : environment:
        - arg
        env body
      body
    ---
    \begin{itemize}
    \item \begin{environment}
         {arg}%
        env body
      \end{environment}
      body
    \end{itemize}
  '''

  testCase r'''
    same-line nested bullets
    ---
    - - x
      - y
    ---
    \begin{itemize}
    \item \begin{itemize}
      \item x
      \item y
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    triple same-line nested bullet
    ---
    - - - x
    ---
    \begin{itemize}
    \item \begin{itemize}
      \item \begin{itemize}
        \item x
        \end{itemize}
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    same-line raw tex bullet
    ---
    - ::tex \foo{*raw* [link](https://example.com) @ref}
    ---
    \begin{itemize}
    \item \foo{*raw* [link](https://example.com) @ref}
    \end{itemize}
  '''

  testCase r'''
    commented-out bullets do not interrupt list
    ---
    - one
    %* two
    %- also two
    ~ three
    ---
    \begin{itemize}
    \item one
    %* two
    %- also two
    \item three
    \end{itemize}
  '''

  testCase r'''
    comments before first bullet stay outside list
    ---
    %* skip one
    %- skip two
    - one
    - two
    ---
    %* skip one
    %- skip two
    \begin{itemize}
    \item one
    \item two
    \end{itemize}
  '''

  testCase r'''
    disabled by compiler option
    ---
    - one
    * two
    ---
    - one
    * two
  ''', markdownLists: false

  testCase r'''
    disabled by markdownCompat shorthand
    ---
    ::config -markdownCompat
    - one
    * two
    ---
    - one
    * two
  '''

  testCase r'''
    plain brackets do not consume indented bullets
    ---
    - [foo
      - bar]
    ---
    \begin{itemize}
    \item [foo
      \begin{itemize}
      \item bar]
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    plain parens do not consume indented bullets
    ---
    - (foo
      - bar)
    ---
    \begin{itemize}
    \item (foo
      \begin{itemize}
      \item bar)
      \end{itemize}
    \end{itemize}
  '''

describe 'checklists', ->
  testCase r'''
    unchecked and checked items
    ---
    - [ ] To do
    - [x] Done
    - [X] Also done
    ---
    \begin{itemize}
    \item[$\square$] To do
    \item[$\boxtimes$] Done
    \item[$\boxtimes$] Also done
    \end{itemize}
  '''

  testCase r'''
    mixed and nested checklist items
    ---
    - ordinary
    - [ ] parent
      - [x] child
      continuation
    * [x] last
    ---
    \begin{itemize}
    \item ordinary
    \item[$\square$] parent
      \begin{itemize}
      \item[$\boxtimes$] child
      \end{itemize}
      continuation
    \item[$\boxtimes$] last
    \end{itemize}
  '''

  testCase r'''
    custom checklist styles
    ---
    ::styles
      [ ] = EMPTY
      [x] = CHECKED
      [X] = VERIFIED
    - [ ] To do
    - [x] Done
    - [X] Verified
    ---
    \begin{itemize}
    \item[EMPTY] To do
    \item[CHECKED] Done
    \item[VERIFIED] Verified
    \end{itemize}
  '''

  testCase r'''
    custom styled markers
    ---
    ::styles
      [+] = $\boxplus$
      [skip] = SKIP
      [no] = NO
      [in progress] = WAITING
      [🚀] = ROCKET
    - [+] Added
    - [skip] Optional
    - [no] Rejected
    - [in progress] Started
    - [🚀] Launched
    - [NO] Case-sensitive
    - [unknown] Ordinary
    ---
    \begin{itemize}
    \item[$\boxplus$] Added
    \item[SKIP] Optional
    \item[NO] Rejected
    \item[WAITING] Started
    \item[ROCKET] Launched
    \item [NO] Case-sensitive
    \item [unknown] Ordinary
    \end{itemize}
  '''

  testCase r'''
    styled multi-character markers and empty marker
    ---
    ::styles
      [++] = PLUSPLUS
      [] = EMPTY
    - [++] Incremented
    - [] Ordinary
    ---
    \begin{itemize}
    \item[PLUSPLUS] Incremented
    \item [] Ordinary
    \end{itemize}
  '''

  testCase r'''
    marker-only items with nested content and at end of file
    ---
    - [ ]
      Nested content
    - [x]
    ---
    \begin{itemize}
    \item[$\square$]
      Nested content
    \item[$\boxtimes$]
    \end{itemize}
  '''

  testCase r'''
    disabled by compiler option
    ---
    - [ ] To do
    - [x] Done
    ---
    \begin{itemize}
    \item [ ] To do
    \item [x] Done
    \end{itemize}
  ''', markdownChecklists: false

  testCase r'''
    disabled by in-file config
    ---
    ::config -markdownChecklists
    - [ ] To do
    - [x] Done
    ---
    \begin{itemize}
    \item [ ] To do
    \item [x] Done
    \end{itemize}
  '''

  testCase r'''
    disabled by markdownCompat when lists are re-enabled
    ---
    ::config -markdownCompat
    ::config markdownLists
    - [x] Done
    ---
    \begin{itemize}
    \item [x] Done
    \end{itemize}
  '''

  testCase r'''
    checkbox marker requires following whitespace
    ---
    ::styles [skip] = SKIP
    - [x]not a checklist
    - [skip]not a checklist
    - [?] unstyled marker
    - [other] also not a checklist
    ---
    \begin{itemize}
    \item [x]not a checklist
    \item [skip]not a checklist
    \item [?] unstyled marker
    \item [other] also not a checklist
    \end{itemize}
  '''

  testCase r'''
    automatic amssymb package
    ---
    - [ ] To do
    - [x] Done
    ---
    \documentclass[11pt]{article}
    \usepackage{amssymb}

    \begin{document}
    \begin{itemize}
    \item[$\square$] To do
    \item[$\boxtimes$] Done
    \end{itemize}
    \end{document}

  ''', fragment: false

  testCase r'''
    custom checklist styles do not load amssymb
    ---
    ::styles
      [ ] = EMPTY
      [x] = CHECKED
    - [ ] To do
    - [x] Done
    ---
    \documentclass[11pt]{article}

    \begin{document}
    \begin{itemize}
    \item[EMPTY] To do
    \item[CHECKED] Done
    \end{itemize}
    \end{document}

  ''', fragment: false

  testCase r'''
    existing amssymb package is not duplicated
    ---
    ::use amssymb
    - [ ] To do
    ---
    \documentclass[11pt]{article}
    \usepackage{amssymb}

    \begin{document}
    \begin{itemize}
    \item[$\square$] To do
    \end{itemize}
    \end{document}

  ''', fragment: false

describe 'ordered lists', ->
  testCase r'''
    single-line bullets
    ---
    1. one
    2. two
    1. three
    ---
    \begin{enumerate}
    \item one
    \item two
    \item three
    \end{enumerate}
  '''

  testCase r'''
    commented-out bullets do not interrupt list
    ---
    1. one
    %2. two
    %3. also two
    2. three
    ---
    \begin{enumerate}
    \item one
    %2. two
    %3. also two
    \item three
    \end{enumerate}
  '''

  testCase r'''
    comments before first bullet stay outside list
    ---
    %1. skip one
    %2. skip two
    1. one
    2. two
    ---
    %1. skip one
    %2. skip two
    \begin{enumerate}
    \item one
    \item two
    \end{enumerate}
  '''

  testCase r'''
    bullets with indentation
    ---
    1. hello
      world
      !
    2.
      goodbye
    ---
    \begin{enumerate}
    \item hello
      world
      !
    \item
      goodbye
    \end{enumerate}
  '''

  testCase r'''
    nested bullets
    ---
    1. hello
      2. world
      3. you
    4. goodbye
      5. cruel
        - world
    ---
    \begin{enumerate}
    \item hello
      \begin{enumerate}
      \item world
      \item you
      \end{enumerate}
    \item goodbye
      \begin{enumerate}
      \item cruel
        \begin{itemize}
        \item world
        \end{itemize}
      \end{enumerate}
    \end{enumerate}
  '''
