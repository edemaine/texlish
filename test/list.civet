{ r, testCase } from ./helper.civet
{ compile } from ../src/main.civet
{ builtinPackages } from ../src/declarations.civet
assert from node:assert/strict

describe 'unordered lists', ->
  testCase r'''
    single-line bullets
    ---
    - one
    * two
    ~ three
    ---
    \begin{itemize}
    \item one
    \item two
    \item three
    \end{itemize}
  '''

  testCase r'''
    bullets with indentation
    ---
    - hello
      world
      !
    *
      goodbye
    ---
    \begin{itemize}
    \item hello
      world
      !
    \item
      goodbye
    \end{itemize}
  '''

  testCase r'''
    nested bullets
    ---
    - hello
      - world
      - you
    * goodbye
      - cruel
        - world
    ---
    \begin{itemize}
    \item hello
      \begin{itemize}
      \item world
      \item you
      \end{itemize}
    \item goodbye
      \begin{itemize}
      \item cruel
        \begin{itemize}
        \item world
        \end{itemize}
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    same-line environment bullet
    ---
    - : environment
        content
    ---
    \begin{itemize}
    \item \begin{environment}
        content
      \end{environment}
    \end{itemize}
  '''

  // No `r` because this fixture relies on \t becoming real tabs.
  testCase '''
    same-line environment bullet with tab marker
    ---
    -\t: environment
    \t\tcontent
    ---
    \\begin{itemize}
    \\item\t\\begin{environment}
    \t\tcontent
     \t\\end{environment}
    \\end{itemize}
  '''

  testCase r'''
    same-line environment bullet with list-item body
    ---
    - : environment
      body
    ---
    \begin{itemize}
    \item \begin{environment}
      \end{environment}
      body
    \end{itemize}
  '''

  testCase r'''
    same-line environment bullet with argument
    ---
    - : environment:
        - arg
        env body
      body
    ---
    \begin{itemize}
    \item \begin{environment}
         {arg}%
        env body
      \end{environment}
      body
    \end{itemize}
  '''

  testCase r'''
    same-line nested bullets
    ---
    - - x
      - y
    ---
    \begin{itemize}
    \item \begin{itemize}
      \item x
      \item y
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    triple same-line nested bullet
    ---
    - - - x
    ---
    \begin{itemize}
    \item \begin{itemize}
      \item \begin{itemize}
        \item x
        \end{itemize}
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    same-line raw tex bullet
    ---
    - ::tex \foo{*raw* [link](https://example.com) @ref}
    ---
    \begin{itemize}
    \item \foo{*raw* [link](https://example.com) @ref}
    \end{itemize}
  '''

  testCase r'''
    commented-out bullets do not interrupt list
    ---
    - one
    %* two
    %- also two
    ~ three
    ---
    \begin{itemize}
    \item one
    %* two
    %- also two
    \item three
    \end{itemize}
  '''

  testCase r'''
    comments before first bullet stay outside list
    ---
    %* skip one
    %- skip two
    - one
    - two
    ---
    %* skip one
    %- skip two
    \begin{itemize}
    \item one
    \item two
    \end{itemize}
  '''

  testCase r'''
    disabled by compiler option
    ---
    - one
    * two
    ---
    - one
    * two
  ''', markdownLists: false

  testCase r'''
    disabled by markdownCompat shorthand
    ---
    ::config -markdownCompat
    - one
    * two
    ---
    - one
    * two
  '''

  testCase r'''
    plain brackets do not consume indented bullets
    ---
    - [foo
      - bar]
    ---
    \begin{itemize}
    \item [foo
      \begin{itemize}
      \item bar]
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    plain parens do not consume indented bullets
    ---
    - (foo
      - bar)
    ---
    \begin{itemize}
    \item (foo
      \begin{itemize}
      \item bar)
      \end{itemize}
    \end{itemize}
  '''

describe 'checklists', ->
  testCase r'''
    unchecked and checked items
    ---
    - [ ] To do
    - [x] Done
    - [X] Also done
    ---
    \begin{itemize}
    \item[$\square$] To do
    \item[$\boxtimes$] Done
    \item[$\boxtimes$] Also done
    \end{itemize}
  '''

  testCase r'''
    mixed and nested checklist items
    ---
    - ordinary
    - [ ] parent
      - [x] child
      continuation
    * [x] last
    ---
    \begin{itemize}
    \item ordinary
    \item[$\square$] parent
      \begin{itemize}
      \item[$\boxtimes$] child
      \end{itemize}
      continuation
    \item[$\boxtimes$] last
    \end{itemize}
  '''

  testCase r'''
    custom checklist styles
    ---
    ::styles
      [ ] = EMPTY
      [x] = CHECKED
      [X] = VERIFIED
    - [ ] To do
    - [x] Done
    - [X] Verified
    ---
    \begin{itemize}
    \item[EMPTY] To do
    \item[CHECKED] Done
    \item[VERIFIED] Verified
    \end{itemize}
  '''

  testCase r'''
    custom styled markers
    ---
    ::styles
      [+] = $\boxplus$
      [skip] = SKIP
      [no] = NO
      [in progress] = WAITING
      [🚀] = ROCKET
    - [+] Added
    - [skip] Optional
    - [no] Rejected
    - [in progress] Started
    - [🚀] Launched
    - [NO] Case-sensitive
    - [unknown] Ordinary
    ---
    \begin{itemize}
    \item[$\boxplus$] Added
    \item[SKIP] Optional
    \item[NO] Rejected
    \item[WAITING] Started
    \item[ROCKET] Launched
    \item [NO] Case-sensitive
    \item [unknown] Ordinary
    \end{itemize}
  '''

  testCase r'''
    styled multi-character markers and empty marker
    ---
    ::styles
      [++] = PLUSPLUS
      [] = EMPTY
    - [++] Incremented
    - [] Ordinary
    ---
    \begin{itemize}
    \item[PLUSPLUS] Incremented
    \item [] Ordinary
    \end{itemize}
  '''

  testCase r'''
    marker-only items with nested content and at end of file
    ---
    - [ ]
      Nested content
    - [x]
    ---
    \begin{itemize}
    \item[$\square$]
      Nested content
    \item[$\boxtimes$]
    \end{itemize}
  '''

  testCase r'''
    disabled by compiler option
    ---
    - [ ] To do
    - [x] Done
    ---
    \begin{itemize}
    \item [ ] To do
    \item [x] Done
    \end{itemize}
  ''', markdownChecklists: false

  testCase r'''
    disabled by in-file config
    ---
    ::config -markdownChecklists
    - [ ] To do
    - [x] Done
    ---
    \begin{itemize}
    \item [ ] To do
    \item [x] Done
    \end{itemize}
  '''

  testCase r'''
    disabled by markdownCompat when lists are re-enabled
    ---
    ::config -markdownCompat
    ::config markdownLists
    - [x] Done
    ---
    \begin{itemize}
    \item [x] Done
    \end{itemize}
  '''

  testCase r'''
    checkbox marker requires following whitespace
    ---
    ::styles [skip] = SKIP
    - [x]not a checklist
    - [skip]not a checklist
    - [?] unstyled marker
    - [other] also not a checklist
    ---
    \begin{itemize}
    \item [x]not a checklist
    \item [skip]not a checklist
    \item [?] unstyled marker
    \item [other] also not a checklist
    \end{itemize}
  '''

  testCase r'''
    automatic amssymb package
    ---
    - [ ] To do
    - [x] Done
    ---
    \documentclass[11pt]{article}
    \usepackage{amssymb}

    \begin{document}
    \begin{itemize}
    \item[$\square$] To do
    \item[$\boxtimes$] Done
    \end{itemize}
    \end{document}

  ''', fragment: false

  testCase r'''
    custom checklist styles do not load amssymb
    ---
    ::styles
      [ ] = EMPTY
      [x] = CHECKED
    - [ ] To do
    - [x] Done
    ---
    \documentclass[11pt]{article}

    \begin{document}
    \begin{itemize}
    \item[EMPTY] To do
    \item[CHECKED] Done
    \end{itemize}
    \end{document}

  ''', fragment: false

  testCase r'''
    existing amssymb package is not duplicated
    ---
    ::use amssymb
    - [ ] To do
    ---
    \documentclass[11pt]{article}
    \usepackage{amssymb}

    \begin{document}
    \begin{itemize}
    \item[$\square$] To do
    \end{itemize}
    \end{document}

  ''', fragment: false

describe 'ordered lists', ->
  testCase r'''
    single-line bullets
    ---
    1. one
    2. two
    1. three
    ---
    \begin{enumerate}
    \item one
    \item two
    \item three
    \end{enumerate}
  '''

  testCase r'''
    commented-out bullets do not interrupt list
    ---
    1. one
    %2. two
    %3. also two
    2. three
    ---
    \begin{enumerate}
    \item one
    %2. two
    %3. also two
    \item three
    \end{enumerate}
  '''

  testCase r'''
    comments before first bullet stay outside list
    ---
    %1. skip one
    %2. skip two
    1. one
    2. two
    ---
    %1. skip one
    %2. skip two
    \begin{enumerate}
    \item one
    \item two
    \end{enumerate}
  '''

  testCase r'''
    bullets with indentation
    ---
    1. hello
      world
      !
    2.
      goodbye
    ---
    \begin{enumerate}
    \item hello
      world
      !
    \item
      goodbye
    \end{enumerate}
  '''

  testCase r'''
    nested bullets
    ---
    1. hello
      2. world
      3. you
    4. goodbye
      5. cruel
        - world
    ---
    \begin{enumerate}
    \item hello
      \begin{enumerate}
      \item world
      \item you
      \end{enumerate}
    \item goodbye
      \begin{enumerate}
      \item cruel
        \begin{itemize}
        \item world
        \end{itemize}
      \end{enumerate}
    \end{enumerate}
  '''

describe 'list directives', ->
  for [marker, env] of [['*', 'itemize'], ['1.', 'enumerate']]
    for indentation of ['', '  ']
      testCase ```
        inferred ${env} with ${indentation#}-space body indent
        ---
        ::list
        ${indentation}${marker} one
        ${indentation}${marker} two
        ---
        ${indentation}\\begin{${env}}
        ${indentation}\\item one
        ${indentation}\\item two
        ${indentation}\\end{${env}}
      ```

  testCase r'''
    explicit environment overrides unordered markers
    ---
    ::list enumerate[<+->][(i)]
    * <2-> one
    * two
    ---
    \begin{enumerate}[<+->][(i)]
    \item <2-> one
    \item two
    \end{enumerate}
  '''

  testCase r'''
    inferred environment with raw optional arguments
    ---
    ::list [label=(\alph*), resume]
      1. one
      2. two
    ---
      \begin{enumerate}[label=(\alph*), resume]
      \item one
      \item two
      \end{enumerate}
  '''

  testCase r'''
    custom environment with required and optional inline arguments
    ---
    ::list custom*{\textbf{Label}}[option]
    1. one
    ---
    \begin{custom*}{\textbf{Label}}[option]
    \item one
    \end{custom*}
  '''

  testCase r'''
    required argument bullets above an indented list
    ---
    ::list list:
        - $\diamond$
        - \setlength{\leftmargin}{2em}
      * one
      * two
    ---
      \begin{list}
         {$\diamond$}%
         {\setlength{\leftmargin}{2em}}%
      \item one
      \item two
      \end{list}
  '''

  testCase r'''
    same-line colon argument with custom environment
    ---
    ::list custom: arg
    - bullet
    ---
    \begin{custom}{arg}%
    \item bullet
    \end{custom}
  '''

  testCase r'''
    same-line colon argument leaves indented numbered items separate from arguments
    ---
    ::list custom[option]: *text* \alpha % argument
      1. one
      2. two
    ---
      \begin{custom}[option]{\emph{text} \alpha}% argument
      \item one
      \item two
      \end{custom}
  '''

  testCase r'''
    empty list with same-line colon argument
    ---
    ::list custom: arg
    ---
    \begin{custom}{arg}%
    \end{custom}
  '''

  testCase r'''
    custom list with strictly indented argument and item bullets
    ---
    ::list custom:
        - arg
      - bullet
    ---
      \begin{custom}
         {arg}%
      \item bullet
      \end{custom}
  '''

  testCase r'''
    numbered bullets can align with argument bullets
    ---
    ::list enumerate:
      ~ option
      1. one
      2. two
    ---
      \begin{enumerate}
       [option]%
      \item one
      \item two
      \end{enumerate}
  '''
  testCase r'''
    optional argument bullets above same-level numbered items
    ---
    ::list:
      ~ label=(\alph*)
      ~ another argument
    1. one
    2. two
    ---
    \begin{enumerate}
       [label=(\alph*)]%
       [another argument]%
    \item one
    \item two
    \end{enumerate}
  '''

  testCase r'''
    nested lists keep their own environments and may use directives
    ---
    ::list steps
    * one
      - nested
      ::list enumerate:
          ~ label=(\roman*)
        * custom nested
    * two

    Paragraph.

    - separate
    ---
    \begin{steps}
    \item one
      \begin{itemize}
      \item nested
      \end{itemize}
        \begin{enumerate}
           [label=(\roman*)]%
        \item custom nested
        \end{enumerate}
    \item two
    \end{steps}

    Paragraph.

    \begin{itemize}
    \item separate
    \end{itemize}
  '''

  testCase r'''
    explicit list works with automatic Markdown lists disabled
    ---
    ::list enumerate
    - one
    ---
    \begin{enumerate}
    \item one
    \end{enumerate}
  ''', markdownLists: false

  testCase r'''
    does not consume a list outside the directive indentation
    ---
      ::list enumerate
    - one
    ---
      \begin{enumerate}
      \end{enumerate}
    \begin{itemize}
    \item one
    \end{itemize}
  '''

  testCase r'''
    empty inferred list leaves less-indented numbered bullets separate
    ---
      ::list
    1. outside
    ---
      \begin{itemize}
      \end{itemize}
    \begin{enumerate}
    \item outside
    \end{enumerate}
  '''

  testCase r'''
    empty named list at end of input
    ---
    ::list inparaenum
    ---
    \begin{inparaenum}
    \end{inparaenum}
  '''

  testCase r'''
    empty named list with inline arguments before prose
    ---
    ::list custom[option]{argument}
    Paragraph.
    ---
    \begin{custom}[option]{argument}
    \end{custom}
    Paragraph.
  '''

  testCase r'''
    empty named list with bulleted arguments
    ---
    ::list custom:
      - argument
      ~ option
    ---
    \begin{custom}
       {argument}%
       [option]%
    \end{custom}
  '''

  for source of ['::list', '::list:']
    testCase ```
      empty ${source} defaults to itemize
      ---
      ${source}
      ---
      \\begin{itemize}
      \\end{itemize}
    ```

  testCase r'''
    empty inferred list with inline arguments
    ---
    ::list [option]
    ---
    \begin{itemize}[option]
    \end{itemize}
  '''

  testCase r'''
    preserves comments and combines inline and bulleted arguments
    ---
    :: list custom[inline]: % header
      - {nested} \alpha % argument
      % between
      ~ optional
    % before items
    * item
    ---
    \begin{custom}[inline] % header
       {{nested} \alpha}% argument
      % between
       [optional]%
    % before items
    \item item
    \end{custom}
  '''

  it 'handles tabs and CRLF with the same indentation rules', ->
    result := compile '::list enumerate:\r\n\t\t~ option\r\n\t- one', fragment: true
    assert.match result, /\\begin\{enumerate\}/
    assert.match result, /\[option\]/
    assert.match result, /\\item one/

  it 'records the selected environment in the list AST', ->
    ast := compile '::list custom\n- item', fragment: true, ast: true
    node := ast[0]
    assert node is like { type: 'List' }
    assert.equal node.env, 'custom'

  testCase r'''
    does not interpret same-level bullets as colon arguments
    ---
    ::list list:
    - label
    - setup
    ---
    \begin{list}
    \item label
    \item setup
    \end{list}
  '''

  for [marker, env] of [['-', 'itemize'], ['1.', 'enumerate']]
    testCase ```
      preserves blank lines before ${marker} items
      ---
      ::list [option]
      % before items


      ${marker} one
      ---
      \\begin{${env}}[option]
      % before items


      \\item one
      \\end{${env}}
    ```

  it 'preserves CRLF before the first item', ->
    assert.equal compile('::list\r\n\r\n- one', fragment: true),
      '\\begin{itemize}\r\n\r\n\\item one\n\\end{itemize}'

  describe 'package declarations', ->
    before ->
      builtinPackages.set 'testlists',
        name: 'testlists'
        environments: new Map Object.entries
          itemize:
            args: [
              { name: 'label', delimiter: 'required', mode: 'text' }
              { name: 'options', delimiter: 'optional', mode: 'raw' }
            ]
            body: 'text'
          enumerate:
            args: [
              { name: 'options', delimiter: 'optional', mode: 'raw' }
              { name: 'value', delimiter: 'required', mode: 'math' }
            ]
            body: 'text'
          delimitedlist:
            args: [
              { name: 'label', delimiter: 'delimited', mode: 'verbatim' }
              { name: 'value', delimiter: 'required-or-delimited', mode: 'verbatim' }
              { name: 'settings', delimiter: 'required', mode: 'raw' }
            ]
            body: 'text'
    after ->
      builtinPackages.delete 'testlists'

    testCase r'''
      declared delimited arguments can precede a colon argument
      ---
      ::use testlists
      ::list delimitedlist |% *label*| !% *value*!: *settings*
      - *one*
      ---
      \usepackage{testlists}
      \begin{delimitedlist} |% *label*| !% *value*!{*settings*}%
      \item \emph{one}
      \end{delimitedlist}
    '''

    testCase r'''
      inferred lists accept unbraced command arguments
      ---
      ::use testlists
      ::list[option]\value
      1. one
      ---
      \usepackage{testlists}
      \begin{enumerate}[option]\value
      \item one
      \end{enumerate}
    '''

    testCase r'''
      inferred ordered list uses its own argument declaration
      ---
      ::use testlists
      ::list[*raw*]:
        - x_12
        1. *one*
      ---
      \usepackage{testlists}
        \begin{enumerate}[*raw*]
         {x_{12}}%
        \item \emph{one}
        \end{enumerate}
    '''

    testCase r'''
      inferred unordered list separates strictly indented arguments and items
      ---
      ::use testlists
      ::list:
          - *label*
        - bullet
      ---
      \usepackage{testlists}
        \begin{itemize}
           {\emph{label}}%
        \item bullet
        \end{itemize}
    '''

    testCase r'''
      empty inferred list uses the itemize declaration
      ---
      ::use testlists
      ::list:
        - *label*
        ~ *raw*
      ---
      \usepackage{testlists}
      \begin{itemize}
         {\emph{label}}%
         [*raw*]%
      \end{itemize}
    '''

    testCase r'''
      same-line inferred argument uses the selected environment declaration
      ---
      ::use testlists
      ::list: x_12
      1. *one*
      ::list: *label*
      - *two*
      ---
      \usepackage{testlists}
      \begin{enumerate}{x_{12}}%
      \item \emph{one}
      \end{enumerate}
      \begin{itemize}{\emph{label}}%
      \item \emph{two}
      \end{itemize}
    '''

    testCase r'''
      exhausting arguments leaves aligned bullets as list items
      ---
      ::use testlists
      ::list:
        - *label*
        - *one*
        - *two*
      ---
      \usepackage{testlists}
        \begin{itemize}
         {\emph{label}}%
        \item \emph{one}
        \item \emph{two}
        \end{itemize}
    '''

  testCase r'''
    list arguments can be unbraced commands
    ---
    ::list list \label \settings
    - one
    ---
    \begin{list} \label \settings
    \item one
    \end{list}
  '''

  testCase r'''
    list label is text and list settings are raw
    ---
    ::list list{*label*}{\def\label{*raw*}}
    - *one*
    ---
    \begin{list}{\emph{label}}{\def\label{*raw*}}
    \item \emph{one}
    \end{list}
  '''
