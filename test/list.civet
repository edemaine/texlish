{ r, testCase } from ./helper.civet

describe 'unordered lists', ->
  testCase r'''
    single-line bullets
    ---
    - one
    * two
    ~ three
    ---
    \begin{itemize}
    \item one
    \item two
    \item three
    \end{itemize}
  '''

  testCase r'''
    bullets with indentation
    ---
    - hello
      world
      !
    *
      goodbye
    ---
    \begin{itemize}
    \item hello
      world
      !
    \item
      goodbye
    \end{itemize}
  '''

  testCase r'''
    nested bullets
    ---
    - hello
      - world
      - you
    * goodbye
      - cruel
        - world
    ---
    \begin{itemize}
    \item hello
      \begin{itemize}
      \item world
      \item you
      \end{itemize}
    \item goodbye
      \begin{itemize}
      \item cruel
        \begin{itemize}
        \item world
        \end{itemize}
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    same-line environment bullet
    ---
    - : environment
        content
    ---
    \begin{itemize}
    \item \begin{environment}
        content
      \end{environment}
    \end{itemize}
  '''

  // No `r` because this fixture relies on \t becoming real tabs.
  testCase '''
    same-line environment bullet with tab marker
    ---
    -\t: environment
    \t\tcontent
    ---
    \\begin{itemize}
    \\item\t\\begin{environment}
    \t\tcontent
     \t\\end{environment}
    \\end{itemize}
  '''

  testCase r'''
    same-line environment bullet with list-item body
    ---
    - : environment
      body
    ---
    \begin{itemize}
    \item \begin{environment}
      \end{environment}
      body
    \end{itemize}
  '''

  testCase r'''
    same-line environment bullet with argument
    ---
    - : environment:
        - arg
        env body
      body
    ---
    \begin{itemize}
    \item \begin{environment}
         {arg}%
        env body
      \end{environment}
      body
    \end{itemize}
  '''

  testCase r'''
    same-line nested bullets
    ---
    - - x
      - y
    ---
    \begin{itemize}
    \item \begin{itemize}
      \item x
      \item y
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    triple same-line nested bullet
    ---
    - - - x
    ---
    \begin{itemize}
    \item \begin{itemize}
      \item \begin{itemize}
        \item x
        \end{itemize}
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    same-line raw tex bullet
    ---
    - ::tex \foo{*raw* [link](https://example.com) @ref}
    ---
    \begin{itemize}
    \item \foo{*raw* [link](https://example.com) @ref}
    \end{itemize}
  '''

  testCase r'''
    commented-out bullets do not interrupt list
    ---
    - one
    %* two
    %- also two
    ~ three
    ---
    \begin{itemize}
    \item one
    %* two
    %- also two
    \item three
    \end{itemize}
  '''

  testCase r'''
    comments before first bullet stay outside list
    ---
    %* skip one
    %- skip two
    - one
    - two
    ---
    %* skip one
    %- skip two
    \begin{itemize}
    \item one
    \item two
    \end{itemize}
  '''

  testCase r'''
    disabled by compiler option
    ---
    - one
    * two
    ---
    - one
    * two
  ''', markdownLists: false

  testCase r'''
    disabled by markdownCompat shorthand
    ---
    ::config -markdownCompat
    - one
    * two
    ---
    - one
    * two
  '''

  testCase r'''
    plain brackets do not consume indented bullets
    ---
    - [foo
      - bar]
    ---
    \begin{itemize}
    \item [foo
      \begin{itemize}
      \item bar]
      \end{itemize}
    \end{itemize}
  '''

  testCase r'''
    plain parens do not consume indented bullets
    ---
    - (foo
      - bar)
    ---
    \begin{itemize}
    \item (foo
      \begin{itemize}
      \item bar)
      \end{itemize}
    \end{itemize}
  '''

describe 'ordered lists', ->
  testCase r'''
    single-line bullets
    ---
    1. one
    2. two
    1. three
    ---
    \begin{enumerate}
    \item one
    \item two
    \item three
    \end{enumerate}
  '''

  testCase r'''
    commented-out bullets do not interrupt list
    ---
    1. one
    %2. two
    %3. also two
    2. three
    ---
    \begin{enumerate}
    \item one
    %2. two
    %3. also two
    \item three
    \end{enumerate}
  '''

  testCase r'''
    comments before first bullet stay outside list
    ---
    %1. skip one
    %2. skip two
    1. one
    2. two
    ---
    %1. skip one
    %2. skip two
    \begin{enumerate}
    \item one
    \item two
    \end{enumerate}
  '''

  testCase r'''
    bullets with indentation
    ---
    1. hello
      world
      !
    2.
      goodbye
    ---
    \begin{enumerate}
    \item hello
      world
      !
    \item
      goodbye
    \end{enumerate}
  '''

  testCase r'''
    nested bullets
    ---
    1. hello
      2. world
      3. you
    4. goodbye
      5. cruel
        - world
    ---
    \begin{enumerate}
    \item hello
      \begin{enumerate}
      \item world
      \item you
      \end{enumerate}
    \item goodbye
      \begin{enumerate}
      \item cruel
        \begin{itemize}
        \item world
        \end{itemize}
      \end{enumerate}
    \end{enumerate}
  '''
