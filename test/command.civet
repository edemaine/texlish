{ testCase } from ./helper.civet

describe '\\command:', ->
  testCase '''
    empty
    ---
    \\emph:
    \\emph: 
    ---
    \\emph{}%
    \\emph{}%
  '''

  testCase '''
    one line
    ---
    \\bibliography: bib
    ---
    \\bibliography{bib}%
  '''

  testCase '''
    ignored after newline
    ---
    \\
    : foo
    ---
    \\
    \\begin{foo}
    \\end{foo}
  '''

  testCase '''
    ignored in comment
    ---
    % \\bibliography: bib
    ---
    % \\bibliography: bib
  '''

  testCase '''
    indented
    ---
    \\sqrt:
      a + b
    ---
    \\sqrt{%
      a + b}%
  '''

  testCase '''
    mixed
    ---
    \\sqrt: a +
      b + c
    ---
    \\sqrt{a +
      b + c}%
  '''

  testCase '''
    bulleted
    ---
    \\subcaptionbox:
    - Caption
    - Figure
    ---
    \\subcaptionbox
     {Caption}%
     {Figure}%
  '''

  testCase '''
    bulleted with strict indentation
    ---
    \\foo:
      - a
      - b
    ---
    \\foo
       {a}%
       {b}%
  '''

  testCase '''
    bulleted with same-line environment
    ---
    \\foo:
      - argument 1
      - : environment
          content
    ---
    \\foo
       {argument 1}%
       {\\begin{environment}
          content
        \\end{environment}}%
  '''

  testCase '''
    bulleted with same-line environment and list-item body
    ---
    \\foo:
      - : environment
        body
    ---
    \\foo
       {\\begin{environment}
        \\end{environment}
        body}%
  '''

  testCase '''
    bulleted with same-line environment and argument
    ---
    \\foo:
      - : environment:
          - arg
          env body
        body
    ---
    \\foo
       {\\begin{environment}
           {arg}%
          env body
        \\end{environment}
        body}%
  '''

  testCase '''
    bulleted with same-line nested list
    ---
    \\foo:
      - - x
        - y
    ---
    \\foo
       {\\begin{itemize}
        \\item x
        \\item y
        \\end{itemize}}%
  '''

  testCase '''
    bulleted with triple same-line nested list
    ---
    \\foo:
      - - - x
    ---
    \\foo
       {\\begin{itemize}
        \\item \\begin{itemize}
          \\item x
          \\end{itemize}
        \\end{itemize}}%
  '''

  testCase '''
    bulleted with same-line raw tex
    ---
    \\foo:
      - ::tex \\bar{*raw* [link](https://example.com) @ref}
    ---
    \\foo
       {\\bar{*raw* [link](https://example.com) @ref}}%
  '''

  testCase '''
    bulleted with nested \\command:
    ---
    \\subcaptionbox:
    - Caption
      @=label
    - \\includegraphics:
        image.png
    ---
    \\subcaptionbox
     {Caption
      \\label{label}}%
     {\\includegraphics{%
        image.png}}%
  '''

  testCase '''
    optional bullet
    ---
    \\includegraphics:
    ~ width=0.5\\textwidth
    - image.png
    \\includegraphics:
      ~ width=0.5\\textwidth
      - image.png
    ---
    \\includegraphics
     [width=0.5\\textwidth]%
     {image.png}%
    \\includegraphics
       [width=0.5\\textwidth]%
       {image.png}%
  '''

  testCase '''
    commented-out argument bullets do not interrupt list
    ---
    \\foo:
    - one
    %~ two
    %- also two
    - three
    ---
    \\foo
     {one}%
    %~ two
    %- also two
     {three}%
  '''

  testCase '''
    comments before first argument bullet
    ---
    \\foo:
      % skip one
        %- skip two
    - one
    - two
    ---
    \\foo
      % skip one
        %- skip two
     {one}%
     {two}%
  '''

  testCase '''
    dedented bullets do not become arguments
    ---
    : env
      \\foo:
    - one
    : env
      \\bar:
        % skip
    - two
    ---
    \\begin{env}
      \\foo{}%
    \\end{env}
    \\begin{itemize}
    \\item one
    \\end{itemize}
    \\begin{env}
      \\bar{%
        }% skip
    \\end{env}
    \\begin{itemize}
    \\item two
    \\end{itemize}
  '''

  testCase '''
    inline
    ---
    $$
      -b \\pm \\sqrt:
        b^2 - 4 a c
    $$
    ---
    $$
      -b \\pm \\sqrt{%
        b^2 - 4 a c}%
    $$
  '''

  testCase '''
    nested command closes before parent argument
    ---
    : align*
        C_\\mathrm{j} &= \\frac:
            - C_\\mathrm{j0}
            - \\sqrt:
                - 1 + \\frac:
                    - V_\\mathrm{D}
                    - \\Phi_0
    ---
    \\begin{align*}
        C_\\mathrm{j} &= \\frac
             {C_\\mathrm{j0}}%
             {\\sqrt
                 {1 + \\frac
                     {V_\\mathrm{D}}%
                     {\\Phi_0}}}%
    \\end{align*}
  '''

  testCase '''
    in brace
    ---
    {\\includegraphics:
      image.png}
    ---
    {\\includegraphics{%
      image.png}}
  '''

  testCase '''
    one line with comment
    ---
    \\bibliography: bib % give to BibTeX
    ---
    \\bibliography{bib}% give to BibTeX
  '''

  testCase '''
    indented with first-line comment
    ---
    \\bibliography:% give to BibTeX
      bib
    \\bibliography: % give to BibTeX
      bib
    ---
    \\bibliography{% give to BibTeX
      bib}%
    \\bibliography{% give to BibTeX
      bib}%
  '''

  testCase '''
    indented with trailing comment
    ---
    \\bibliography:
      bib% give to BibTeX
    \\bibliography:
      bib % give to BibTeX
    ---
    \\bibliography{%
      bib}% give to BibTeX
    \\bibliography{%
      bib}% give to BibTeX
  '''

  testCase '''
    at EOF
    ---
    \\
    ---
    \\
  '''

  testCase '''
    starred
    ---
    \\section*: Acknowledgements
    ---
    \\section*{Acknowledgements}%
  '''
