{ r, testCase } from ./helper.civet

describe '\\command:', ->
  testCase r'''
    disabled by compiler option
    ---
    \title: The Paper
    \url: https://example.com/a_b
    \includegraphics[width=1in]: image.png
    ---
    \title: The Paper
    \url: https://example.com/a_b
    \includegraphics[width=1in]: image.png
  ''', colonCommands: false

  testCase r'''
    disabled by in-file config shorthand
    ---
    \title: Before
    ::config -colonCommands
    \title: After
    \url: https://example.com/a_b
    ---
    \title{Before}%
    \title: After
    \url: https://example.com/a_b
  '''

  // No `r` because this test uses \x20 for an intentional trailing space.
  testCase '''
    empty
    ---
    \\emph:
    \\emph:\x20
    ---
    \\emph{}%
    \\emph{}%
  '''

  testCase r'''
    one line
    ---
    \bibliography: bib
    ---
    \bibliography{bib}%
  '''

  testCase r'''
    undeclared commands do not mix LaTeX-style and colon arguments
    ---
    \foo{*argument*}: *body*
    \foo[*argument*]: *body*
    ---
    \foo{\emph{argument}}: \emph{body}
    \foo[\emph{argument}]: \emph{body}
  '''

  testCase r'''
    declared math commands switch from LaTeX-style to colon arguments
    ---
    $\frac{a_12}: b_34$
    ---
    $\frac{a_{12}}{b_{34}}%$
  '''

  testCase r'''
    failed signature dispatch restores the argument pattern
    ---
    \verb:raw
    \includegraphics: figures/*raw*.pdf
    ---
    \verb:raw
    \includegraphics{figures/*raw*.pdf}%
  '''

  testCase r'''
    colon is a valid verb delimiter
    ---
    \verb:*raw*:
    ---
    \verb:*raw*:
  '''

  testCase r'''
    colon shorthand takes priority over a url delimiter
    ---
    \url:*raw*:
    ---
    \url{*raw*:}%
  '''

  testCase r'''
    ignored after newline
    ---
    \
    : foo
    ---
    \
    \begin{foo}
    \end{foo}
  '''

  testCase r'''
    ignored in comment
    ---
    % \bibliography: bib
    ---
    % \bibliography: bib
  '''

  testCase r'''
    indented
    ---
    \sqrt:
      a + b
    ---
    \sqrt{%
      a + b}%
  '''

  testCase r'''
    mixed
    ---
    \sqrt: a +
      b + c
    ---
    \sqrt{a +
      b + c}%
  '''

  testCase r'''
    bulleted
    ---
    \subcaptionbox:
    - Caption
    - Figure
    ---
    \subcaptionbox
     {Caption}%
     {Figure}%
  '''

  testCase r'''
    bulleted with strict indentation
    ---
    \foo:
      - a
      - b
    ---
    \foo
       {a}%
       {b}%
  '''

  testCase r'''
    bulleted with unbulleted final required argument
    ---
    \resizebox:
      - \linewidth
      - !
      stuff
    ---
    \resizebox
       {\linewidth}%
       {!}%
       {%
      stuff}%
  '''

  testCase r'''
    bulleted with blank line before unbulleted final required argument
    ---
    \resizebox:
      - \linewidth
      - !

      stuff
    ---
    \resizebox
       {\linewidth}%
       {!}%
       {%

      stuff}%
  '''

  testCase r'''
    bulleted with multiline unbulleted final required argument
    ---
    \foo:
      - one
      two
        three
      four
    ---
    \foo
       {one}%
       {%
      two
        three
      four}%
  '''

  testCase r'''
    unindented text after bulleted arguments stays outside
    ---
    \foo:
    - one
    two
    ---
    \foo
     {one}%
    two
  '''

  testCase r'''
    bulleted with same-line environment
    ---
    \foo:
      - argument 1
      - : environment
          content
    ---
    \foo
       {argument 1}%
       {\begin{environment}
          content
        \end{environment}}%
  '''

  testCase r'''
    bulleted with same-line environment and list-item body
    ---
    \foo:
      - : environment
        body
    ---
    \foo
       {\begin{environment}
        \end{environment}
        body}%
  '''

  testCase r'''
    bulleted with same-line environment and argument
    ---
    \foo:
      - : environment:
          - arg
          env body
        body
    ---
    \foo
       {\begin{environment}
           {arg}%
          env body
        \end{environment}
        body}%
  '''

  testCase r'''
    bulleted with same-line nested list
    ---
    \foo:
      - - x
        - y
    ---
    \foo
       {\begin{itemize}
        \item x
        \item y
        \end{itemize}}%
  '''

  testCase r'''
    bulleted with triple same-line nested list
    ---
    \foo:
      - - - x
    ---
    \foo
       {\begin{itemize}
        \item \begin{itemize}
          \item x
          \end{itemize}
        \end{itemize}}%
  '''

  testCase r'''
    bulleted with same-line raw tex
    ---
    \foo:
      - ::tex \bar{*raw* [link](https://example.com) @ref}
    ---
    \foo
       {\bar{*raw* [link](https://example.com) @ref}}%
  '''

  testCase r'''
    bulleted with nested \command:
    ---
    \subcaptionbox:
    - Caption
      @=label
    - \includegraphics:
        image.png
    ---
    \subcaptionbox
     {Caption
      \label{label}}%
     {\includegraphics{%
        image.png}}%
  '''

  testCase r'''
    optional bullet
    ---
    \includegraphics:
    ~ width=0.5\textwidth
    - image.png
    \includegraphics:
      ~ width=0.5\textwidth
      - image.png
    ---
    \includegraphics
     [width=0.5\textwidth]%
     {image.png}%
    \includegraphics
       [width=0.5\textwidth]%
       {image.png}%
  '''

  testCase r'''
    commented-out argument bullets do not interrupt list
    ---
    \foo:
    - one
    %~ two
    %- also two
    - three
    ---
    \foo
     {one}%
    %~ two
    %- also two
     {three}%
  '''

  testCase r'''
    comments before first argument bullet
    ---
    \foo:
      % skip one
        %- skip two
    - one
    - two
    ---
    \foo
      % skip one
        %- skip two
     {one}%
     {two}%
  '''

  testCase r'''
    dedented bullets do not become arguments
    ---
    : env
      \foo:
    - one
    : env
      \bar:
        % skip
    - two
    ---
    \begin{env}
      \foo{}%
    \end{env}
    \begin{itemize}
    \item one
    \end{itemize}
    \begin{env}
      \bar{%
        }% skip
    \end{env}
    \begin{itemize}
    \item two
    \end{itemize}
  '''

  testCase r'''
    inline
    ---
    $$
      -b \pm \sqrt:
        b^2 - 4 a c
    $$
    ---
    $$
      -b \pm \sqrt{%
        b^2 - 4 a c}%
    $$
  '''

  testCase r'''
    generic colon arguments inherit math mode
    ---
    $x + \foo: y_12
    $
    $$
      \foo:
        - x_12
        - y_34
    $$
    ---
    $x + \foo{y_{12}}%
    $
    $$
      \foo
         {x_{12}}%
         {y_{34}}%
    $$
  '''

  testCase r'''
    ordinary undeclared command groups use the surrounding mode
    ---
    \foo{*one*}{@two}
    $\foo{x_12}{y_34}$
    ---
    \foo{\emph{one}}{\ref{two}}
    $\foo{x_{12}}{y_{34}}$
  '''

  testCase r'''
    inline with unbulleted final required argument
    ---
    Text \foo:
      - one
      two
    ---
    Text \foo
       {one}%
       {%
      two}%
  '''

  testCase r'''
    nested command closes before parent argument
    ---
    : align*
        C_\mathrm{j} &= \frac:
            - C_\mathrm{j0}
            - \sqrt:
                - 1 + \frac:
                    - V_\mathrm{D}
                    - \Phi_0
    ---
    \begin{align*}
        C_\mathrm{j} &= \frac
             {C_\mathrm{j0}}%
             {\sqrt
                 {1 + \frac
                     {V_\mathrm{D}}%
                     {\Phi_0}}}%
    \end{align*}
  '''

  testCase r'''
    in brace
    ---
    {\includegraphics:
      image.png}
    ---
    {\includegraphics{%
      image.png}}
  '''

  testCase r'''
    one line with comment
    ---
    \bibliography: bib % give to BibTeX
    ---
    \bibliography{bib}% give to BibTeX
  '''

  testCase r'''
    indented with first-line comment
    ---
    \bibliography:% give to BibTeX
      bib
    \bibliography: % give to BibTeX
      bib
    ---
    \bibliography{% give to BibTeX
      bib}%
    \bibliography{% give to BibTeX
      bib}%
  '''

  testCase r'''
    indented with trailing comment
    ---
    \bibliography:
      bib% give to BibTeX
    \bibliography:
      bib % give to BibTeX
    ---
    \bibliography{%
      bib}% give to BibTeX
    \bibliography{%
      bib}% give to BibTeX
  '''

  // No `r` because raw templates cannot end with a lone backslash.
  testCase '''
    at EOF
    ---
    \\
    ---
    \\
  '''

  testCase r'''
    starred
    ---
    \section*: Acknowledgements
    \section *: Appendix
    ---
    \section*{Acknowledgements}%
    \section*{Appendix}%
  '''
