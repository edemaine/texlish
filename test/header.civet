{ r, testCase } from ./helper.civet

describe 'Markdown headers (#/##/...)', ->
  testCase r'''
    single line
    ---
    # Heading
    ---
    \section{Heading}
  '''

  testCase r'''
    colon commands do not hide heading closers
    ---
    # \textbf: Title
    ## \textbf:
      Title
    ---
    \section{\textbf{Title}}
    \subsection{\textbf{%
      Title}}
  '''

  testCase r'''
    explicit comments follow heading closers
    ---
    # Title % note
    ## \textbf: Title % note
    ---
    \section{Title}% note
    \subsection{\textbf{Title}}% note
  '''

  testCase r'''
    several
    ---
    !!# Part
    !## Part
    !# Chapter
    # Section
    ## Subsection
    ### Subsubsection
    ###* Subsubsection
    .# Paragraph
    ..# Subparagraph
    .## Subparagraph
    ## Subsection
    ---
    \part{Part}
    \part{Part}
    \chapter{Chapter}
    \section{Section}
    \subsection{Subsection}
    \subsubsection{Subsubsection}
    \subsubsection*{Subsubsection}
    \paragraph{Paragraph}
    \subparagraph{Subparagraph}
    \subparagraph{Subparagraph}
    \subsection{Subsection}
  '''

  testCase r'''
    disabled by compiler option
    ---
    # Heading
    ---
    # Heading
  ''', markdownHeadings: false

  testCase r'''
    disabled by markdownCompat shorthand
    ---
    # Before
    ::config -markdownCompat
    # After
    ---
    \section{Before}
    # After
  '''
