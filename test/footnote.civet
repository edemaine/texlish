{ r, testCase } from ./helper.civet

describe 'Markdown footnotes', ->
  testCase r'''
    disabled by compiler option
    ---
    Text[^x].
    [^x]: Note.
    ---
    Text[^x].
    [^x]: Note.
  ''', markdownFootnotes: false

  testCase r'''
    disabled by markdownCompat shorthand
    ---
    Before[^x].
    [^x]: Before note.
    ::config -markdownCompat
    After[^y].
    [^y]: After note.
    ---
    Before%
    \footnote{\protect\label{footnote:x}Before note.}%
    .
    After[^y].
    [^y]: After note.
  '''

  testCase r'''
    inline and nested definitions
    ---
    This is a problem[^false], but not too bad[^true].
    [^false]:
      This is actually not true.
      See Figure @fig:example.
    [^true]: This is actually true.
    ---
    This is a problem%
    \footnote{\protect\label{footnote:false}%
      This is actually not true.
      See Figure \ref{fig:example}.}%
    , but not too bad%
    \footnote{\protect\label{footnote:true}This is actually true.}%
    .

  '''

  testCase r'''
    repeated footnote mark
    ---
    This is first[^false].
    [^false]: This is actually true.

    See footnote @^false for details.[^false]
    ---
    This is first%
    \footnote{\protect\label{footnote:false}This is actually true.}%
    .

    See footnote \ref{footnote:false} for details.\footref{footnote:false}
  '''

  testCase r'''
    definition between lines
    ---
    First[^x].
    [^x]: Note.
    Second.
    ---
    First%
    \footnote{\protect\label{footnote:x}Note.}%
    .
    Second.
  '''

  testCase r'''
    duplicate named definitions
    ---
    First[^x].
    [^x]: First note.
    [^x]: Second note.
    ---
    First%
    \footnote{\protect\label{footnote:x}First note.
    \protect\label{footnote:x}Second note.}%
    .

  '''

  testCase r'''
    numeric ids are disposable
    ---
    First paragraph[^1], again[^1].
    [^1]: First note.

    Second paragraph[^1].
    [^1]: Second note.
    ---
    First paragraph%
    \footnote{\protect\label{footnote:1}First note.}%
    , again\footref{footnote:1}.

    Second paragraph%
    \footnote{\protect\label{footnote:2}Second note.}%
    .
  '''

  testCase r'''
    numeric ids bind forward
    ---
    Before[^1].
    [^1]: Before note.
    After[^1].
    [^1]: After note.
    ---
    Before%
    \footnote{\protect\label{footnote:1}Before note.}%
    .
    After%
    \footnote{\protect\label{footnote:2}After note.}%
    .
  '''

  testCase r'''
    list item definition
    ---
    * Item[^x]
      [^x]: Note.
    ---
    \begin{itemize}
    \item Item%
    \footnote{\protect\label{footnote:x}Note.}
    \end{itemize}
  '''

  testCase r'''
    definition does not parse bulleted arguments
    ---
    First[^x].
    [^x]:
      - Note.
    ---
    First%
    \footnote{\protect\label{footnote:x}%
      \begin{itemize}
      \item Note.
      \end{itemize}}%
    .
  '''

  testCase r'''
    nested list item definition
    ---
    * Item
      nested[^x]
      [^x]: Note.
    ---
    \begin{itemize}
    \item Item
      nested%
    \footnote{\protect\label{footnote:x}Note.}
    \end{itemize}
  '''

  testCase r'''
    footnote ref at end of line
    ---
    foo[^1]
    bar

    [^1]: foot
    ---
    foo%
    \footnote{\protect\label{footnote:1}foot}
    bar

  '''

  testCase r'''
    author footnote label
    ---
    \title{Title}
    \author{First[^a]\and Repeat[^a]}
    [^a]: Affiliation note.
    ---
    \title{Title}
    \author{First%
    \footnote{\protect\label{footnote:a}Affiliation note.}%
    \and Repeat\footref{footnote:a}}
  '''

  for each tableStart of ['::table', '|-|-|']
    testCase r```
      footnote after an undeclared command in a table cell (${tableStart})
      ---
      ${tableStart}
      \mbox{\cite{foo}}[^note] | b

      [^note]: Test
      ---
      \begin{tabular}{ll}
      \mbox{\cite{foo}}%
      \footnote{\protect\label{footnote:note}Test}%
       & b \\
      \end{tabular}

    ```

    testCase r```
      repeated footnotes after undeclared commands across cells and ordinary text (${tableStart})
      ---
      ${tableStart}
      \custom{x}[^note][^note] | \custom{y}[^note]
      \custom{z}[^note] | b

      \custom{outside}[^note].
      [^note]: Test
      ---
      \begin{tabular}{ll}
      \custom{x}%
      \footnote{\protect\label{footnote:note}Test}%
      \footref{footnote:note} & \custom{y}\footref{footnote:note} \\
      \custom{z}\footref{footnote:note} & b \\
      \end{tabular}

      \custom{outside}\footref{footnote:note}.
    ```

    testCase r```
      disabled footnotes after undeclared commands in table cells (${tableStart})
      ---
      ${tableStart}
      \custom{x}[^note] | b

      [^note]: Test
      ---
      \begin{tabular}{ll}
      \custom{x}[^note] & b \\
      \end{tabular}

      [^note]: Test
    ```, markdownFootnotes: false

  testCase r'''
    footnotes in headers and body of an automatically recognized table
    ---
    \mbox{Header}[^note] | B
    - | -
    \custom{body}[^note] | b

    [^note]: Test
    ---
    \begin{tabular}{ll}
    \textbf{\mbox{Header}%
    \footnote{\protect\label{footnote:note}Test}%
    } & \textbf{B} \\
    \hline
    \custom{body}\footref{footnote:note} & b \\
    \end{tabular}

  '''

  testCase r'''
    quoted footnote ref
    ---
    See @^'long note'.
    [^long note]: A note.
    ---
    See \ref{footnote:long note}.
    [^long note]: A note.
  '''

  testCase r'''
    numeric footnote refs are not labels
    ---
    See @^1.
    [^1]: A note.
    ---
    See @^1.
    [^1]: A note.
  '''

  testCase r'''
    digit-prefixed named footnote refs are labels
    ---
    See note[^1a] and @^1a.
    [^1a]: A note.
    ---
    See note%
    \footnote{\protect\label{footnote:1a}A note.}%
     and \ref{footnote:1a}.
  '''

  testCase r'''
    undefined marker remains literal
    ---
    This remains[^missing].
    ---
    This remains[^missing].
  '''
