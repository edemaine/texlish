{ testCase } from ./helper.civet

describe '::use', ->
  testCase '''
    single package on one line
    ---
    ::use amsmath
    ---
    \\usepackage{amsmath}
  '''

  testCase '''
    multiple packages on one line
    ---
    ::use amsmath, latexsym
    ---
    \\usepackage{amsmath, latexsym}
  '''

  testCase '''
    single package with argument on one line
    ---
    ::use geometry: margin = 1in
    ---
    \\usepackage[margin = 1in]{geometry}
  '''

  testCase '''
    package argument on one line is raw
    ---
    ::use hyperref: pdftitle = *Raw* [Link](https://example.com) @ref
    ---
    \\usepackage[pdftitle = *Raw* [Link](https://example.com) @ref]{hyperref}
  '''

  testCase '''
    single package on one line with nested argument
    ---
    ::use geometry:
      margin = 1in
    ---
    \\usepackage[
      margin = 1in]{geometry}
  '''

  testCase '''
    nested package argument is raw
    ---
    ::use hyperref:
      pdftitle = *Raw* [Link](https://example.com) @ref
    ---
    \\usepackage[
      pdftitle = *Raw* [Link](https://example.com) @ref]{hyperref}
  '''

  testCase '''
    single package on one line with partially nested argument
    ---
    ::use geometry: letterpaper,
      margin = 1in
    ---
    \\usepackage[letterpaper,
      margin = 1in]{geometry}
  '''

  testCase '''
    single package on one line with comment
    ---
    ::use amsmath % for align environment
    ::use amsfonts% for mathbb
    ---
    \\usepackage{amsmath} % for align environment
    \\usepackage{amsfonts}% for mathbb
  '''

  testCase '''
    single package on one line with comment and nested argument
    ---
    ::use csquotes: % automatic " handling
      style=english
    ---
    \\usepackage[% automatic " handling
      style=english]{csquotes}
  '''

  testCase '''
    multiple nested packages
    ---
    ::use
      amsmath
      colortbl
      cleveref
    ---

      \\usepackage{amsmath}
      \\usepackage{colortbl}
      \\usepackage{cleveref}
  '''

  testCase '''
    multiple nested packages with comments
    ---
    ::use
      amsmath % for align environment
      colortbl% for row colors
      cleveref% clever references
    ---

      \\usepackage{amsmath} % for align environment
      \\usepackage{colortbl}% for row colors
      \\usepackage{cleveref}% clever references
  '''

  testCase '''
    multiple nested packages with bullets
    ---
    ::use
      * amsmath
      - colortbl
      ~ cleveref
    ---

      \\usepackage{amsmath}
      \\usepackage{colortbl}
      \\usepackage{cleveref}
  '''

  testCase '''
    multiple nested packages with bullets and comments
    ---
    ::use
      * amsmath % for align environment
      - colortbl% for row colors
      ~ cleveref% clever references
    ---

      \\usepackage{amsmath} % for align environment
      \\usepackage{colortbl}% for row colors
      \\usepackage{cleveref}% clever references
  '''

  testCase '''
    same-line package with arguments
    ---
    ::use hyperref:
      - pdftitle = Hello World
      - pdfauthor = Me
    ---
    \\usepackage[
        pdftitle = Hello World
      , pdfauthor = Me]{hyperref}
  '''

  testCase '''
    package argument bullets are raw
    ---
    ::use hyperref:
      - pdftitle = *Raw* [Link](https://example.com) @ref
      - pdfauthor = Me
    ---
    \\usepackage[
        pdftitle = *Raw* [Link](https://example.com) @ref
      , pdfauthor = Me]{hyperref}
  '''

  testCase '''
    same-line package with arguments and comments
    ---
    ::use hyperref:
      - pdftitle = Hello World % working title
      - pdfauthor = Me% = myself
    ---
    \\usepackage[
        pdftitle = Hello World % working title
      , pdfauthor = Me% = myself
    ]{hyperref}
  '''

  testCase '''
    nested packages with arguments
    ---
    ::use
      amsmath
      colortbl
      cleveref
      geometry:
        - margin = 1in
        - letterpaper
    ---

      \\usepackage{amsmath}
      \\usepackage{colortbl}
      \\usepackage{cleveref}
      \\usepackage[
          margin = 1in
        , letterpaper]{geometry}
  '''

  testCase '''
    more nested packages with arguments
    ---
    ::use
      geometry: margin=1in
      hyperref:
        - pdftitle = Hello World
        - pdfauthor = Me
    ---

      \\usepackage[margin=1in]{geometry}
      \\usepackage[
          pdftitle = Hello World
        , pdfauthor = Me]{hyperref}
  '''

  testCase '''
    more nested packages with arguments and comments
    ---
    ::use
      geometry: margin=1in % 1-inch margins
      csquotes: % automatic " handling
        style=english
      hyperref: % metadata
        - pdftitle = Hello World % working title
        - pdfauthor = Me% = myself
    ---

      \\usepackage[margin=1in % 1-inch margins
      ]{geometry}
      \\usepackage[% automatic " handling
        style=english]{csquotes}
      \\usepackage[% metadata
          pdftitle = Hello World % working title
        , pdfauthor = Me% = myself
      ]{hyperref}
  '''
