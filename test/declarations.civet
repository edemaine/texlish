{ compile, generate, process } from ../src/main.civet
{
  argumentPatternKey,
  builtinPackages,
  builtinAutoimports,
  builtinCommandPatterns,
  builtinEnvironments,
  Declarations,
  type PackageDeclarations,
  type ArgumentsPattern,
} from ../src/declarations.civet
{ getDeclarations, getStateKey, state } from ../src/parser.hera
assert from assert

function compileWithEnvironmentAutoimport(source: string, styles: Record<string, string>, env: string): string
  environments := builtinAutoimports.environments!
  previous := environments.get env
  packageName := "test-generated-style"
  builtinPackages.set packageName, { name: packageName }
  environments.set env, packageName
  try
    compile source, { styles }
  finally
    if previous?
      environments.set env, previous
    else
      environments.delete env
    builtinPackages.delete packageName

describe 'declarations', ->
  it 'finds generated environments through node and style metadata', ->
    for [source, styles, env] of [
      ['> quoted', { '>': 'customenv' }, 'customenv']
      ['```\ncode\n```', { '```*': 'customenv' }, 'customenv']
      ['- item', {}, 'itemize']
      ['1. item', {}, 'enumerate']
      ['::list customenv\n- item', {}, 'customenv']
      ['*styled*', { '*': '\\begin{customenv}' }, 'customenv']
      ['- [x] item', { '[x]': '\\begin{customenv}' }, 'customenv']
      ['---', { '---': '\\begin{customenv}' }, 'customenv']
      ['`code`', { '`': '\\begin{customenv}' }, 'customenv']
      ['@label', { '@': '\\begin{customenv}' }, 'customenv']
      ['[[citation]]', { '[[': '\\begin{customenv}' }, 'customenv']
      ['![alt](image)', { '!': '\\begin{customenv}' }, 'customenv']
      ['::tex \\begin{customenv}body\\end{customenv}', {}, 'customenv']
    ] as const
      result := compileWithEnvironmentAutoimport source, styles, env
      assert.match result, /\\usepackage\{test-generated-style\}/, source

  it 'does not discover environments inside literal code bodies', ->
    for source of [
      '`\\begin{customenv}`'
      '```\n\\begin{customenv}\n```'
    ]
      result := compileWithEnvironmentAutoimport source, {}, 'customenv'
      assert.doesNotMatch result, /\\usepackage\{test-generated-style\}/

  it 'preserves literal percent signs in verbatim definition names', ->
    packageDeclarations: PackageDeclarations :=
      name: "literal-definitions"
      commands: new Map Object.entries
        "\\defineenvironment": [
          {
            name: "environment"
            delimiter: "required"
            mode: "verbatim"
            defines: "environment"
          }
        ]
    builtinPackages.set packageDeclarations.name, packageDeclarations
    try
      for input of [
        '\\defineenvironment{custom%literal}'
        '\\defineenvironment: custom%literal'
        '\\defineenvironment:\n  - custom%literal'
        '\\defineenvironment:\n  custom%literal'
      ]
        ast := compile `::use literal-definitions\n${input}`, ast: true, fragment: true
        declarations := getDeclarations()
        declarations.packages = new Map [['custom', { name: "custom" }]]
        declarations.autoimports =
          environments: new Map [['custom%literal', 'custom']]
        ast.push { type: "Environment", env: "custom%literal", children: [] }
        process ast, {}
        assert.doesNotMatch generate(ast), /\\usepackage\{custom\}/
    finally
      builtinPackages.delete packageDeclarations.name

  it 'recognizes command definitions containing comments without changing their source', ->
    for newline of ['\n', '\r\n', '\r']
      definition := `\\newcommand{\\sout% comment${newline}}[1]{#1}`
      result := compile `${definition}${newline}Text \\sout{Hello}`
      assert result.includes definition
      assert.doesNotMatch result, /\\usepackage(?:\[[^\]]*\])?\{ulem\}/

  it 'preserves escaped percent commands when extracting definition names', ->
    ast := compile '\\newcommand{\\%}{percent}\nText \\%', ast: true, fragment: true
    getDeclarations().autoimports =
      commands: new Map [['\\%', 'custom']]
    process ast, {}
    assert.doesNotMatch generate(ast), /\\usepackage\{custom\}/

  it 'recognizes environment names and package lists containing comments', ->
    ast := compile '''
      \\newenvironment{custom% comment
      }{}{}
      \\usepackage{ul% comment
      em}
      Text \\sout{Hello}
      : custom
        body
    ''', ast: true, fragment: true
    getDeclarations().autoimports = {
      ...getDeclarations().autoimports
      environments: new Map [['custom', 'custom-package']]
    }
    process ast, {}
    result := generate ast
    assert.doesNotMatch result, /\\usepackage\{custom-package\}/
    assert.doesNotMatch result, /\\usepackage\[normalem\]\{ulem\}/

  it 'keeps parenthesized argument cache keys distinct', ->
    delimiters := ['optional', 'optional-parenthesized', 'required', 'required-parenthesized'] as const
    keys := delimiters.map (delimiter) =>
      argumentPatternKey [{ name: 'argument', delimiter, mode: 'raw' }]
    assert.equal new Set(keys).size, delimiters.length

  it 'keys undeclared patterns and remaining arguments', ->
    pattern: ArgumentsPattern := [
      { name: 'option', delimiter: 'optional', mode: 'raw' }
      { name: 'body', delimiter: 'required', mode: 'text' }
    ]
    assert.equal argumentPatternKey(undefined), '?'
    assert.notEqual argumentPatternKey(undefined), argumentPatternKey([])
    active := { args: pattern, index: 0, parentMode: 'text' as const, allowLatexArguments: false }
    state.argumentPatterns.push active
    try
      full := getStateKey()
      active.index = 1
      remaining := getStateKey()
      assert.notEqual remaining, full
      active.args = pattern[>=1]
      active.index = 0
      assert.equal getStateKey(), remaining
      active.index = active.args#
      exhausted := getStateKey()
      active.args = []
      active.index = 0
      assert.equal getStateKey(), exhausted
    finally
      state.argumentPatterns.pop()

  it 'includes undeclared LaTeX-argument permission in parse-cache keys', ->
    pattern := { args: undefined, index: 0, parentMode: 'text' as const, allowLatexArguments: false }
    state.argumentPatterns.push pattern
    try
      colonOnly := getStateKey()
      pattern.allowLatexArguments = true
      assert.notEqual getStateKey(), colonOnly
    finally
      state.argumentPatterns.pop()

  it 'caches missing command and environment lookups', ->
    declarations := new Declarations
    findCommand := declarations.findCommand.bind declarations
    findEnvironment := declarations.findEnvironment.bind declarations
    commandFinds .= 0
    environmentFinds .= 0
    declarations.findCommand = (name) ->
      commandFinds++
      findCommand name
    declarations.findEnvironment = (name) ->
      environmentFinds++
      findEnvironment name

    assert.equal declarations.getCommand("\\missing"), undefined
    assert.equal declarations.getCommand("\\missing"), undefined
    assert.equal declarations.getEnvironment("missing"), undefined
    assert.equal declarations.getEnvironment("missing"), undefined
    assert.equal commandFinds, 1
    assert.equal environmentFinds, 1

  it 'postprocess uses the current autoimport state', ->
    packages := new Map<string, PackageDeclarations> Object.entries
      custom:
        name: "custom"
        autoimportOptions: "option"
    autoimports :=
      commands: new Map Object.entries
        "\\custom": "custom"
    ast := compile '\\custom', ast: true, fragment: true
    declarations := getDeclarations()
    declarations.packages = packages
    declarations.autoimports = autoimports

    process ast, {}

    assert.match generate(ast), /\\usepackage\[option\]\{custom\}/

  it 'autoimports commands in Raw arguments while keeping Verbatim spellings literal', ->
    commands := builtinAutoimports.commands!
    previous := commands.get '\\textwidth'
    commands.set '\\textwidth', 'raw-width-test'
    try
      raw := compile '\\includegraphics[width=.5\\textwidth]{plot.pdf}', fragment: true
      assert raw.includes '\\usepackage{raw-width-test}'
      verbatim := compile '\\url{a\\textwidth}', fragment: true
      assert not verbatim.includes 'raw-width-test'
    finally
      if previous?
        commands.set '\\textwidth', previous
      else
        commands.delete '\\textwidth'

  it 'discovers commands consistently across raw argument forms', ->
    for each mode of ['raw', 'verbatim'] as const
      builtinCommandPatterns.set '\\execute', [{ name: 'body', delimiter: 'required', mode }]
      try
        for source of [
          '\\execute{\\square}'
          '\\execute: \\square'
          '\\execute:\n  \\square'
          '\\execute:\n  - \\square'
          'Text \\execute: \\square'
          '\\execute: \\% \\square'
        ]
          result := compile source, fragment: true
          assert.equal result.includes('\\usepackage{amssymb}'), mode is 'raw', `${mode}: ${source}`
      finally
        builtinCommandPatterns.delete '\\execute'

  it 'ignores comments when scanning raw environment strings for dependencies', ->
    builtinEnvironments.set 'rawscan', { args: [], body: 'raw' }
    try
      comment := '% \\square \\begin{pmatrix} \\usepackage{amssymb}'
      source .= `\\begin{rawscan}\n${comment}\n\\end{rawscan}`
      result .= compile source, fragment: true
      assert not result.includes '\\usepackage{amsmath}'
      assert not result.startsWith '\\usepackage{amssymb}'
      // An escaped percent is an ordinary control sequence, not a comment opener.
      source = `\\begin{rawscan}\n${comment}\n\\% \\square\n\\end{rawscan}`
      result = compile source, fragment: true
      assert result.startsWith '\\usepackage{amssymb}\n'
      assert not result.includes '\\usepackage{amsmath}'
      source = '\\begin{rawscan}\n\\square% comment\nx\n\\end{rawscan}'
      assert compile(source, fragment: true).startsWith '\\usepackage{amssymb}\n'
      // Removing a comment must not invent a command or a package load.
      source = '\\begin{rawscan}\n\\beg% comment\nin{pmatrix}\n\\use% comment\npackage{amssymb}\n\\square\n\\end{rawscan}'
      result = compile source, fragment: true
      assert result.startsWith '\\usepackage{amssymb}\n'
      assert not result.includes '\\usepackage{amsmath}'
    finally
      builtinEnvironments.delete 'rawscan'

  it 'recognizes package loads in raw string fragments', ->
    builtinCommandPatterns.set '\\execute', [{ name: 'body', delimiter: 'required', mode: 'raw' }]
    try
      source := '\\execute: \\usepackage{amssymb}\n\\square'
      result := compile source, fragment: true
      assert.equal result.match(/\\usepackage\{amssymb\}/g)?#, 1
    finally
      builtinCommandPatterns.delete '\\execute'

  it 'respects control symbol boundaries in Raw dependency scans', ->
    for [body, packageName] of [
      ['\\\\square', undefined]
      ['\\\\begin{pmatrix}', undefined]
      ['\\\\usepackage{amssymb}\n\\square', 'amssymb']
      ['\\\\RequirePackage{amssymb}\n\\square', 'amssymb']
      ['\\\\% \\square\nx', undefined]
      ['\\% \\square', 'amssymb']
      ['\\\\\\square', 'amssymb']
      ['\\\\\\begin{pmatrix}', 'amsmath']
    ]
      ast := compile '', ast: true, fragment: true
      ast.push { type: 'Raw', children: [body] }
      process ast, fragment: true
      result := generate ast
      for name of ['amssymb', 'amsmath']
        assert.equal result.startsWith(`\\usepackage{${name}}\n`), name is packageName, body

  it 'postprocess uses the current preamble autoimports', ->
    ast := compile '\\fallback', ast: true, fragment: true
    declarations := getDeclarations()
    declarations.packages = new Map Object.entries
      fallback:
        name: "fallback"
        preamble: "\\providecommand\\fallback{provided}"
    declarations.autoimports =
      commands: new Map Object.entries
        "\\fallback": "fallback"

    process ast, {}

    assert.match generate(ast), /\\providecommand\\fallback\{provided\}/

  it 'empty preamble suppresses package insertion', ->
    ast := compile '\\custom', ast: true, fragment: true
    declarations := getDeclarations()
    declarations.autoimports =
      commands: new Map Object.entries
        "\\custom": ""

    process ast, {}

    assert.doesNotMatch generate(ast), /\\usepackage/

  it 'autoimports environment declarations during lookup', ->
    packages := new Map<string, PackageDeclarations> Object.entries
      "":
        name: ""
        preamble: ""
      custom:
        name: "custom"
        environments: new Map Object.entries
          customenv: { args: [], body: "verbatim" }
    declarations := new Declarations packages,
      environments: new Map Object.entries
        customenv: "custom"

    assert.deepEqual declarations.getEnvironment("customenv"), { args: [], body: "verbatim" }
    assert declarations.loadedPackageNames.has "custom"

  it 'postprocess autoimports packages for used environments', ->
    for each source of [': customenv\n  body', '\\begin{custom% comment\nenv}body\\end{customenv}']
      ast := compile source, ast: true, fragment: true
      declarations := getDeclarations()
      declarations.packages = new Map Object.entries
        custom:
          name: "custom"
          autoimportOptions: "option"
      declarations.autoimports =
        environments: new Map Object.entries
          customenv: "custom"

      process ast, {}

      assert.match generate(ast), /\\usepackage\[option\]\{custom\}/

  it 'does not autoimport locally defined environments', ->
    ast := compile '''
      \\newenvironment{customenv}{}{}
      \\newtheorem*{customtheorem}{Custom}
      : customenv
        body
      : customtheorem
        body
    ''', ast: true, fragment: true
    declarations := getDeclarations()
    declarations.packages = new Map Object.entries
      custom: { name: "custom" }
    declarations.autoimports =
      environments: new Map Object.entries
        customenv: "custom"
        customtheorem: "custom"

    process ast, {}

    assert.doesNotMatch generate(ast), /\\usepackage\{custom\}/

  it 'uses metadata from custom definition-command declarations', ->
    packageDeclarations: PackageDeclarations :=
      name: "custom-definitions"
      commands: new Map Object.entries
        "\\definecommand": [
          {
            name: "command"
            delimiter: "required"
            mode: "raw"
            defines: "command"
          }
        ]
    builtinPackages.set packageDeclarations.name, packageDeclarations
    try
      result := compile '''
        ::use custom-definitions
        \\definecommand\\defn
        That's ***important***.
      '''
      assert.doesNotMatch result, /\\providecommand\\defn/
    finally
      builtinPackages.delete packageDeclarations.name
