{ r, testCase } from ./helper.civet

describe ': environments', ->
  testCase r'''
    empty
    ---
    : theorem
    ---
    \begin{theorem}
    \end{theorem}
  '''

  testCase r'''
    indented body
    ---
    : theorem
      Cool!
    ---
    \begin{theorem}
      Cool!
    \end{theorem}
  '''

  testCase r'''
    indented body with blank line
    ---
    : theorem
      Cool!

      Right?
    ---
    \begin{theorem}
      Cool!

      Right?
    \end{theorem}
  '''

  testCase r'''
    indented command body with blank line
    ---
    : figure
      \includegraphics: part1

      \includegraphics: part2
    ---
    \begin{figure}
      \includegraphics{part1}%

      \includegraphics{part2}%
    \end{figure}
  '''

  testCase r'''
    same-line argument
    ---
    : theorem: Hello
      Cool!
    ---
    \begin{theorem}{Hello}%
      Cool!
    \end{theorem}
  '''

  testCase r'''
    optional argument
    ---
    : theorem:
      ~ Hello
      Cool!
    ---
    \begin{theorem}
       [Hello]%
      Cool!
    \end{theorem}
  '''

  testCase r'''
    optional argument via square brackets
    ---
    : proof[sketch]
      By example.
    ---
    \begin{proof}[sketch]
      By example.
    \end{proof}
  '''

  testCase r'''
    with nested commands
    ---
    : figure
      \subcaptionbox:
        - Subfigure 1
        - \includegraphics: example1
      \subcaptionbox:
        - Subfigure 2
        - \includegraphics: example2
    ---
    \begin{figure}
      \subcaptionbox
         {Subfigure 1}%
         {\includegraphics{example1}}%
      \subcaptionbox
         {Subfigure 2}%
         {\includegraphics{example2}}%
    \end{figure}
  '''

  testCase r'''
    with comment
    ---
    : theorem% Big Theorem
      Cool!
    : theorem % Big Theorem
      Cool!
    ---
    \begin{theorem}% Big Theorem
      Cool!
    \end{theorem}
    \begin{theorem}% Big Theorem
      Cool!
    \end{theorem}
  '''
