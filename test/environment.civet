{ r, testCase } from ./helper.civet
{ builtinEnvironments } from ../src/declarations.civet

describe ': environments', ->
  before ->
    builtinEnvironments.set 'testtextenv',
      args: [
        { name: 'label', delimiter: 'optional', mode: 'text' }
        { name: 'value', delimiter: 'required', mode: 'text' }
      ]
      body: 'text'
    for mode of ['raw', 'math', 'verbatim'] as const
      builtinEnvironments.set `test${mode}env`,
        args: [
          { name: 'option', delimiter: 'optional', mode }
          { name: 'first', delimiter: 'required', mode }
          { name: 'second', delimiter: 'required', mode }
        ]
        body: mode
    builtinEnvironments.set 'testmixedenv',
      args: [
        { name: 'label', delimiter: 'optional', mode: 'text' }
        { name: 'settings', delimiter: 'required', mode: 'raw' }
        { name: 'value', delimiter: 'required', mode: 'inherit' }
      ]
      body: 'math'
    builtinEnvironments.set 'testdelimitedenv',
      args: [
        { name: 'label', delimiter: 'delimited', mode: 'verbatim' }
        { name: 'value', delimiter: 'required-or-delimited', mode: 'verbatim' }
        { name: 'settings', delimiter: 'required', mode: 'raw' }
      ]
      body: 'text'

  after ->
    builtinEnvironments.delete 'testtextenv'
    for mode of ['raw', 'math', 'verbatim', 'mixed', 'delimited']
      builtinEnvironments.delete `test${mode}env`

  testCase r'''
    declared environments accept unbraced command arguments
    ---
    : list \label \settings
      *body*
    ---
    \begin{list} \label \settings
      \emph{body}
    \end{list}
  '''

  testCase r'''
    declared environments accept delimited arguments before colon arguments
    ---
    : testdelimitedenv |% *label*| {% *value*}: *settings*
      *body*
    ---
    \begin{testdelimitedenv} |% *label*| {% *value*}{*settings*}%
      \emph{body}
    \end{testdelimitedenv}
  '''

  testCase r'''
    undeclared environment body commands retain their own argument modes
    ---
    \[
      : custom[option] \textbf{*body*}
    \]
    ---
    \[
      \begin{custom}[option]\textbf{\emph{body}}
      \end{custom}
    \]
  '''

  testCase r'''
    disabled by compiler option
    ---
    : theorem
      body
    ---
    : theorem
      body
  ''', colonEnvironments: false

  testCase r'''
    disabled by in-file config shorthand
    ---
    : before
    ::config -colonEnvironments
    : after
    ---
    \begin{before}
    \end{before}
    : after
  '''

  testCase r'''
    empty
    ---
    : theorem
    ---
    \begin{theorem}
    \end{theorem}
  '''

  testCase r'''
    indented body
    ---
    : theorem
      Cool!
    ---
    \begin{theorem}
      Cool!
    \end{theorem}
  '''

  testCase r'''
    indented body with blank line
    ---
    : theorem
      Cool!

      Right?
    ---
    \begin{theorem}
      Cool!

      Right?
    \end{theorem}
  '''

  testCase r'''
    indented command body with blank line
    ---
    : figure
      \includegraphics: part1

      \includegraphics: part2
    ---
    \begin{figure}
      \includegraphics{part1}%

      \includegraphics{part2}%
    \end{figure}
  '''

  testCase r'''
    same-line argument
    ---
    : theorem: Hello
      Cool!
    ---
    \begin{theorem}{Hello}%
      Cool!
    \end{theorem}
  '''

  testCase r'''
    optional argument
    ---
    : theorem:
      ~ Hello
      Cool!
    ---
    \begin{theorem}
       [Hello]%
      Cool!
    \end{theorem}
  '''

  testCase r'''
    optional argument via square brackets
    ---
    : proof[sketch]
      By example.
    ---
    \begin{proof}[sketch]
      By example.
    \end{proof}
  '''

  testCase r'''
    picture size uses parentheses for a colon argument
    ---
    : picture: 100,50
      \put(0,0){hello}
    ---
    \begin{picture}(100,50)%
      \put(0,0){hello}
    \end{picture}
  '''

  testCase r'''
    picture bullets use required and optional parentheses
    ---
    : picture:
      - 100,50
      ~ 10,20
      \put(0,0){hello}
    ---
    \begin{picture}
       (100,50)%
       (10,20)%
      \put(0,0){hello}
    \end{picture}
  '''

  testCase r'''
    with nested commands
    ---
    : figure
      \subcaptionbox:
        - Subfigure 1
        - \includegraphics: example1
      \subcaptionbox:
        - Subfigure 2
        - \includegraphics: example2
    ---
    \begin{figure}
      \subcaptionbox
         {Subfigure 1}%
         {\includegraphics{example1}}%
      \subcaptionbox
         {Subfigure 2}%
         {\includegraphics{example2}}%
    \end{figure}
  '''

  testCase r'''
    adjacent required argument is not part of the environment name
    ---
    : tabular{cc}
      a & b
    ---
    \begin{tabular}{cc}
      a & b
    \end{tabular}
  '''

  testCase r'''
    multiple mixed inline arguments use text processing
    ---
    : custom*[first]{*required*}[{]}]{\textbf{nested}}
      *body*
    ---
    \begin{custom*}[first]{\emph{required}}[{]}]{\textbf{nested}}
      \emph{body}
    \end{custom*}
  '''

  testCase r'''
    inline arguments followed by a same-line colon argument
    ---
    : custom[option]{first}: *second*
      Body
    ---
    \begin{custom}[option]{first}{\emph{second}}%
      Body
    \end{custom}
  '''

  testCase r'''
    inline arguments followed by bulleted colon arguments
    ---
    : custom[first]{second}:
      ~ *third*
      - fourth
      Body
    ---
    \begin{custom}[first]{second}
       [\emph{third}]%
       {fourth}%
      Body
    \end{custom}
  '''

  testCase r'''
    inline arguments leave same-line body commands outside the arguments
    ---
    : custom[option] \textbf{Body}
    ---
    \begin{custom}[option]\textbf{Body}
    \end{custom}
  '''

  testCase r'''
    declared math environment processes inline and colon arguments as math
    ---
    : testmathenv[x_12]{y_34}: z_56
      w_78
    ---
    \begin{testmathenv}[x_{12}]{y_{34}}{z_{56}}%
      w_{78}
    \end{testmathenv}
  '''

  testCase r'''
    inline environment arguments respect declared and inherited modes inside math
    ---
    \[
      : testtextenv[*label*]{x_12}
        *text* y_34
      : custom[x_12]{*literal*}:
        - y_34
        z_56
    \]
    ---
    \[
      \begin{testtextenv}[\emph{label}]{x_12}
        \emph{text} y_34
      \end{testtextenv}
      \begin{custom}[x_{12}]{*literal*}
         {y_{34}}%
        z_{56}
      \end{custom}
    \]
  '''

  testCase r'''
    raw environment inline arguments stay raw
    ---
    : testrawenv[*raw*]{x_12}:
      - @raw
      *body*
    ---
    \begin{testrawenv}[*raw*]{x_12}
       {@raw}%
      *body*
    \end{testrawenv}
  '''

  testCase r'''
    verbatim environment inline arguments keep percent signs literal
    ---
    : testverbatimenv[% literal]{*raw*}
      @body
    ---
    \begin{testverbatimenv}[% literal]{*raw*}
      @body
    \end{testverbatimenv}
  '''

  testCase r'''
    environment inline arguments preserve an enclosing command argument pattern
    ---
    \href:
    - https://example.com
    - : custom[option]{*label*}:
        - argument
        Body
    ---
    \href
     {https://example.com}%
     {\begin{custom}[option]{\emph{label}}
         {argument}%
        Body
      \end{custom}}%
  '''

  testCase r'''
    with comment
    ---
    : theorem% Big Theorem
      Cool!
    : theorem % Big Theorem
      Cool!
    ---
    \begin{theorem}% Big Theorem
      Cool!
    \end{theorem}
    \begin{theorem}% Big Theorem
      Cool!
    \end{theorem}
  '''

  testCase r'''
    argument modes are independent of body mode
    ---
    : testmixedenv[*label*]{*raw*}: *text*
      x_12
    \[
      : testmixedenv[*label*]:
        - *raw*
        - x_12
        y_34
    \]
    ---
    \begin{testmixedenv}[\emph{label}]{*raw*}{\emph{text}}%
      x_{12}
    \end{testmixedenv}
    \[
      \begin{testmixedenv}[\emph{label}]
         {*raw*}%
         {x_{12}}%
        y_{34}
      \end{testmixedenv}
    \]
  '''

  testCase r'''
    exhausted argument patterns leave inline groups in the body
    ---
    : tabular[t]{*{2}{c}} {*body*} [*text*]
    ---
    \begin{tabular}[t]{*{2}{c}}{\emph{body}} [\emph{text}]
    \end{tabular}
  '''

  for mode of ['text', 'math', 'raw', 'verbatim']
    testCase ```
      trims same-line body spaces in ${mode} mode
      ---
      : test${mode}env   x_12
      ---
      \\begin{test${mode}env}${if mode is 'math' then 'x_{12}' else 'x_12'}
      \\end{test${mode}env}
    ```

  testCase r'''
    unmatched same-line colon is body text while extra argument bullets inherit surrounding mode
    ---
    : equation: *text*
      x_12
    \[
      : tabular{c}:
        - x_12
        *body*
    \]
    ---
    \begin{equation}: *text*
      x_{12}
    \end{equation}
    \[
      \begin{tabular}{c}
         {x_{12}}%
        \emph{body}
      \end{tabular}
    \]
  '''

  testCase r'''
    list settings support command shorthand in bulleted arguments
    ---
    : list:
      - *label*
      - \setlength\foo: 6pt
      Body
    ---
    \begin{list}
       {\emph{label}}%
       {\setlength\foo{6pt}}%
      Body
    \end{list}
  '''

  testCase r'''
    table width preserves arithmetic and columns stay raw
    ---
    : tabular*{\dimexpr 1pt*2*3\relax}[t]{*{2}{c}}
      a & b
    ---
    \begin{tabular*}{\dimexpr 1pt*2*3\relax}[t]{*{2}{c}}
      a & b
    \end{tabular*}
  '''
