{ r, testCase } from ./helper.civet
{ builtinEnvironmentModes } from ../src/declarations.civet

describe ': environments', ->
  before ->
    builtinEnvironmentModes.set 'testtextenv', 'text'
    builtinEnvironmentModes.set 'testrawenv', 'raw'

  after ->
    builtinEnvironmentModes.delete 'testtextenv'
    builtinEnvironmentModes.delete 'testrawenv'

  testCase r'''
    disabled by compiler option
    ---
    : theorem
      body
    ---
    : theorem
      body
  ''', colonEnvironments: false

  testCase r'''
    disabled by in-file config shorthand
    ---
    : before
    ::config -colonEnvironments
    : after
    ---
    \begin{before}
    \end{before}
    : after
  '''

  testCase r'''
    empty
    ---
    : theorem
    ---
    \begin{theorem}
    \end{theorem}
  '''

  testCase r'''
    indented body
    ---
    : theorem
      Cool!
    ---
    \begin{theorem}
      Cool!
    \end{theorem}
  '''

  testCase r'''
    indented body with blank line
    ---
    : theorem
      Cool!

      Right?
    ---
    \begin{theorem}
      Cool!

      Right?
    \end{theorem}
  '''

  testCase r'''
    indented command body with blank line
    ---
    : figure
      \includegraphics: part1

      \includegraphics: part2
    ---
    \begin{figure}
      \includegraphics{part1}%

      \includegraphics{part2}%
    \end{figure}
  '''

  testCase r'''
    same-line argument
    ---
    : theorem: Hello
      Cool!
    ---
    \begin{theorem}{Hello}%
      Cool!
    \end{theorem}
  '''

  testCase r'''
    optional argument
    ---
    : theorem:
      ~ Hello
      Cool!
    ---
    \begin{theorem}
       [Hello]%
      Cool!
    \end{theorem}
  '''

  testCase r'''
    optional argument via square brackets
    ---
    : proof[sketch]
      By example.
    ---
    \begin{proof}[sketch]
      By example.
    \end{proof}
  '''

  testCase r'''
    with nested commands
    ---
    : figure
      \subcaptionbox:
        - Subfigure 1
        - \includegraphics: example1
      \subcaptionbox:
        - Subfigure 2
        - \includegraphics: example2
    ---
    \begin{figure}
      \subcaptionbox
         {Subfigure 1}%
         {\includegraphics{example1}}%
      \subcaptionbox
         {Subfigure 2}%
         {\includegraphics{example2}}%
    \end{figure}
  '''

  testCase r'''
    adjacent required argument is not part of the environment name
    ---
    : tabular{cc}
      a & b
    ---
    \begin{tabular}{cc}
      a & b
    \end{tabular}
  '''

  testCase r'''
    multiple mixed inline arguments use text processing
    ---
    : custom*[first]{*required*}[{]}]{\textbf{nested}}
      *body*
    ---
    \begin{custom*}[first]{\emph{required}}[{]}]{\textbf{nested}}
      \emph{body}
    \end{custom*}
  '''

  testCase r'''
    inline arguments followed by a same-line colon argument
    ---
    : custom[option]{first}: *second*
      Body
    ---
    \begin{custom}[option]{first}{\emph{second}}%
      Body
    \end{custom}
  '''

  testCase r'''
    inline arguments followed by bulleted colon arguments
    ---
    : custom[first]{second}:
      ~ *third*
      - fourth
      Body
    ---
    \begin{custom}[first]{second}
       [\emph{third}]%
       {fourth}%
      Body
    \end{custom}
  '''

  testCase r'''
    inline arguments leave same-line body commands outside the arguments
    ---
    : custom[option] \textbf{Body}
    ---
    \begin{custom}[option]\textbf{Body}
    \end{custom}
  '''

  testCase r'''
    declared math environment processes inline and colon arguments as math
    ---
    : align[x_12]{y_34}: z_56
      w_78
    ---
    \begin{align}[x_{12}]{y_{34}}{z_{56}}%
      w_{78}
    \end{align}
  '''

  testCase r'''
    inline environment arguments respect declared and inherited modes inside math
    ---
    \[
      : testtextenv[*label*]{x_12}
        *text* y_34
      : custom[x_12]{*literal*}:
        - y_34
        z_56
    \]
    ---
    \[
      \begin{testtextenv}[\emph{label}]{x_12}
        \emph{text} y_34
      \end{testtextenv}
      \begin{custom}[x_{12}]{*literal*}
         {y_{34}}%
        z_{56}
      \end{custom}
    \]
  '''

  testCase r'''
    raw environment inline arguments stay raw
    ---
    : testrawenv[*raw*]{x_12}:
      - @raw
      *body*
    ---
    \begin{testrawenv}[*raw*]{x_12}
       {@raw}%
      *body*
    \end{testrawenv}
  '''

  testCase r'''
    verbatim environment inline arguments keep percent signs literal
    ---
    : verbatim[% literal]{*raw*}
      @body
    ---
    \begin{verbatim}[% literal]{*raw*}
      @body
    \end{verbatim}
  '''

  testCase r'''
    environment inline arguments preserve an enclosing command argument pattern
    ---
    \href:
    - https://example.com
    - : custom[option]{*label*}:
        - argument
        Body
    ---
    \href
     {https://example.com}%
     {\begin{custom}[option]{\emph{label}}
         {argument}%
        Body
      \end{custom}}%
  '''

  testCase r'''
    with comment
    ---
    : theorem% Big Theorem
      Cool!
    : theorem % Big Theorem
      Cool!
    ---
    \begin{theorem}% Big Theorem
      Cool!
    \end{theorem}
    \begin{theorem}% Big Theorem
      Cool!
    \end{theorem}
  '''
