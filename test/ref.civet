{ r, testCase } from ./helper.civet

describe '@ shorthand for \\ref, \\label, etc.', ->
  testCase r'''
    disabled by compiler option
    ---
    @=thm:main @thm:main @#thm:main
    ---
    @=thm:main @thm:main @#thm:main
  ''', refShorthand: false

  testCase r'''
    disabled by in-file config shorthand
    ---
    @thm:main
    ::config -refShorthand
    @thm:main
    ---
    \ref{thm:main}
    @thm:main
  '''

  testCase r'''
    ref
    ---
    Theorem @thm:main
    Theorem~@thm:main
    ---
    Theorem \ref{thm:main}
    Theorem~\ref{thm:main}
  '''

  testCase r'''
    pageref
    ---
    Theorem @thm:main on page @#thm:main.
    ---
    Theorem \ref{thm:main} on page \pageref{thm:main}.
  '''

  testCase r'''
    label
    ---
    @=thm:big
    ---
    \label{thm:big}
  '''

  testCase r'''
    label in theorem
    ---
    : theorem @=thm:big
    ---
    \begin{theorem}\label{thm:big}
    \end{theorem}
  '''

  testCase r'''
    custom ref/label
    ---
    ::styles
      @ = \cref
      @# = \pagecref
      @= = \clabel
    @=thm:big
    @thm:big
    @#thm:big
    ---
    \clabel{thm:big}
    \cref{thm:big}
    \pagecref{thm:big}
  '''

  testCase r'''
    custom label without space after assignment
    ---
    ::styles
      @= =\clabel
    @=thm:big
    ---
    \clabel{thm:big}
  '''

  testCase r'''
    spaced
    ---
    @='big theorem'
    @"big theorem"
    @#{big theorem}
    ---
    \label{big theorem}
    \ref{big theorem}
    \pageref{big theorem}
  '''

  testCase r'''
    {} escaping
    ---
    {@=}thm:main
    {@}thm:main
    {@#}thm:main
    ---
    {@=}thm:main
    {@}thm:main
    {@#}thm:main
  '''

  testCase r'''
    ~ not in @ref
    ---
    Theorems~@a~\&~@b
    ---
    Theorems~\ref{a}~\&~\ref{b}
  '''

  testCase r'''
    [ not in @ref
    ---
    See @thm:main[details](https://example.com)
    ---
    See \ref{thm:main}\protect\href{https://example.com}{details}
  '''
