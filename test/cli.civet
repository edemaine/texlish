assert from assert
{ spawnSync } from node:child_process
fs from node:fs/promises
os from node:os
path from node:path
{ transpile } from ../src/cli.civet
{ version } from ../src/version.civet

describe 'CLI transpile', ->
  it 'writes the Texlish version in the generated header', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    try
      input := path.join dir, 'paper.texlish'
      output := path.join dir, 'paper.tex'
      await fs.writeFile input, 'Text'
      log := console.log
      console.log = -> undefined
      try
        await transpile input, fragment: true
      finally
        console.log = log
      tex := await fs.readFile output, 'utf8'
      assert.match tex, new RegExp `^% This file was generated by Texlish ${version.replace /\./g, '\\.'} <https://github\\.com/edemaine/texlish/>`
    finally
      await fs.rm dir,
        recursive: true
        force: true

describe 'CLI pdflatex', ->
  it 'passes weird filenames through the CLI command path', ->
    @timeout 30000
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      fakePdflatex := path.join binDir, 'pdflatex'
      // On Windows, raw spawn cannot run this extensionless script; the
      // Cygwin bash fallback below is what resolves it and honors the shebang.
      // This roughly mimics real Cygwin where pdflatex is a symlink
      // executable only by bash.
      await fs.writeFile fakePdflatex, '''
        #!/usr/bin/env bash
        set -euo pipefail
        for arg in "$@"; do
          printf 'ARGUMENT: %s\n' "$arg"
        done
      '''
      await fs.chmod fakePdflatex, 0o755
      filename := "paper weird ';&()[]{}+=!,%.texlish"
      input := path.join(dir, filename).replace /\\/g, '/'
      output := input.replace /\.texlish$/, '.tex'
      await fs.writeFile input, 'Text'
      result := spawnSync process.execPath, [
        path.resolve('dist/texlish')
        '--pdf'
        input
      ],
        env: {
          ...process.env
          PATH: `${binDir}${path.delimiter}${process.env.PATH ?? ''}`
        }
        encoding: 'utf8'
      assert.equal result.status, 0, `${result.stdout ?? ''}${result.stderr ?? ''}`
      tex := await fs.readFile output, 'utf8'
      assert.equal tex.includes('Text'), true
      args := result.stdout!.trimEnd().split('\n').filter (line) =>
        line.startsWith 'ARGUMENT: '
      assert.deepEqual args, [`ARGUMENT: ${output}`]
    finally
      await fs.rm dir,
        recursive: true
        force: true
