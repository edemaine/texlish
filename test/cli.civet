assert from assert
{ spawnSync } from node:child_process
fs from node:fs/promises
os from node:os
path from node:path
{ buildLatex, cli, transpile } from ../src/cli.civet
{ escapeRegExp } from ../src/util.civet
{ version } from ../src/version.civet

function writeExecutable(filename: string, text: string): Promise<void>
  await fs.writeFile filename, text.replace /^\n/, ''
  await fs.chmod filename, 0o755

async function writeCommand(binDir: string, command: string, text: string): Promise<void>
  script := path.join binDir, command
  await writeExecutable script, text
  if process.platform is 'win32'
    process.env.PATHEXT = commandPathExt process.env.PATHEXT
    await fs.writeFile path.join(binDir, `${command}.cmd`), `@echo off\r\nbash "%~dp0${command}" %*\r\n`

function commandPathExt(pathExt: string?): string
  exts := (pathExt ?? '').split ';'
  ['.CMD', ...exts.filter (ext) => ext.toUpperCase() is not '.CMD'].join ';'

function commandPath(binDir: string, oldPath: string?): string
  if process.platform is 'win32'
    `${binDir}${path.delimiter}C:\\Windows\\System32`
  else
    `${binDir}${path.delimiter}${oldPath ?? ''}`

async function captureConsoleLog(callback: () => Promise<unknown>): Promise<string[]>
  log := console.log
  lines: string[] .= []
  console.log = (...args: unknown[]) =>
    lines.push args.map(String).join ' '
  try
    await callback()
  finally
    console.log = log
  lines

function logsInclude(logs: string[], text: string): boolean
  logs.some (line) => line.includes text

function removeDir(dir: string): Promise<void>
  fs.rm dir,
    recursive: true
    force: true
    maxRetries: 10
    retryDelay: 100

describe 'CLI usage', ->
  it 'shows the Texlish version', ->
    argv := process.argv
    try
      process.argv = [process.execPath, 'texlish', '--help']
      logs := await captureConsoleLog -> cli()
      assert.equal logs.length, 1
      assert logs[0].startsWith(
        `Texlish ${version}\nUsage: texlish [options] filename`
      )
    finally
      process.argv = argv

  it 'prints just the version for --version', ->
    argv := process.argv
    try
      process.argv = [process.execPath, 'texlish', '--version']
      logs := await captureConsoleLog -> cli()
      assert.deepEqual logs, [version]
    finally
      process.argv = argv

describe 'CLI transpile', ->
  it 'writes the Texlish version in the generated header', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    try
      input := path.join dir, 'paper.texlish'
      output := path.join dir, 'paper.tex'
      await fs.writeFile input, 'Text'
      log := console.log
      console.log = -> undefined
      try
        await transpile input, fragment: true
      finally
        console.log = log
      tex := await fs.readFile output, 'utf8'
      assert.match tex, new RegExp `^% This file was generated by Texlish ${escapeRegExp version} <https://github\\.com/edemaine/texlish/>`
    finally
      await removeDir dir

describe 'CLI pdflatex', ->
  @timeout 30000

  it 'passes weird filenames through the CLI command path', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'CWD_BASENAME: %s\n' "$(basename "$PWD")"
        for arg in "$@"; do
          printf 'ARGUMENT: %s\n' "$arg"
        done
      '''
      filename := "paper weird ';&()[]{}+=!,%.texlish"
      input := path.join(dir, filename).replace /\\/g, '/'
      output := input.replace /\.texlish$/, '.tex'
      await fs.writeFile input, 'Text'
      result := spawnSync process.execPath, [
        path.resolve('dist/texlish')
        '--pdf'
        input
      ],
        env: {
          ...process.env
          PATH: commandPath binDir, process.env.PATH
        }
        encoding: 'utf8'
      assert.equal result.status, 0, `${result.stdout ?? ''}${result.stderr ?? ''}`
      tex := await fs.readFile output, 'utf8'
      assert.equal tex.includes('Text'), true
      lines := result.stdout!.trimEnd().split('\n')
      assert lines.includes `CWD_BASENAME: ${path.basename dir}`
      args := lines.filter (line) =>
        line.startsWith 'ARGUMENT: '
      assert.deepEqual args, [
        `ARGUMENT: ${path.basename output}`
      ]
    finally
      await removeDir dir

  it 'keeps separate LaTeX option values with their flags', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        for arg in "$@"; do
          printf 'ARGUMENT: %s\n' "$arg"
        done
      '''
      input := path.join(dir, 'paper.texlish').replace /\\/g, '/'
      await fs.writeFile input, 'Text'
      result := spawnSync process.execPath, [
        path.resolve('dist/texlish')
        '--pdf'
        '-output-directory'
        'out'
        input
      ],
        env: {
          ...process.env
          PATH: commandPath binDir, process.env.PATH
        }
        encoding: 'utf8'
      assert.equal result.status, 0, `${result.stdout ?? ''}${result.stderr ?? ''}`
      lines := result.stdout!.trimEnd().split('\n')
      args := lines.filter (line) =>
        line.startsWith 'ARGUMENT: '
      assert.deepEqual args, [
        'ARGUMENT: -output-directory'
        'ARGUMENT: out'
        'ARGUMENT: paper.tex'
      ]
      assert.equal result.stdout!.includes('Ignoring unknown file: out'), false
    finally
      await removeDir dir

describe 'CLI LaTeX build', ->
  @timeout 30000

  it 'runs BibTeX and reruns LaTeX when .bbl content changes', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'pdflatex %s\n' "$*" >> calls.txt
        backslash=$(printf '\\134')
        printf '%s\n' "${backslash}bibdata{refs}" > paper.aux
        : > paper.log
      '''
      await writeCommand binDir, 'bibtex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'bibtex %s\n' "$*" >> calls.txt
        cat > "$1.bbl" <<'BBL'
        \\begin{thebibliography}{1}
        \\bibitem{x} bibliography
        \\end{thebibliography}
        BBL
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      await fs.writeFile path.join(dir, 'refs.bib'), '@article{x,author={A},title={T},journal={J},year={2020}}'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      assert logsInclude logs, '** paper.pdf built via pdflatex, bibtex, pdflatex'
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex'
        'bibtex paper'
        'pdflatex paper.tex'
      ]
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'reruns BibTeX when LaTeX changes BibTeX-relevant aux input', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        count=0
        if [ -f latex-count ]; then
          count=$(cat latex-count)
        fi
        count=$((count + 1))
        printf '%s\n' "$count" > latex-count
        printf 'pdflatex %s %s\n' "$*" "$count" >> calls.txt
        backslash=$(printf '\\134')
        if [ "$count" -eq 1 ]; then
          printf '%s\n' "${backslash}citation{a}" > paper.aux
        else
          printf '%s\n' "${backslash}citation{b}" > paper.aux
          printf '%s\n' "${backslash}citation{a}" >> paper.aux
          printf '%s\n' "${backslash}bibcite{a}{1}" >> paper.aux
        fi
        printf '%s\n' "${backslash}bibstyle{unsrt}" >> paper.aux
        printf '%s\n' "${backslash}bibdata{refs}" >> paper.aux
        : > paper.log
      '''
      await writeCommand binDir, 'bibtex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'bibtex %s\n' "$*" >> calls.txt
        if grep -q 'citation{b}' "$1.aux"; then
          cat > "$1.bbl" <<'BBL'
        \\begin{thebibliography}{1}
        \\bibitem{b} bibliography b
        \\bibitem{a} bibliography a
        \\end{thebibliography}
        BBL
        else
          cat > "$1.bbl" <<'BBL'
        \\begin{thebibliography}{1}
        \\bibitem{a} bibliography a
        \\end{thebibliography}
        BBL
        fi
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      await fs.writeFile path.join(dir, 'refs.bib'), '@article{a,author={A},title={A},journal={J},year={2020}}\n@article{b,author={B},title={B},journal={J},year={2020}}'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      assert logsInclude logs, '** paper.pdf built via pdflatex, bibtex, pdflatex, bibtex, pdflatex'
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex 1'
        'bibtex paper'
        'pdflatex paper.tex 2'
        'bibtex paper'
        'pdflatex paper.tex 3'
      ]
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'continues cross-reference reruns while .aux changes, then stops when stable', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        count=0
        if [ -f latex-count ]; then
          count=$(cat latex-count)
        fi
        count=$((count + 1))
        printf '%s\n' "$count" > latex-count
        printf 'pdflatex %s %s\n' "$*" "$count" >> calls.txt
        if [ "$count" -lt 3 ]; then
          label="run-$count"
        else
          label="run-2"
        fi
        printf '\\relax\n\\newlabel{x}{{%s}{1}}\n' "$label" > paper.aux
        cat > paper.log <<'LOG'
        LaTeX Warning: Label(s) may have changed. Rerun to get cross-references right.
        LOG
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      assert logsInclude logs, '** paper.pdf built via pdflatex, pdflatex, pdflatex'
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex 1'
        'pdflatex paper.tex 2'
        'pdflatex paper.tex 3'
      ]
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'restores previous .bbl and stops when BibTeX writes no entries', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'pdflatex %s\n' "$*" >> calls.txt
        backslash=$(printf '\\134')
        printf '%s\n' "${backslash}bibdata{missing}" > paper.aux
        : > paper.log
      '''
      await writeCommand binDir, 'bibtex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'bibtex %s\n' "$*" >> calls.txt
        cat > "$1.bbl" <<'BBL'
        \\begin{thebibliography}{}
        \\end{thebibliography}
        BBL
        exit 1
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      await fs.writeFile path.join(dir, 'paper.bbl'), 'submitted bibliography'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 1
      assert.equal logsInclude(logs, '** paper.pdf built via pdflatex, bibtex'), false
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex'
        'bibtex paper'
      ]
      assert.equal await fs.readFile(path.join(dir, 'paper.bbl'), 'utf8'), 'submitted bibliography'
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'runs Biber and reruns LaTeX when .bbl content changes', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'pdflatex %s\n' "$*" >> calls.txt
        backslash=$(printf '\\134')
        printf '%s\n' "${backslash}abx@aux@cite{0}{x}" > paper.aux
        : > paper.log
        : > paper.bcf
      '''
      await writeCommand binDir, 'biber', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'biber %s\n' "$*" >> calls.txt
        cat > "$1.bbl" <<'BBL'
        \\entry{x}{article}{}
        BBL
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      assert logsInclude logs, '** paper.pdf built via pdflatex, biber, pdflatex'
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex'
        'biber paper'
        'pdflatex paper.tex'
      ]
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'runs BibTeX instead of Biber when stale .bcf exists but .aux has bibdata', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'pdflatex %s\n' "$*" >> calls.txt
        backslash=$(printf '\\134')
        printf '%s\n' "${backslash}bibdata{refs}" > paper.aux
        : > paper.log
      '''
      await writeCommand binDir, 'bibtex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'bibtex %s\n' "$*" >> calls.txt
        cat > "$1.bbl" <<'BBL'
        \\begin{thebibliography}{1}
        \\bibitem{x} bibliography
        \\end{thebibliography}
        BBL
      '''
      await writeCommand binDir, 'biber', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'biber %s\n' "$*" >> calls.txt
        exit 1
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      await fs.writeFile path.join(dir, 'paper.bcf'), 'stale bcf'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      assert logsInclude logs, '** paper.pdf built via pdflatex, bibtex, pdflatex'
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex'
        'bibtex paper'
        'pdflatex paper.tex'
      ]
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'looks for generated files in LaTeX output directories', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      outDir := path.join dir, 'out'
      await fs.mkdir binDir
      await fs.mkdir outDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'pdflatex %s\n' "$*" >> calls.txt
        out=.
        for arg in "$@"; do
          case "$arg" in
            -output-directory=*) out="${arg#*=}" ;;
          esac
        done
        backslash=$(printf '\\134')
        printf '%s\n' "${backslash}bibdata{refs}" > "$out/paper.aux"
        : > "$out/paper.log"
      '''
      await writeCommand binDir, 'bibtex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'bibtex %s\n' "$*" >> calls.txt
        cat > out/paper.bbl <<'BBL'
        \\begin{thebibliography}{1}
        \\bibitem{x} bibliography
        \\end{thebibliography}
        BBL
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      await fs.writeFile path.join(dir, 'refs.bib'), '@article{x,author={A},title={T},journal={J},year={2020}}'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      await captureConsoleLog ->
        result = await buildLatex 'pdflatex', ['-output-directory=out'], texFile

      assert.equal result, 0
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex -output-directory=out paper.tex'
        `bibtex ${path.join 'out', 'paper'}`
        'pdflatex -output-directory=out paper.tex'
      ]
      assert.equal await fs.readFile(path.join(outDir, 'paper.bbl'), 'utf8'), '\\begin{thebibliography}{1}\n\\bibitem{x} bibliography\n\\end{thebibliography}\n'
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'reruns LaTeX when generated outputs change by content', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        count=0
        if [ -f latex-count ]; then
          count=$(cat latex-count)
        fi
        count=$((count + 1))
        printf '%s\n' "$count" > latex-count
        printf 'pdflatex %s\n' "$*" >> calls.txt
        if [ "$count" -lt 3 ]; then
          toc="toc-$count"
        else
          toc="toc-2"
        fi
        printf '%s\n' "$toc" > paper.toc
        : > paper.log
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      assert logsInclude logs, '** paper.pdf built via pdflatex, pdflatex, pdflatex'
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex'
        'pdflatex paper.tex'
        'pdflatex paper.tex'
      ]
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'does not rerun LaTeX for aux-only changes without label warnings', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'pdflatex %s\n' "$*" >> calls.txt
        printf '%s\n' "$RANDOM" > paper.aux
        : > paper.log
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex'
      ]
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'runs makeindex and reruns LaTeX when .ind content changes', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'pdflatex %s\n' "$*" >> calls.txt
        printf '\\indexentry{a}{1}\n' > paper.idx
        : > paper.log
      '''
      await writeCommand binDir, 'makeindex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'makeindex %s\n' "$*" >> calls.txt
        output=
        while [ "$#" -gt 0 ]; do
          case "$1" in
            -o) output="$2"; shift 2 ;;
            *) shift ;;
          esac
        done
        printf 'index\n' > "$output"
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      assert logsInclude logs, '** paper.pdf built via pdflatex, makeindex, pdflatex'
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex'
        'makeindex -o paper.ind paper.idx'
        'pdflatex paper.tex'
      ]
    finally
      process.env.PATH = oldPath
      await removeDir dir

  it 'runs makeindex once even when existing .idx content did not change', ->
    dir := await fs.mkdtemp path.join os.tmpdir(), 'texlish-cli-'
    oldPath := process.env.PATH
    try
      binDir := path.join dir, 'bin'
      await fs.mkdir binDir
      await writeCommand binDir, 'pdflatex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'pdflatex %s\n' "$*" >> calls.txt
        printf '\\indexentry{a}{1}\n' > paper.idx
        : > paper.log
      '''
      await writeCommand binDir, 'makeindex', '''
        #!/usr/bin/env bash
        set -euo pipefail
        printf 'makeindex %s\n' "$*" >> calls.txt
        output=
        while [ "$#" -gt 0 ]; do
          case "$1" in
            -o) output="$2"; shift 2 ;;
            *) shift ;;
          esac
        done
        printf 'fresh index\n' > "$output"
      '''
      texFile := path.join dir, 'paper.tex'
      await fs.writeFile texFile, 'Text'
      await fs.writeFile path.join(dir, 'paper.idx'), '\\indexentry{a}{1}\n'
      await fs.writeFile path.join(dir, 'paper.ind'), 'stale index\n'
      process.env.PATH = commandPath binDir, oldPath

      result .= 1
      logs := await captureConsoleLog ->
        result = await buildLatex 'pdflatex', [], texFile

      assert.equal result, 0
      assert logsInclude logs, '** paper.pdf built via pdflatex, makeindex, pdflatex'
      calls := await fs.readFile path.join(dir, 'calls.txt'), 'utf8'
      assert.deepEqual calls.trimEnd().split('\n'), [
        'pdflatex paper.tex'
        'makeindex -o paper.ind paper.idx'
        'pdflatex paper.tex'
      ]
      assert.equal await fs.readFile(path.join(dir, 'paper.ind'), 'utf8'), 'fresh index\n'
    finally
      process.env.PATH = oldPath
      await removeDir dir
