{ testCase } from ./helper.civet
{ compile } from ../src/main.civet
assert from assert

describe 'Markdown backticks', ->
  verbOptions := {styles: {'`': '\\verb'}}
  allPrintable := for join c of ["!".."~"] then c

  // No `r` because backticks are escaped when Civet transpiles raw strings.
  testCase '''
    inline code span
    ---
    Use `\\verb` for inline verbatim.
    ---
    Use \\texttt{\\char`\\\\verb} for inline verbatim.
  '''

  testCase '''
    code span containing backtick
    ---
    ``There is a literal backtick (`) here.``
    ---
    \\texttt{There\\ is\\ a\\ literal\\ backtick\\ (`{})\\ here.}
  '''

  testCase '''
    code span trims one padding space
    ---
    A single backtick: `` ` ``
    ---
    A single backtick: \\texttt{`{}}
  '''

  testCase '''
    code span only trims one padding space
    ---
    `  ``  `
    ---
    \\texttt{\\ `{}`{}\\ }
  '''

  testCase '''
    code span keeps one-sided padding
    ---
    ` a` and `b `
    ---
    \\texttt{\\ a} and \\texttt{b\\ }
  '''

  testCase '''
    code span line endings become spaces
    ---
    ``foo
    bar
    baz``
    ---
    \\texttt{foo\\ bar\\ baz}
  '''

  testCase '''
    code span line indentation becomes one space
    ---
    `foo
        bar`
    ---
    \\texttt{foo\\ bar}
  '''

  testCase '''
    code span does not cross blank line
    ---
    `foo

    bar`
    ---
    `foo

    bar`
  '''

  testCase '''
    dedented code span continuation stays literal
    ---
    - outer
      - inner `foo
    bar`
    ---
    \\begin{itemize}
    \\item outer
      \\begin{itemize}
      \\item inner `foo
      \\end{itemize}
    \\end{itemize}
    bar`
  '''

  testCase '''
    configured verb code span uses backtick delimiter before pipe
    ---
    `a|b`
    ---
    \\verb`a|b`
  ''', verbOptions

  testCase '''
    configured verb code span chooses delimiter not in body
    ---
    ``a`|b``
    ---
    \\verb!a`|b!
  ''', verbOptions

  testCase '''
    configured verb code span chooses later printable delimiter
    ---
    ``a`|!b``
    ---
    \\verb"a`|!b"
  ''', verbOptions

  it 'default code span needs no unused printable delimiter', ->
    assert.doesNotThrow => compile "``" + allPrintable + "``"

  it 'configured verb code span throws when no printable delimiter is available', ->
    assert.throws (
      => compile "``" + allPrintable + "``", verbOptions
    ), /printable ASCII delimiter/

  testCase '''
    unmatched code span is literal
    ---
    ```foo``
    ---
    ```foo``
  '''

  testCase '''
    threshold leaves shorter spans literal
    ---
    `one` and ```three```
    ---
    `one` and \\texttt{three}
  ''', markdownBackticks: 3

  testCase '''
    disabled by compiler option
    ---
    `code`
    ---
    `code`
  ''', markdownBackticks: false

  testCase '''
    disabled by in-file config shorthand
    ---
    `before`
    ::config -markdownBackticks
    `after`
    ---
    \\texttt{before}
    `after`
  '''

  testCase '''
    enabled for larger backtick runs by in-file config
    ---
    ::config markdownBackticks=2
    `one` and ``two``
    ---
    `one` and \\texttt{two}
  '''

  testCase '''
    disabled by markdownCompat shorthand
    ---
    `before`
    ::config -markdownCompat
    `after`
    ---
    \\texttt{before}
    `after`
  '''

  testCase '''
    custom inline style
    ---
    ::styles
      `` = \\Verb
    ``code``
    ---
    \\Verb`code`
  '''

  testCase '''
    verb style explicitly restores delimited inline code
    ---
    ::styles
      ` = \\verb
    `a_b%`
    ---
    \\verb`a_b%`
  '''

  testCase '''
    default inline code inside command arguments
    ---
    \\textbf{`a_b%`}
    ---
    \\textbf{\\texttt{a\\char`\\_b\\%}}
  '''

  testCase '''
    custom inline style falls back to shorter marker
    ---
    ::styles
      `` = \\Verb
    ```code```
    ---
    \\Verb`code`
  '''

  testCase '''
    non-verb custom inline style
    ---
    ::styles
      `` = \\texttt
    ``code``
    ---
    \\texttt{code}
  '''

  testCase '''
    custom text style escapes literal code
    ---
    ::styles
      ` = \\textsf
    `a_b%`
    ---
    \\textsf{a\\char`\\_b\\%}
  '''

  testCase '''
    custom inline style follows its declared argument
    ---
    ::styles
      `` = \\EscVerb
    ``code``
    ---
    \\EscVerb{code}
  '''

  testCase '''
    custom verbatim style keeps literal code unescaped
    ---
    ::styles
      ` = \\Verb
    `a_b%`
    ---
    \\Verb`a_b%`
  '''

  testCase '''
    custom EscVerb style receives escaped literal code
    ---
    ::styles
      ` = \\EscVerb
    `a_b%`
    ---
    \\EscVerb{a\\_b\\%}
  '''

  testCase '''
    text code escapes punctuation ligatures
    ---
    `'' -- << >> ,,`
    ---
    \\texttt{'{}'{}\\ -{}-{}\\ <{}<{}\\ >{}>{}\\ ,{},{}}
  '''

  testCase '''
    character escapes preserve following digits without empty groups
    ---
    `$12 _34 \\56 {78}90 ^12 ~34`
    ---
    \\texttt{\\char`\\$12\\ \\char`\\_34\\ \\char`\\\\56\\ \\char`\\{78\\char`\\}90\\ \\char`\\^12\\ \\char`\\~34}
  '''

  testCase '''
    EscVerb style escapes backslashes caret tilde and repeated spaces
    ---
    ::styles
      ` = \\EscVerb
    `A\\foo{}$&#%_^~^^   Z`
    ---
    \\EscVerb{A\\\\foo\\{\\}\\$\\&\\#\\%\\_\\^\\~\\^\\^\\ \\ \\ Z}
  '''

  testCase '''
    starred EscVerb style escapes literal code inside a command
    ---
    ::styles
      ` = \\EscVerb*
    \\textbf{`A\\foo{}$&#%_^~^^   Z`}
    ---
    \\textbf{\\EscVerb*{A\\\\foo\\{\\}\\$\\&\\#\\%\\_\\^\\~\\^\\^\\ \\ \\ Z}}
  '''

  testCase '''
    fenced code block
    ---
    ```
    x < y
    ```
    ---
    \\begin{verbatim}
    x < y
    \\end{verbatim}
  '''

  testCase '''
    empty fenced code block
    ---
    ```
    ```
    ---
    \\begin{verbatim}
    \\end{verbatim}
  '''

  testCase '''
    fenced code block allows blank lines
    ---
    ```
    foo

    bar
    ```
    ---
    \\begin{verbatim}
    foo

    bar
    \\end{verbatim}
  '''

  testCase '''
    fenced code block can be followed by statement
    ---
    ```
    x
    ```
    next
    ---
    \\begin{verbatim}
    x
    \\end{verbatim}
    next
  '''

  testCase '''
    fenced code block can close with longer fence
    ---
    ```
    x
    ````
    ---
    \\begin{verbatim}
    x
    \\end{verbatim}
  '''

  testCase '''
    longer fenced code block can contain shorter fence
    ---
    ````
    ```
    x
    ```
    ````
    ---
    \\begin{verbatim}
    ```
    x
    ```
    \\end{verbatim}
  '''

  testCase '''
    indented fenced code block removes opening fence indent
    ---
      ```
        if x:
          y()
    ```
    ---
      \\begin{verbatim}
      if x:
        y()
    \\end{verbatim}
  '''

  testCase '''
    indented fenced code block preserves unindented content lines
    ---
      ```
    left
       right
    ```
    ---
      \\begin{verbatim}
    left
     right
    \\end{verbatim}
  '''

  testCase '''
    fenced code block does not grab dedented list content
    ---
    - outer
      - item
        ```
        x
      y
        ```
    ---
    \\begin{itemize}
    \\item outer
      \\begin{itemize}
      \\item item
        ```
        x
      \\end{itemize}
      y
        ```
    \\end{itemize}
  '''

  testCase '''
    custom fenced code block style
    ---
    ::styles
      ````* = lstlisting
    ````
    x
    ````
    ---
    \\begin{lstlisting}
    x
    \\end{lstlisting}
  '''

  testCase '''
    fenced code style falls back to shorter info marker
    ---
    ::styles
      ````py = lstlisting[language=Python]
    `````py
    print("hello")
    `````
    ---
    \\begin{lstlisting}[language=Python]
    print("hello")
    \\end{lstlisting}
  '''

  testCase '''
    fenced code style falls back to shorter generic marker
    ---
    ::styles
      ````* = lstlisting
    `````
    x
    `````
    ---
    \\begin{lstlisting}
    x
    \\end{lstlisting}
  '''

  testCase '''
    inline and fenced code styles are distinct
    ---
    ::styles
      ``` = \\Verb
      ```* = lstlisting
    ```inline```
    ```
    block
    ```
    ---
    \\Verb`inline`
    \\begin{lstlisting}
    block
    \\end{lstlisting}
  '''

  testCase '''
    fenced code style by info string
    ---
    ::styles
      ```py = : lstlisting[language=Python]
    ```py
    print("hello")
    ```
    ---
    \\begin{lstlisting}[language=Python]
    print("hello")
    \\end{lstlisting}
  '''

  testCase '''
    fenced code style accepts plain environment spec
    ---
    ::styles
      ```js = lstlisting[language=JavaScript]
    ```js
    console.log("hello")
    ```
    ---
    \\begin{lstlisting}[language=JavaScript]
    console.log("hello")
    \\end{lstlisting}
  '''

  testCase '''
    fenced code style accepts parenthesized environment arguments
    ---
    ::styles
      ```* = picture(100,50)
    ```
    \\put(0,0){hello}
    ```
    ---
    \\begin{picture}(100,50)
    \\put(0,0){hello}
    \\end{picture}
  '''

  testCase '''
    fenced code style accepts begin environment
    ---
    ::styles
      ```cpp = \\begin{lstlisting}[language=C++]
    ```cpp
    int main() {}
    ```
    ---
    \\begin{lstlisting}[language=C++]
    int main() {}
    \\end{lstlisting}
  '''

  testCase '''
    fenced code optional argument passes to environment
    ---
    ::styles
      ```* = lstlisting
    ```[numbers=left]
    x
    ```
    ---
    \\begin{lstlisting}[numbers=left]
    x
    \\end{lstlisting}
  '''

  testCase '''
    unknown fenced code info falls back to generic style
    ---
    ::styles
      ```* = lstlisting
    ```python
    x
    ```
    ---
    \\begin{lstlisting}
    x
    \\end{lstlisting}
  '''

  testCase '''
    empty fenced code style falls back to default
    ---
    ::styles
      ```* =
    ```
    x
    ```
    ---
    \\begin{verbatim}
    x
    \\end{verbatim}
  '''

  testCase '''
    fenced code block disabled below threshold
    ---
    ```
    x
    ```
    ````
    y
    ````
    ---
    ```
    x
    ```
    \\begin{verbatim}
    y
    \\end{verbatim}
  ''', markdownBackticks: 4
