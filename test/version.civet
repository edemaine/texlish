assert from assert
{ compile } from ../src/main.civet
{ satisfiesVersionRange, version } from ../src/version.civet
{ r, testCase } from ./helper.civet

describe 'version ranges', ->
  it 'checks exact versions', ->
    assert.equal satisfiesVersionRange('1.2.3', '1.2.3'), true
    assert.equal satisfiesVersionRange('1.2.3', '=1.2.3'), true
    assert.equal satisfiesVersionRange('1.2.3', '= 1.2.3'), true
    assert.equal satisfiesVersionRange('1.2.3', '1.2.4'), false
    assert.equal satisfiesVersionRange('1.2.3', '=1.2.4'), false

  it 'checks comparison ranges combined with AND', ->
    assert.equal satisfiesVersionRange('1.2.3', '>=1.2.0 <1.3.0'), true
    assert.equal satisfiesVersionRange('1.3.0', '>=1.2.0 <1.3.0'), false
    assert.equal satisfiesVersionRange('1.2.3', '>= 1.2.0 < 1.3.0'), true
    assert.equal satisfiesVersionRange('1.2.3', '1.2.3 <1.2.4'), true

  it 'checks OR ranges combined with ||', ->
    assert.equal satisfiesVersionRange('1.1.5', '1.1 || 1.2'), true
    assert.equal satisfiesVersionRange('1.2.3', '1.1 || 1.2'), true
    assert.equal satisfiesVersionRange('1.3.0', '1.1 || 1.2'), false
    assert.equal satisfiesVersionRange('1.5.0', '>=1.0.0 <1.1.0 || >=1.5.0 <2.0.0'), true
    assert.equal satisfiesVersionRange('1.4.9', '>=1.0.0 <1.1.0 || >=1.5.0 <2.0.0'), false

  it 'checks partial and wildcard ranges', ->
    assert.equal satisfiesVersionRange('1.2.3', '1.2'), true
    assert.equal satisfiesVersionRange('1.3.0', '1.2'), false
    assert.equal satisfiesVersionRange('1.2.3', '1.2.x'), true
    assert.equal satisfiesVersionRange('1.2.3', '1.2.*'), true
    assert.equal satisfiesVersionRange('1.2.3', '1.x'), true
    assert.equal satisfiesVersionRange('2.0.0', '1'), false
    assert.equal satisfiesVersionRange('2.0.0', '*'), true

  it 'checks prerelease precedence', ->
    assert.equal satisfiesVersionRange('1.2.3-alpha.2', '>=1.2.3-alpha.1 <1.2.3'), true
    assert.equal satisfiesVersionRange('1.2.3-alpha.10', '>1.2.3-alpha.2'), true
    assert.equal satisfiesVersionRange('1.2.3', '>1.2.3-alpha.1'), true

  it 'includes prerelease versions according to SemVer precedence', ->
    assert.equal satisfiesVersionRange('0.1.0-beta', '0.1'), true
    assert.equal satisfiesVersionRange('0.1.0-beta', '0.1.x'), true
    assert.equal satisfiesVersionRange('0.1.0-beta', '>=0.1.0 <0.2.0'), false
    assert.equal satisfiesVersionRange('0.1.0-beta', '0.1.0-beta'), true
    assert.equal satisfiesVersionRange('0.1.0-beta', '>=0.1.0-beta <0.2.0'), true
    assert.equal satisfiesVersionRange('0.1.1-beta', '>=0.1.0 <0.2.0'), true
    assert.equal satisfiesVersionRange('0.1.1-beta', '0.1 || 0.2'), true
    assert.equal satisfiesVersionRange('0.2.0-beta', '0.1 || >=0.2.0'), false

  it 'rejects unsupported range syntax', ->
    assert.throws (
      => satisfiesVersionRange('1.2.3', '^1.2.0')
    ), /Invalid version range/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '1.2.3 ||')
    ), /Version range cannot be empty/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '1.2.3 || || 1.2.4')
    ), /Version range cannot be empty/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '>=1.2.0 | <2.0.0')
    ), /Invalid version range/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '1.2.3<1.2.4')
    ), /Invalid version range/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '1.2.3< 1.2.4')
    ), /Invalid version range/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '>=1.2.x')
    ), /Invalid version range/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '=1.2')
    ), /Invalid version range/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '1.2.x-alpha')
    ), /Invalid version range/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '01.2.3')
    ), /numeric component 01 cannot contain leading zeroes/
    assert.throws (
      => satisfiesVersionRange('1.2.3', '1.2.3-alpha.01')
    ), /numeric component 01 cannot contain leading zeroes/

  testCase r'''
    accepts matching ::version
    ---
    ::version >=0.0.0
    Text
    ---
    Text
  '''

  it 'accepts the current exact version', ->
    assert.equal compile(`::version ${version}\nText`, fragment: true), 'Text'

  it 'rejects nonmatching ::version', ->
    assert.throws (
      => compile('::version >9999.0.0\nText', fragment: true)
    ), /Texlish .* does not satisfy version range >9999\.0\.0/
