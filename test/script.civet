{ r, testCase } from ./helper.civet

describe 'sub/superscript autogrouping', ->
  testCase r'''
    declared commands include all arguments in a script
    ---
    $x_\frac{a_12}{b_34} + y^\text{*fast*}$
    ---
    $x_{\frac{a_{12}}{b_{34}}} + y^{\text{\emph{fast}}}$
  '''

  testCase r'''
    declared zero-argument commands form complete scripts
    ---
    $x_\alpha + y^\Gamma$
    ---
    $x_{\alpha} + y^{\Gamma}$
  '''

  testCase r'''
    autoimport commands activate their package declarations while parsing
    ---
    $x_\sout{y} + a^\square + b_\boxtimes$
    ---
    $x_{\sout{y}} + a^{\square} + b_{\boxtimes}$
  '''

  testCase r'''
    use activates package-only commands after a cached miss
    ---
    $x_\uline{a}$
    ::use ulem
    $x_\uline{b}$
    ---
    $x_\uline{a}$
    \usepackage{ulem}
    $x_{\uline{b}}$
  '''

  testCase r'''
    incomplete declared commands do not leak their argument pattern
    ---
    $x_\frac{a} + y_12$
    ---
    $x_\frac{a} + y_{12}$
  '''

  testCase r'''
    inherited arguments follow their parent mode
    ---
    \phantom: *text* x_12
    $x_\phantom{*math* x_12}$
    ---
    \phantom{\emph{text} x_12}%
    $x_{\phantom{*math* x_{12}}}$
  '''

  testCase r'''
    none mode disables declared command script grouping
    ---
    $x_\frac{a}{b}$
    ---
    $x_\frac{a}{b}$
  ''', scriptGrouping: "none"

  testCase r'''
    digits only for subscripts
    ---
    $x_12 + x_ij$
    ---
    $x_{12} + x_ij$
  '''

  testCase r'''
    digits only for superscripts
    ---
    $x^12 + x^ij$
    ---
    $x^{12} + x^ij$
  '''

  testCase r'''
    text mode stays literal
    ---
    x_12 + x_ij + x^(ij)
    ---
    x_12 + x_ij + x^(ij)
  '''

  testCase r'''
    alphanumeric mode
    ---
    $x_12 + x_ij + x_i1 + x_1i + x^12 + x^ij + x^i1 + x^1i$
    ---
    $x_{12} + x_{ij} + x_{i1} + x_{1i} + x^{12} + x^{ij} + x^{i1} + x^{1i}$
  ''', scriptGrouping: "alphanumeric"

  testCase r'''
    alpha mode
    ---
    $x_12 + x_ij + x_i1 + x_1i + x^12 + x^ij + x^i1 + x^1i$
    ---
    $x_12 + x_{ij} + x_i1 + x_1i + x^12 + x^{ij} + x^i1 + x^1i$
  ''', scriptGrouping: "alpha"

  testCase r'''
    none mode
    ---
    $x_12 + x_ij + x_i1 + x_1i + x^12 + x^ij + x^i1 + x^1i$
    ---
    $x_12 + x_ij + x_i1 + x_1i + x^12 + x^ij + x^i1 + x^1i$
  ''', scriptGrouping: "none"

  testCase r'''
    numeric mode keeps mixed alphanumerics
    ---
    $x_i1 + x_1i + x^i1 + x^1i$
    ---
    $x_i1 + x_1i + x^i1 + x^1i$
  ''', scriptGrouping: "numeric"

  testCase r'''
    parenthesized script grouping
    ---
    $x_(ij) + x^(i+j)$
    ---
    $x_{ij} + x^{i+j}$
  '''

  testCase r'''
    nested parenthesized script grouping
    ---
    $x_(i(j+k))$
    ---
    $x_{i(j+k)}$
  '''

  testCase r'''
    multiline parenthesized script grouping
    ---
    $x_(foo
      bar)$
    ---
    $x_{foo
      bar}$
  '''

  testCase r'''
    parenthesized script grouping stops before nested statement
    ---
    $x_(foo
      \emph: bar)
    $
    ---
    $x_(foo
      \emph{bar)}%
    $
  '''

  testCase r'''
    plain brackets do not balance inside parenthesized script grouping
    ---
    $x_([a)b])$
    ---
    $x_{[a}b])$
  '''

  testCase r'''
    inline colon command wins over parenthesized script grouping
    ---
    $x_(\emph: ij)
    $
    ---
    $x_(\emph{ij)}%
    $
  '''

  testCase r'''
    parenthesized script grouping ignores nested script after space
    ---
    _(_{foo}) _( _{foo}) ^(^{foo}) ^( ^{foo})
    ---
    _(_{foo}) _( _{foo}) ^(^{foo}) ^( ^{foo})
  '''

  testCase r'''
    scriptParens option disables parenthesized script grouping
    ---
    $x_(ij) + x^(i+j)$
    ---
    $x_(ij) + x^(i+j)$
  ''', scriptParens: false

  testCase r'''
    latexCompat option disables autogrouping
    ---
    $x_12 + x_ij + x_i1 + x_(ij) + x^12 + x^ij + x^i1 + x^(ij)$
    ---
    $x_12 + x_ij + x_i1 + x_(ij) + x^12 + x^ij + x^i1 + x^(ij)$
  ''', latexCompat: true

  testCase r'''
    in-file ::config
    ---
    $x_ij$
    ::config
      scriptGrouping = alphanumeric
    $x_ij + x_i1$
    ::config
      scriptGrouping = none
    $x_12 + x_i1$
    ---
    $x_ij$
    $x_{ij} + x_{i1}$
    $x_12 + x_i1$
  '''

  testCase r'''
    in-file ::config compact assignment
    ---
    $x_ij$
    ::config
      scriptGrouping=alphanumeric
    $x_ij + x_i1$
    ---
    $x_ij$
    $x_{ij} + x_{i1}$
  '''

  testCase r'''
    inline ::config
    ---
    $x_ij$
    ::config scriptGrouping=alphanumeric
    $x_ij + x_i1$
    ---
    $x_ij$
    $x_{ij} + x_{i1}$
  '''

  testCase r'''
    in-file ::config latexCompat flag
    ---
    $x_12 + x_(ij)$
    ::config
      latexCompat
    $x_12 + x_(ij)$
    ---
    $x_{12} + x_{ij}$
    $x_12 + x_(ij)$
  '''

  testCase r'''
    in-file ::config styles section
    ---
    *foo*
    ::config
      styles:
        * = \textit
    *foo*
    ---
    \emph{foo}
    \textit{foo}
  '''

  testCase r'''
    inline ::config dotted style
    ---
    *foo*
    ::config styles.*=\textit
    *foo*
    ---
    \emph{foo}
    \textit{foo}
  '''

  testCase r'''
    in-file ::config style values are raw
    ---
    ::config styles.*=[raw](https://example.com) @ref *text*
    *foo*
    ---
    [raw](https://example.com) @ref *text*{foo}
  '''

  testCase r'''
    in-file ::styles values are raw
    ---
    ::styles
      * = [raw](https://example.com) @ref *text*
    *foo*
    ---
    [raw](https://example.com) @ref *text*{foo}
  '''

  testCase r'''
    in-file ::config empty styles section
    ---
    *foo*
    ::config
      styles:
    *foo*
    ---
    \emph{foo}
    \emph{foo}
  '''

  testCase r'''
    inline ::config empty styles section
    ---
    *foo*
    ::config styles:
    *foo*
    ---
    \emph{foo}
    \emph{foo}
  '''

  testCase r'''
    inline ::config nonempty styles section
    ---
    *foo*
    ::config styles:
      * = \textit
    *foo*
    ---
    \emph{foo}
    \textit{foo}
  '''
