{ r, testCase } from ./helper.civet

describe '<autolink>', ->
  // examples from https://spec.commonmark.org/0.31.2/#autolinks

  testCase r'''
    594
    ---
    <http://foo.bar.baz>
    ---
    \protect\url{http://foo.bar.baz}
  '''

  testCase r'''
    595
    ---
    <https://foo.bar.baz/test?q=hello&id=22&boolean>
    ---
    \protect\url{https://foo.bar.baz/test?q=hello&id=22&boolean}
  '''

  testCase r'''
    596
    ---
    <irc://foo.bar:2233/baz>
    ---
    \protect\url{irc://foo.bar:2233/baz}
  '''

  testCase r'''
    597
    ---
    <MAILTO:FOO@BAR.BAZ>
    ---
    \protect\url{MAILTO:FOO@BAR.BAZ}
  '''

  testCase r'''
    598
    ---
    <a+b+c:d>
    ---
    \protect\url{a+b+c:d}
  '''

  testCase r'''
    599
    ---
    <made-up-scheme://foo,bar>
    ---
    \protect\url{made-up-scheme://foo,bar}
  '''

  testCase r'''
    600
    ---
    <https://../>
    ---
    \protect\url{https://../}
  '''

  testCase r'''
    601
    ---
    <localhost:5001/foo>
    ---
    \protect\url{localhost:5001/foo}
  '''

  testCase r'''
    602
    ---
    <https://foo.bar/baz bim>
    ---
    <https://foo.bar/baz bim>
  '''

  testCase r'''
    603
    ---
    <https://example.com/\[\>
    ---
    \protect\url{https://example.com/\[\}
  '''

  testCase r'''
    604
    ---
    <foo@bar.example.com>
    ---
    \protect\href{mailto:foo@bar.example.com}{\protect\nolinkurl{foo@bar.example.com}}
  '''

  testCase r'''
    605
    ---
    <foo+special@Bar.baz-bar0.com>
    ---
    \protect\href{mailto:foo+special@Bar.baz-bar0.com}{\protect\nolinkurl{foo+special@Bar.baz-bar0.com}}
  '''

  testCase r'''
    606
    ---
    <foo\+@bar.example.com>
    ---
    <foo\+\ref{bar.example.com>}
  '''

  testCase r'''
    607
    ---
    <>
    ---
    <>
  '''

  testCase r'''
    608
    ---
    < https://foo.bar >
    ---
    < https://foo.bar >
  '''

  testCase r'''
    609
    ---
    <m:abc>
    ---
    <m:abc>
  '''

  testCase r'''
    610
    ---
    <foo.bar.baz>
    ---
    <foo.bar.baz>
  '''

  testCase r'''
    610
    ---
    https://example.com
    ---
    https://example.com
  '''

  testCase r'''
    611
    ---
    foo@bar.example.com
    ---
    foo@bar.example.com
  '''

  testCase r'''
    mid-line URL
    ---
    See <https://example.com> now.
    ---
    See \protect\url{https://example.com} now.
  '''

  testCase r'''
    mid-line email
    ---
    Email <foo@bar.example.com> now.
    ---
    Email \protect\href{mailto:foo@bar.example.com}{\protect\nolinkurl{foo@bar.example.com}} now.
  '''

  // No `r` because backticks are escaped when Civet transpiles raw strings.
  testCase '''
    escaping email
    ---
    <!#$%&'*+/=?^_`|~-@example.com>
    ---
    \\protect\\href{mailto:!#$%25&amp;'*+/=?%5E_%60%7C~-@example.com}{\\protect\\nolinkurl{!#$%&'*+/=?^_`|~-@example.com}}
  '''

  testCase r'''
    braced email ids
    ---
    <{one,two}@example.com>
    ---
    \protect\href{mailto:one@example.com,two@example.com}{\protect\nolinkurl{{one,two}@example.com}}
  '''

describe 'Markdown links', ->
  testCase r'''
    plain link
    ---
    See [Texlish](https://texlish.org).
    ---
    See \protect\href{https://texlish.org}{Texlish}.
  '''

  testCase r'''
    balanced parens in link target
    ---
    See [Texlish](https://texlish.org/foo(and(bar))).
    ---
    See \protect\href{https://texlish.org/foo(and(bar))}{Texlish}.
  '''

  testCase r'''
    escaped parens in link target
    ---
    See [Texlish](\(https://texlish.org\)).
    ---
    See \protect\href{(https://texlish.org)}{Texlish}.
  '''

  testCase r'''
    escaped unbalanced parens in link target
    ---
    See [Texlish](https://texlish.org/foo\(bar).
    ---
    See \protect\href{https://texlish.org/foo(bar}{Texlish}.
  '''

  testCase r'''
    escaped punctuation in link target
    ---
    See [Texlish](https://texlish.org/foo\)\:bar).
    ---
    See \protect\href{https://texlish.org/foo):bar}{Texlish}.
  '''

  testCase r'''
    unbalanced parens in link target stay literal
    ---
    See [Texlish](https://texlish.org/foo(bar).
    ---
    See [Texlish](https://texlish.org/foo(bar).
  '''

  testCase r'''
    angle-wrapped link target permits unbalanced parens
    ---
    See [Texlish](<https://texlish.org/foo(bar>).
    ---
    See \protect\href{https://texlish.org/foo(bar}{Texlish}.
  '''

  testCase r'''
    angle-wrapped link target permits spaces
    ---
    See [Texlish](</my uri>).
    ---
    See \protect\href{/my uri}{Texlish}.
  '''

  testCase r'''
    angle-wrapped link target permits escaped angle bracket
    ---
    See [Texlish](<foo\>bar>).
    ---
    See \protect\href{foo>bar}{Texlish}.
  '''

  testCase r'''
    inline markup in link text
    ---
    See [*Texlish* @docs](https://texlish.org/docs).
    ---
    See \protect\href{https://texlish.org/docs}{\emph{Texlish} \ref{docs}}.
  '''

  testCase r'''
    balanced brackets in link text
    ---
    See [Texlish [docs]](https://texlish.org/docs).
    ---
    See \protect\href{https://texlish.org/docs}{Texlish [docs]}.
  '''

  testCase r'''
    adjacent balanced brackets in link text
    ---
    See [foo[bar]baz](https://example.com).
    ---
    See \protect\href{https://example.com}{foo[bar]baz}.
  '''

  testCase r'''
    plain parens do not balance inside Markdown link text
    ---
    See [foo(a](https://first.example)b)](https://second.example).
    ---
    See \protect\href{https://first.example}{foo(a}b)](https://second.example).
  '''

  testCase r'''
    markup inside balanced brackets in link text
    ---
    See [Texlish [*docs*]](https://texlish.org/docs).
    ---
    See \protect\href{https://texlish.org/docs}{Texlish [\emph{docs}]}.
  '''

  testCase r'''
    indented multiline link text
    ---
    See [Texlish
      docs](https://texlish.org/docs).
    ---
    See \protect\href{https://texlish.org/docs}{Texlish
      docs}.
  '''

  testCase r'''
    multiline balanced brackets in link text
    ---
    See [Texlish [docs
      page]](https://texlish.org/docs).
    ---
    See \protect\href{https://texlish.org/docs}{Texlish [docs
      page]}.
  '''

  testCase r'''
    same-indent multiline link text in nested body
    ---
    \emph:
      [foo
      [bar]
      baz](https://example.com)
    ---
    \emph{%
      \protect\href{https://example.com}{foo
      [bar]
      baz}}%
  '''

  testCase r'''
    unindented multiline link text
    ---
    See [Texlish
    docs](https://texlish.org/docs).
    ---
    See \protect\href{https://texlish.org/docs}{Texlish
    docs}.
  '''

  testCase r'''
    unindented multiline balanced brackets in link text
    ---
    [foo
    [bar]
    baz](https://example.com)
    ---
    \protect\href{https://example.com}{foo
    [bar]
    baz}
  '''

  testCase r'''
    multiline link text does not grab next list item
    ---
    - See [Texlish
    - docs](https://texlish.org/docs)
    ---
    \begin{itemize}
    \item See [Texlish
    \item docs](https://texlish.org/docs)
    \end{itemize}
  '''

  testCase r'''
    multiline link text does not grab dedented list content
    ---
    - outer
      - [a
      b](https://example.com)
    ---
    \begin{itemize}
    \item outer
      \begin{itemize}
      \item [a
      \end{itemize}
      b](https://example.com)
    \end{itemize}
  '''

  testCase r'''
    multiline link text can continue on next top-level line
    ---
    See [Texlish
    Next paragraph](https://texlish.org/docs).
    ---
    See \protect\href{https://texlish.org/docs}{Texlish
    Next paragraph}.
  '''

  testCase r'''
    inline and autolink disabled by compiler option
    ---
    See [Texlish](https://texlish.org).
    See <https://texlish.org>.
    ---
    See [Texlish](https://texlish.org).
    See <https://texlish.org>.
  ''', markdownLinks: false

  testCase r'''
    inline and autolink disabled by in-file config shorthand
    ---
    [Texlish](https://texlish.org)
    <https://texlish.org>
    ::config -markdownLinks
    [Texlish](https://texlish.org)
    <https://texlish.org>
    ---
    \protect\href{https://texlish.org}{Texlish}
    \protect\url{https://texlish.org}
    [Texlish](https://texlish.org)
    <https://texlish.org>
  '''

  testCase r'''
    inline and autolink disabled by markdownCompat shorthand
    ---
    [Texlish](https://texlish.org)
    <https://texlish.org>
    ::config -markdownCompat
    [Texlish](https://texlish.org)
    <https://texlish.org>
    ---
    \protect\href{https://texlish.org}{Texlish}
    \protect\url{https://texlish.org}
    [Texlish](https://texlish.org)
    <https://texlish.org>
  '''
