{
  "name": "texlish",
  "type": "module",
  "version": "0.2.0",
  "description": "Better LaTeX that compiles to LaTeX",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./*": "./*",
    "./dist/*": "./dist/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edemaine/texlish.git"
  },
  "bin": {
    "texlish": "dist/texlish"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "register.js"
  ],
  "engines": {
    "node": ">=19 || ^18.6.0 || ^16.17.0"
  },
  "scripts": {
    "build": "bash ./build/build.sh",
    "vscode:grammar": "pnpm --dir vscode grammar",
    "docs:dev": "pnpm build && pnpm vscode:grammar && pnpm --dir docs dev",
    "docs:build": "pnpm build && pnpm vscode:grammar && pnpm --dir docs build",
    "prepublish": "pnpm build",
    "typecheck": "civet --typecheck",
    "test": "mocha && pnpm typecheck"
  },
  "author": "Erik Demaine",
  "license": "MIT",
  "devDependencies": {
    "@danielx/civet": "0.11.14",
    "@danielx/hera": "0.9.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.0",
    "esbuild": "^0.25.8",
    "mocha": "^11.7.6",
    "typescript": "^5.9.2"
  },
  "hera": {
    "language": "civet"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d",
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
