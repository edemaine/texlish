{
  "name": "texlish",
  "displayName": "Texlish",
  "description": "Texlish Language Support",
  "version": "0.3.1",
  "publisher": "edemaine",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/edemaine/texlish.git"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "texlish",
        "extensions": [
          ".texlish"
        ],
        "configuration": "./languages/texlish-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "texlish",
        "scopeName": "text.tex.texlish",
        "path": "./syntaxes/texlish.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "grammar": "civet --no-config build/yaml2json.civet",
    "build": "bash ./build/build.sh",
    "test": "pnpm grammar && mocha --config ../.mocharc.json",
    "package": "pnpm run build && vsce package",
    "vsce-publish": "pnpm run build && vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml": "^2.9.0"
  }
}
