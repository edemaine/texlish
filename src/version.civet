export const version: string = comptime
  import "../package.json", with: type: "json"
  |> await
  |> .default.version
else "0.0.0" // for non-async typing, and used in testing

type PrereleaseIdentifier = string | number

type Version =
  major: number
  minor: number
  patch: number
  prerelease?: PrereleaseIdentifier[]?

type Comparator =
  op: "<" | "<=" | ">" | ">=" | "="
  version: Version

comparisonOpsRE := "<=|>=|<|>|="

// https://semver.org/
versionRE := ///
  // major   minor    patch
  ^ (\d+) \. (\d+) \. (\d+)
  // prerelease
  (?: - ( [0-9A-Za-z-]+ (?: \.[0-9A-Za-z-]+ )* ) )?
  // build metadata (ignored for comparison)
  (?: \+ [0-9A-Za-z-]+ (?: \.[0-9A-Za-z-]+ )* )?
  $
///
numericIdentifierRE := /^(0|[1-9]\d*)$/
wildVersionRE := ///
  ${versionRE.source} |
  // Version with wildcards or partial information (implicit wildcards)
  // E.g. 1.2 = 1.2.x
  ^ ( [0-9]+ | [xX*] )
  (?: \. ( [0-9]+ | [xX*] )
    (?: \. ( [0-9]+ | [xX*] ) )?
  )?
  $
///
fullOffset := 1
wildOffset := 5
wildcardRE := /^[xX*]$/

/** Parse a numeric version component, rejecting leading zeroes or unsafe values. */
function parseNumber(part: string, versionText: string): number
  unless numericIdentifierRE.test part
    throw new Error `Invalid version ${versionText}: numeric component ${part} cannot contain leading zeroes`
  value := Number part
  unless Number.isSafeInteger value
    throw new Error `Invalid version ${versionText}: numeric component ${part} is too large`
  value

/** Parse a strict SemVer-like version into comparable numeric and prerelease parts. */
function parseVersion(versionText: string): Version
  unless match := versionRE.exec versionText
    throw new Error `Invalid version: ${versionText}`
  parseVersionMatch match, versionText

/** Convert a SemVer regex match into comparable numeric and prerelease parts. */
function parseVersionMatch(match: RegExpExecArray, versionText: string): Version
  major: parseNumber match[1], versionText
  minor: parseNumber match[2], versionText
  patch: parseNumber match[3], versionText
  prerelease:
    for each identifier of match[4]?.split('.') ?? []
      if identifier is like /^\d+$/
        parseNumber identifier, versionText
      else
        identifier

/** Compare SemVer prerelease identifiers, where numeric identifiers sort before text. */
function compareIdentifiers(a: PrereleaseIdentifier, b: PrereleaseIdentifier): -1 | 0 | +1
  // "Numeric identifiers always have lower precedence than non-numeric identifiers."
  return -1 if a <? "number" and b !<? "number"
  return +1 if b <? "number" and a !<? "number"
  // "Identifiers consisting of only digits are compared numerically."
  // "Identifiers with letters or hyphens are compared lexically in ASCII sort order."
  // We've already converted numeric identifiers to numbers,
  // so same comparison works for both.
  return -1 if a < b
  return +1 if a > b
  0

/** Compare two parsed versions according to SemVer precedence. */
function compareVersions(a: Version, b: Version): -1 | 0 | +1
  for each key of ["major", "minor", "patch"] as const
    diff := a[key] - b[key]
    return Math.sign(diff) as -1 | 0 | +1 if diff

  aPrerelease := a.prerelease ?? []
  bPrerelease := b.prerelease ?? []
  // A release version has higher precedence than its prereleases.
  return 0 unless aPrerelease# or bPrerelease#
  return 1 unless aPrerelease#
  return -1 unless bPrerelease#

  for each aIdentifier?, bIdentifier? of aPrerelease, bPrerelease
    // "A larger set of pre-release fields has a higher precedence than a smaller set, if all of the preceding identifiers are equal."
    return -1 unless aIdentifier?
    return 1 unless bIdentifier?
    diff := compareIdentifiers aIdentifier, bIdentifier
    return diff if diff
  0

/** Parse || alternatives of whitespace-separated AND comparators. */
function parseComparators(range: string): Comparator[][]
  for each alternative of range.split /\s*\|\|\s*/
    parseComparatorAlternative range, alternative

/** Parse one whitespace-separated AND alternative. */
function parseComparatorAlternative(range: string, alternative: string): Comparator[]
  comparators: Comparator[] := []
  // Allow spaces after comparison operators,
  // then split on required whitespace between comparators.
  tokens := alternative
    .replace /// (${comparisonOpsRE}) \s+ ///g, "$1"
    .trim()
    .split /\s+/
  for each let token of tokens
    continue unless token
    op: Comparator["op"]? .= undefined
    if match := /// ^ (${comparisonOpsRE}) ///.exec token
      op = match[1] as Comparator["op"]
      token = token[>= match[0]#]

    unless match := wildVersionRE.exec token
      throw new Error `Invalid version range: ${range}`
    versionText := match[0]
    if match[fullOffset]? // full version, possibly with operator
      comparators.push {
        op ?? "="
        version: parseVersionMatch match, versionText
      }
    else if op
      throw new Error `Invalid version range: ${range} uses comparison operator with wildcard/partial version`
    else
      wildcard .= false
      wild: Partial<Version> := {}
      for each key, i of ["major", "minor", "patch"] as const
        part := match[i + wildOffset]
        if part?
          if wildcardRE.test part
            wildcard = true
          else if wildcard
            throw new Error `Invalid version range: ${range} has non-wildcard after wildcard`
          else
            wild[key] = parseNumber part, versionText
        else
          wildcard = true
      // Full wild `*` uses sentinel lower than any valid SemVer version.
      wild.major ?= -1
      comparators.push
        op: ">="
        version: {
          wild.major
          wild.minor ?? 0
          wild.patch ?? 0
          prerelease: [0] if wild.major >= 0
        }
      if wild.major >= 0
        comparators.push
          op: "<"
          version:
            if wild.minor?
              major: wild.major
              minor: wild.minor + 1
              patch: 0
              prerelease: [0]
            else
              major: wild.major + 1
              minor: 0
              patch: 0
              prerelease: [0]

  unless comparators#
    throw new Error "Version range cannot be empty"
  comparators

/** Return whether a version satisfies a range of whitespace-separated comparators. */
export function satisfiesVersionRange(versionText: string, range: string): boolean
  current := parseVersion versionText
  for some each comparators of parseComparators range
    // Prereleases are included according to SemVer precedence,
    // like npm semver's includePrerelease option.
    for every each comparator of comparators
      comparison := compareVersions current, comparator.version
      switch comparator.op
        when "<"
          comparison < 0
        when "<="
          comparison <= 0
        when ">"
          comparison > 0
        when ">="
          comparison >= 0
        when "="
          comparison is 0
        else
          throw new Error `Invalid comparator operator: ${comparator.op}`

/** Throw if the current Texlish package version does not satisfy the range. */
export function assertTexlishVersion(range: string): void
  unless satisfiesVersionRange version, range
    throw new Error `Texlish ${version} does not satisfy version range ${range}`
