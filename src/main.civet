// Need to no-cache any rule that directly modifies parser state
// indentation stack, jsx stack, etc.

uncacheable := new Set [
  // Indentation
  // Push* and Pop* rules mutate the indentation stack or pending line indent;
  // they must not be reused across parser states.
  "Indent"
  "PushIndent"
  "PushStrictIndent"
  "PushStrictCurrentIndent"
  "PopIndent"
  "SaveIndent"
  "PushLineIndent"
  "PopLineIndent"
  "PushListItemIndent"
  "PushListItemPendingIndent"
  "PopListItemIndent"
  // List item markers set state.listItemIndent for PushListItemIndent.
  "Bullet"
  "NumberBullet"
  // ListItemLine chooses between statement/text list-item setup, both stateful.
  "ListItemLine"
  // These rules change the active argument-pattern stack/suffix. This includes
  // wrappers whose children consume arguments without restoring the suffix:
  // a cache hit skips the entire subtree and would not replay that transition.
  // Rules that only read the stack and wrappers with no net change stay cached.
  // Push or pop the active pattern.
  "PushTextCommandPattern"
  "PushMathCommandPattern"
  "PushTextColonCommandPattern"
  "PushMathColonCommandPattern"
  "PushGenericRawArgumentPattern"
  "PushGenericVerbatimArgumentPattern"
  "PushGenericTextArgumentPattern"
  "PushGenericMathArgumentPattern"
  "PopCommandPattern"
  // Directly consume a finite pattern suffix.
  "CommandArgument"
  "CommandArgumentAfterColon"
  "InlineCommandArgumentAfterColon"
  "ArgumentBullet"
  "CommandFinalArgument"
  // Return with a suffix consumed by a child.
  "NestedCommandArgumentList"
  "ArgumentList"
  "ArgumentListContinuation"
  // Parse arguments and pop the active pattern before returning.
  "CommandArguments"
  "CommandArgumentsAfterColon"
  "InlineCommandArgumentsAfterColon"
  "EnvironmentArgumentsAfterColon"
  // Parser config mutation
  "MetaStyles"
  "MetaConfig"
  // Code spans/blocks temporarily record their opening marker/fence; body
  // rules use marker-sensitive close checks.
  "CodeSpan"
  "CodeSpanOpen"
  "CodeSpanBodyPart"
  "CodeSpanClose"
  "CodeBlock"
  "CodeBlockOpen"
  "CodeBlockBodyLine"
  "CodeBlockClose"
]

export function generate(ast: AST): string
  function recurse(ast: AST): string
    if ast <? "string"
      ast
    else unless ast?
      ''
    else if Array.isArray ast
      ast.map(recurse).join ''
    else if "children" in ast
      ast.children.map(recurse).join ''
    else if "token" in ast
      ast.token
    else
      throw new Error `Unrecognized token ${ast}`
  recurse ast
  // Special \0 character eats a following newline,
  // and at end of file a preceding newline
  .replace /(\n|\r\n?)\0$/g, ''
  .replace /\0(\n|\r\n?)?/g, ''

type CompileOutput<T extends CompilerOptions> =
  T extends { ast: true } ? AST[] : string

export function compile<const T extends CompilerOptions>(src: string, options?: T?): CompileOutput<T>
  unless options
    options = {} as T
  else
    options = {...options}

  filename := options.filename or "unknown"
  oldOptions := getCompilerOptions()
  setCompilerOptions makeCompilerOptions options
  finally setCompilerOptions oldOptions

  events := makeCache options

  let ast: AST[]
  try
    ast = parse(src, {
      filename
      events
    })
  finally
    if trace := options.trace
      import('node:fs').then ({ writeFileSync }) =>
        { logs } := events.meta
        writeFileSync trace, logs.join "\n"

  process ast, options

  if options.ast
    return ast as CompileOutput<T>

  ast
  |> generate
  |> as CompileOutput<T>

type MetaData
  logs: string[]

type ParseState =
  input: string
  pos: number

type ParseResult = {
  pos: number
  value: unknown
} | undefined

type CacheEvents
  meta: MetaData
  enter: (ruleName: string, state: ParseState) => { cache: ParseResult } | undefined
  exit: (ruleName: string, state: ParseState, result: ParseResult) => void

function makeCache(options: CompilerOptions): CacheEvents
  stateCache := new StateCache<ParseResult>

  { trace } := options
  logs: string[] := []
  stack: string[] := []
  meta: MetaData := { logs }

  events := {
    meta
    enter(ruleName: string, state: ParseState)
      return if uncacheable.has ruleName

      stateKey := getStateKey()
      key: CacheKey := [stateKey, state.pos, ruleName ]

      // We cache `undefined` when a rule fails to match so we need to use `has` here.
      if stateCache.has(key)
        result := stateCache.get(key)
        if trace
          logs.push "".padStart(stack# * 2, " ") + ruleName + ":" + state.pos + `[${stateKey}]` + "💰" + (if result then "✅" else "❌")
        return {
          cache: if result then { ...result }
        }

      if trace
        logs.push "".padStart(stack# * 2, " ") + ruleName + ":" + state.pos + `[${stateKey}]` + "{"
        stack.push ruleName
      return

    exit(ruleName: string, state: ParseState, result: ParseResult): void
      if uncacheable.has ruleName
        logs.push "".padStart(stack# * 2, " ") + ruleName + `[${getStateKey()}]` + ":" + state.pos + " " + (if result then "✅" else "❌")
        return

      stateKey := getStateKey()
      key: CacheKey := [stateKey, state.pos, ruleName ]
      result = { ...result } if result?
      stateCache.set(key, result)

      if trace
        stack.pop()
        logs.push "".padStart(stack# * 2, " ") + ruleName + ":" + state.pos + `[${stateKey}]` + "} " + (if result then "✅" else "❌")
  }

  return events
