// based on https://github.com/DanielXMoore/Civet/blob/main/source/main.civet

{ parse, getStateKey, ParseError, getCompilerOptions, setCompilerOptions } from ./parser.hera
{ FAIL } from @danielx/hera/lib
type { Tracer } from @danielx/hera
//import * as sourcemap from "./sourcemap.civet"
//{ SourceMap } := sourcemap
export { parse, ParseError }

{ process } from ./postprocess.civet
export { process }

type {
  Argument
  ArgumentForm
  AST
  Call
  CompilerOptions
} from ./types.civet
export type { Argument, ArgumentForm, AST, Call, CompilerOptions }

{ makeCompilerOptions } from ./config.civet
export {
  applyCompilerOption
  makeCompilerOptions
  parseConfigAssignment
} from ./config.civet
export { version } from ./version.civet

export function generate(ast: AST): string
  function recurse(ast: AST): string
    if ast <? "string"
      ast
    else unless ast?
      ''
    else if Array.isArray ast
      ast.map(recurse).join ''
    else if "children" in ast
      ast.children.map(recurse).join ''
    else if "token" in ast
      ast.token
    else
      throw new Error `Unrecognized token ${ast}`
  recurse ast
  // Special \0 character eats a following newline,
  // and at end of file a preceding newline
  .replace /(\n|\r\n?)\0$/g, ''
  .replace /\0(\n|\r\n?)?/g, ''

type CompileOutput<T extends CompilerOptions> =
  T extends { ast: true } ? AST[] : string

export function compile<const T extends CompilerOptions>(src: string, options?: T?): CompileOutput<T>
  unless options
    options = {} as T
  else
    options = {...options}

  filename := options.filename or "unknown"
  oldOptions := getCompilerOptions()
  setCompilerOptions makeCompilerOptions options
  finally setCompilerOptions oldOptions

  tracer := makeTracer() if options.trace

  let ast: AST[]
  try
    ast = parse(src, {
      filename
      ...(tracer and { trace: tracer })
    })
  finally
    if trace := options.trace
      import('node:fs').then ({ writeFileSync }) =>
        writeFileSync trace, tracer!.logs.join "\n"

  process ast, options

  if options.ast
    return ast as CompileOutput<T>

  ast
  |> generate
  |> as CompileOutput<T>

/** A Hera tracer that logs every rule, for the `trace` option */
function makeTracer(): Tracer & { logs: string[] }
  logs: string[] := []
  depth .= 0
  line := (rule: string, pos: number, mark: string) =>
    "".padStart(depth * 2, " ") + rule + ":" + pos + `[${getStateKey()}]` + mark

  {
    logs
    enter(rule, pos)
      logs.push line rule, pos, "{"
      depth++
    exit(rule, pos, _end, value, cached)
      depth--
      result := if value is FAIL then "❌" else "✅"
      if cached
        // A cache hit runs no other rules, so it replaces its enter line
        logs[logs# - 1] = line rule, pos, "💰" + result
      else
        logs.push line rule, pos, "} " + result
  }
