type {
  AST,
  CompilerOptions,
  Delimiter,
  FootnoteDefinition,
  FootnoteRef,
  SmartQuote,
} from ./types.civet
{ find, isNumeric, iterate, iteratePrePost, iterateFlatArrays } from ./util.civet

defaultDocumentClass := "\\documentclass[11pt]{article}"
defaultDefnCommand := "\\providecommand\\defn[1]{\\textbf{\\textit{\\boldmath #1}}}"

/** Root node is always an array of statements */
export function process(root: AST[], options: CompilerOptions): AST
  processSmartQuotes root
  processMarkdown root
  processFootnotes root
  processBeginEnd root
  processDocument root unless options.fragment
  root

/**
 * Convert source smart quotes ' and " to TeX quote ligatures ``/''/etc.
 * Markdown-style smart quotes usually classify from local flanking context:
 * whitespace, punctuation, and whether the quote can open or close.
 * csquotes acts when TeX sees an active quote token, with quote-level state
 * and limited output-level lookbehind for adjoining marks, but not source-text
 * lookbehind for orientation. Texlish can wait until after parsing, so it
 * combines flanking context with a stack of unmatched openers, letting later
 * close-looking quotes match earlier openers before falling back to literal
 * measurement marks or unmatched closers.
 */
function processSmartQuotes(root: AST[]): void
  for parent of iterateFlatArrays root
    opens: SmartQuote[] := []

    for each child, i of parent
      continue unless { type: "SmartQuote", quote } := child
      previousNode := parent[i-1]
      previous .= nodeText(previousNode).-1
      next .= nodeText(parent[i+1]).0
      // Braced content isolates from remaining source text,
      // so treat braces like start/end of line for flanking context.
      previous = "" if previous is "{"
      next = "" if next is "}"
      // Missing context counts as whitespace at line/array boundaries.
      previousIsWhitespace := not previous or previous is like /\s/u
      nextIsWhitespace := not next or next is like /\s/u
      // Punctuation and symbols can flank quotes without becoming word content.
      previousIsPunctuation := previous is like /[\p{Punctuation}\p{Symbol}]/u
      nextIsPunctuation := next is like /[\p{Punctuation}\p{Symbol}]/u

      function rewriteQuote(node: SmartQuote, output: string): void
        // Separate adjacent source quotes so TeX cannot combine their
        // rewritten fragments into a different quote ligature. For example,
        // `'"` would otherwise produce `'''`, which TeX reads as {''}{'}.
        if (previous is '"' or previous is "'") and previousNode is not like { token: /\{\}$/ }
          output = "{}" + output
        node.token = output

      canOpen .= true
      canClose .= true
      if nextIsWhitespace
        canOpen = false
      else if nextIsPunctuation
        canOpen = previousIsWhitespace or previousIsPunctuation
      if previousIsWhitespace
        canClose = false
      else if previousIsPunctuation
        canClose = nextIsWhitespace or nextIsPunctuation

      // Punctuation before word text is usually a closing context, e.g.
      // `$Q$'s` or `(test)"s`, but opener-like punctuation can introduce
      // quotes, e.g. `("hi")`, `x="hi"`, or Markdown emphasis `*"hi"*`.
      if next and not nextIsWhitespace and not nextIsPunctuation and
         previousIsPunctuation and previous is not '"' and previous is not "'" and
         previous is not like /^[([{<:=\/\\_*\-\u2013\u2014]$/u
        canOpen = false
        canClose = true

      // In "length is 1"", the first quote after 1 is an inch mark;
      // leave the second quote to close the quotation.
      continue if quote is '"' and next is '"' and /^\d$/u.test(previous ?? "")
      // Runs like f'' or h''' are probably prime marks, especially in math.
      continue if quote is "'" and (
        previous is "'" or (next is "'" and not previousIsWhitespace))

      if canOpen and canClose
        // Middle-of-word quotes are not quotation marks. Quotes in punctuation
        // runs can still open/close, following CommonMark-style flanking logic.
        canOpen = previousIsPunctuation
        canClose = nextIsPunctuation

      // Single quotes in word-like contexts are apostrophes/possessives.
      // Leave them literal instead of applying configured close quotes.
      continue unless canOpen or canClose

      if canClose
        // Prefer matching an earlier opener of the same quote character.
        // This lets `"the number is 1"` close normally despite ending in
        // a digit, while still leaving unmatched measurements like 5" literal.
        continue if for some j of [opens# >..0] when opens[j].quote is quote
          rewriteQuote child, child.close
          opens[j..] = []
          true
        // A quote after a digit is probably a foot/inch measurement mark
        // (unless we already matched it with an opener above).
        beforePrevious := nodeText(parent[i-2]).-1
        if previous is like /^\d$/u or (quote is previous and beforePrevious is like /^\d$/u)
          continue
        unless canOpen
          // No opener was waiting, but local context is close-only.
          rewriteQuote child, child.close
          continue

      if canOpen
        // If this quote can open and did not close above, rewrite it as open
        // now. For example, this handles incomplete input like `"unfinished`.
        rewriteQuote child, child.open
        // Add this opener to the stack so a later quote can close it.
        opens.push child

/**
 * Text used for smart-quote lookaround.
 * Empty string means no text, including from a child boundary.
 */
function nodeText(node: AST): string
  unless node?
    ""
  else if node <? "string"
    node.replace /\0/g, ""
  else if { type: "SmartQuote", quote } := node
    quote
  else if node is like { type: "Braced" }
    "{}"
  else if { token } := node
    // Delimiter can have both token and children
    return "" if "children" in node
    token.replace /\0/g, ""
  else
    ""

/** Process Markdown delimiters, based on CommonMark spec:
https://spec.commonmark.org/0.31.2/#emphasis-and-strong-emphasis
Deviations:
* We treat ***, ****, etc. as their own styles which can be defined.
  By contrast, CommonMark only defines * and ** and defines how they nest.
* If one of the delimiters is both left and right delimiting, CommonMark
  requires forbids the delimiters from having total size a multiple of 3.
  Instead, we forbid one delimiter from being exactly half the size of the
  other, which forbids the useless cases of either immediately closing and
  opening the same level of emphasis, or nesting two identical emphases.
*/
function processMarkdown(root: AST[]): void
  for parent of iterateFlatArrays root
    opens: Delimiter[] .= []
    for each child of parent
      continue unless child is like { type: "Delimiter" }
      // Prefer closing over opening, for Rule 15:
      // When two potential emphasis or strong emphasis spans overlap,
      // so that the second begins before the first ends and
      // ends after the first ends, the first takes precedence.
      if child.close and opens#
        close .= child.token!
        for i of [opens#>..0]
          function opener(delim: string): string
            (opens[i].styles[delim] ?? "") + '{'
          open .= opens[i].token!
          if close.startsWith open  // open finished
            // Open+close delimiter: Forbid double nested identical emphasis
            unless close is open+open and (opens[i].close or child.open)
              (opens[i].children ?= []).unshift opener open
              delete opens[i].token
              // Remove opens[i] and any following opens,
              // because they are now nested inside this open/close pair.
              opens.splice i, opens# - i
              (child.children ??= []).push '}'
              if close# > open#  // some close remains
                close = child.token = close[>= open#]
              else  // close finished too
                delete child.token
                break
          else if open.endsWith close  // close finished
            // Open+close delimiter: Forbid double nested identical emphasis
            unless open is close+close and (opens[i].close or child.open)
              (opens[i].children ?= []).unshift opener close
              opens[i].token = open[< -close#]
              (child.children ??= []).push '}'
              delete child.token
              break
        // Don't pursue open case if fully closed
        continue unless child.token?
      if child.open
        opens.push child
        child.openIndex = child.children# if child.children?
      else if child.token and child.children?  // remaining text after close
        child.children.push child.token
        delete child.token
    // Unmatched opens remain text
    for each open of opens
      if open.token and open.children?
        open.children.splice open.openIndex ?? 0, 0, open.token
        delete open.token

/** Expand Markdown footnotes, with named IDs global and numeric IDs local. */
function processFootnotes(root: AST[]): void
  // Collect footnote definitions and references in document order.
  events: (FootnoteDefinition | FootnoteRef)[] := []
  namedDefinitions: Map<string, FootnoteDefinition[]> := new Map
  for node of iterate root
    switch node
      { type: "FootnoteDefinition" }
        events.push node
        unless isNumeric node.id
          // Accumulate named definitions into array in case of duplicates
          definitions .= namedDefinitions.get node.id
          namedDefinitions.set node.id, definitions = [] unless definitions
          definitions.push node
      { type: "FootnoteRef" }
        events.push node

  // Rewrite each reference using its matched definition.
  usedNamed: Set<string> := new Set  // already written \footnote?
  pendingNumeric: Map<string, FootnoteRef[]> := new Map
  numericLabels .= 0
  for each node of events
    switch node.type
      when "FootnoteRef"
        if isNumeric node.id
          pending .= pendingNumeric.get node.id
          pendingNumeric.set node.id, pending = [] unless pending
          pending.push node
        else
          continue unless definitions := namedDefinitions.get node.id
          label := `footnote:${node.id}`
          if usedNamed.has node.id
            node.children = [`\\footref{${label}}`]
          else
            usedNamed.add node.id
            // Matched definitions are replaced by the expanded footnote.
            for definition of definitions
              definition.children = ["\0"]
            node.children = footnoteChildren definitions, node, label
      when "FootnoteDefinition"
        continue unless isNumeric node.id
        pending := pendingNumeric.get node.id
        continue unless pending?#
        // Numeric definitions are consumed by the pending refs they follow.
        node.children = ["\0"]
        label := `footnote:${++numericLabels}`
        for each ref, i of pending
          ref.children =
            if i is 0
              footnoteChildren [node], ref, label
            else
              [`\\footref{${label}}`]
        pending# = 0

  function footnoteChildren(definitions: FootnoteDefinition[], ref: FootnoteRef, label?: string): AST[]
    children: AST[] := ["%\n\\footnote{"]
    for each definition, i of definitions
      children.push "\n" if i > 0
      // Re-use the same label for duplicate names so LaTeX reports it.
      // Protect labels because \author stores \footnote via \thanks.
      children.push `\\protect\\label{${label}}` if label?
      children.push definition.body
    children.push "}"
    children.push "%\n" unless ref.eolNext
    children

function liftsToPreamble(node: AST): boolean
  node is like { type: "Preamble" }, { type: "Use" }, { type: "Uses" }

function isDefn(node: AST): boolean
  node is like { type: "Command", token: "\\defn" }, /\\defn(?![a-zA-Z@])/
function definesDefnCommand(root: AST[]): boolean
  for parent of iterateFlatArrays root
    for each child, let i of parent
      continue unless child is like { type: "Command" }
      continue unless child.token is like "\\newcommand", "\\renewcommand", "\\providecommand", "\\def"
      while parent[++i] is like /^\s*$/
      next := parent[i]
      return true if isDefn next
      if next is like { type: "Braced" }
        return true if find next.body, isDefn
  false

/** Attach environment names to \begin and \end commands */
function processBeginEnd(root: AST[]): void
  for parent of iterateFlatArrays root
    for each child, let i of parent
      if child is like { type: "Command" } and
         child.token is like "\\begin", "\\end"
        while parent[++i] is like /^\s*$/
        next := parent[i]
        switch next
          <? "string"
            if match := next.match /^\s*(.)/
              child.env = match[1]
          { type: "Braced" }
            //@ts-ignore deep type recursion
            body := next.body.flat Infinity
            if body[0] <? "string"
              child.env = body[0]

/** Automatic `\begin{document}`, `\end{document}`, `\maketitle` */
function processDocument(root: AST[]): void
  // Find any existing \begin{document}, \end{document}, \maketitle, \title,
  // \documentclass in the document, and put them in `document`.
  // Collect any ::preamble and ::use blocks for possibly moving to preamble.
  document: Record<string, AST> .= {}
  preamble: AST[][] .= []
  preambleDepth .= 0
  for {node: parent, post} of iteratePrePost root
    // Keep track of "preamble depth" so we don't add descendants too
    if liftsToPreamble parent
      if post
        preambleDepth--
      else
        preambleDepth++
    continue if post
    // We process array parents of actual content so we can find siblings
    continue unless Array.isArray parent
    for each child of parent
      if child is like { type: "Environment", env: "document" }
        document["\\begin"] = document["\\end"] = parent
      else if child is like { type: "Command" }
        switch child.token
          when "\\begin", "\\end"
            if child.env is "document"
              document[child.token] ?= parent
          when "\\maketitle", "\\title", "\\documentclass"
            document[child.token] ?= parent
      else if preambleDepth is 0 and liftsToPreamble child
        preamble.push parent

  // Add \end{document} as a final line if it doesn't exist
  unless document["\\end"]
    root.push "\n\\end{document}\n"

  // Add \begin{document} if it doesn't exist, before first environment,
  // header, unbraced text, etc.  Also add \maketitle if \title.
  unless document["\\begin"]
    var i = 0
    :line for line, var i of root
      switch line
        { type: "EOL" }
        { type: "FootnoteDefinition", children: ["\0"] }
        [ { type: "Indent" } ]
        [ { type: "Indent" }, "\0" ]  // ::styles
        [ { type: "Indent" }, { type: "Comment" } ]
        [ { type: "Indent" }, { type: "Use" } ],
        [ { type: "Indent" }, { type: "Uses" } ],
        [ { type: "Indent" }, { type: "Preamble" } ]
          i := preamble.indexOf line
          preamble.splice i, 1 if i >= 0
        [ { type: "Indent" }, { type: "Braced" } ]
        ^document["\\end"]  // \begin{document} before \end{document}
          break :line
        ^document["\\maketitle"]  // \begin{document} before \maketitle
          break :line
        [ { type: "Indent" }, { type: "Command" }, ... ]
        else
          break :line
    root.splice i, 0, document["\\begin"] = ["\n\\begin{document}\n"]
    if document["\\title"] and not document["\\maketitle"]
      document["\\begin"][0] += "\\maketitle\n"

  // Provide \defn command if used, e.g. from default Markdown emphasis `***`.
  // and not already obviously defined.
  if find(root, isDefn) and not definesDefnCommand root
    preamble.push [defaultDefnCommand]

  if preamble#
    copy :=
      for each line of preamble
        line[..], '\n'
    (document["\\begin"] as AST[]).splice 0, 0, ...copy
    for each line of preamble
      line.splice 0, line#, "\0"

  // Add \documentclass as first line if it doesn't exist
  unless document["\\documentclass"]
    root.unshift document["\\documentclass"] = defaultDocumentClass + "\n"
