import type { ActiveCompilerOptions, CompilerOptions, ScriptGrouping } from ./types.civet

export const defaultConfig: ActiveCompilerOptions = {
  markdownLinks: true
  scriptParens: true
  scriptGrouping: "numeric"
  styles:
    '*': '\\emph'
    '**': '\\textbf'
    '***': '\\defn'
    '@=': '\\label'
    '@': '\\ref'
    '@^': '\\ref'
    '@#': '\\pageref'
    '[[': '\\cite'
  set latexCompat(value: boolean)
    if value
      @scriptGrouping = "none"
    @scriptParens = not value
  set markdownCompat(value: boolean)
    @markdownLinks = value
}

/**
 * Build a complete compiler options object from already-parsed option values.
 * Applies defaults and clones/merges styles so callers can mutate the result.
 */
export function makeCompilerOptions(options: CompilerOptions = {}): ActiveCompilerOptions
  merged := Object.create defaultConfig
  Object.assign merged, options
  merged.styles = {
    ...defaultConfig.styles
    ...options.styles
  }
  merged

function normalizeWord(word: string): string
  word
  |> .trim()
  |> .toLowerCase()
  |> .replace /[-_\s]/g, ''

scriptGroupingValues := [
  "numeric"
  "alphanumeric"
  "alpha"
  "none"
] satisfies ScriptGrouping[]
scriptGroupingValueSet: Set<string> := new Set scriptGroupingValues

type ParsedCompilerOption
  | { key: "scriptGrouping", value: ScriptGrouping }
  | { key: BooleanCompilerOption, value: boolean }
  | { key: "styles", value: Record<string, string> }

type BooleanCompilerOption
  | "scriptParens"
  | "latexCompat"
  | "markdownCompat"
  | "markdownLinks"

booleanCompilerOptions := new Map<string, BooleanCompilerOption>
  . ["scriptparens", "scriptParens"]
  . ["latexcompat", "latexCompat"]
  . ["markdowncompat", "markdownCompat"]
  . ["markdownlinks", "markdownLinks"]

function setCompilerOption<K extends keyof CompilerOptions>(
  options: CompilerOptions
  option: { key: K, value: CompilerOptions[K] }
): void
  options[option.key] = option.value

function keyPath(key: string | string[]): string[]
  path := if key <? "string" then key.split('.') else key
  unless path#
    throw new Error "Config option key cannot be empty"
  for each segment of path
    unless segment <? "string" and segment.trim()#
      throw new Error "Config option key cannot contain empty path segments"
  path

function parseBoolean(key: string, value: ???): boolean
  return value if value is like true, false
  unless value <? "string"
    throw new Error `Config option ${key} must be a boolean, got ${typeof value}`
  switch normalizeWord value
    when "true", "1", "yes", "on"
      true
    when "false", "0", "no", "off"
      false
    else
      throw new Error `Invalid ${key} value: ${value}; expected true or false`

function parseString(key: string, value: ???): string
  unless value <? "string"
    throw new Error `Config option ${key} must be a string, got ${typeof value}`
  value

/**
 * Parse one already-tokenized config option key/value pair.
 * Checks that the option name is known, the path shape is valid, and the value
 * has the expected type/range; returns the canonical compiler option key.
 */
export function parseCompilerOption(key: string | string[], value: ???): ParsedCompilerOption
  path := keyPath key
  // `-key` shorthand for `key: false`
  if path[0].startsWith '-'
    unless path# is 1 and value is true
      throw new Error `Config shorthand ${path[0]} cannot have a value or nested path`
    path[0] = path[0][>=1]
    throw new Error "Config shorthand - cannot be empty" unless path[0]#
    value = false

  function rejectNestedOption(): void
    throw new Error `Unknown config option: ${path.join '.'}` if path# > 1
  option := normalizeWord path[0]
  if booleanKey := booleanCompilerOptions.get option
    rejectNestedOption()
    return
      key: booleanKey
      value: parseBoolean booleanKey, value
  switch option
    when "scriptgrouping"
      rejectNestedOption()
      stringValue := parseString "scriptGrouping", value
      unless scriptGroupingValueSet.has stringValue
        throw new Error `Invalid scriptGrouping value: ${stringValue}; expected ${scriptGroupingValues.join ', '}`
      key: "scriptGrouping"
      value: stringValue as ScriptGrouping
    when "styles"
      if path# < 2
        throw new Error `Config option ${path.join '.'} must include a style key`
      styleKey := path[>=1].join '.'
      stringValue := parseString `styles.${styleKey}`, value
      key: "styles"
      value: { [styleKey]: stringValue }
    else
      throw new Error `Unknown config option: ${path.join '.'}`

/**
 * Apply one already-tokenized config option key/value pair to an options object.
 * Performs the same validation as parseCompilerOption and mutates the target,
 * merging style entries into the existing style map.
 */
export function applyCompilerOption(options: CompilerOptions, key: string | string[], value: ???): void
  option := parseCompilerOption key, value
  if option.key is "styles"
    options.styles ?= {}
    for subkey, subvalue in option.value
      options.styles[subkey] = subvalue
  else
    setCompilerOption options, option

/**
 * Parse one raw CLI --config argument of the form key or key=value.
 * This only splits the string and treats a missing value as true; option names,
 * value types, and allowed values are checked later by applyCompilerOption.
 */
export function parseConfigAssignment(text: string): { key: string, value: string | boolean }
  match := /^\s*([^=\s]+)(?:\s*=\s*(.+?))?\s*$/.exec text
  unless match
    throw new Error `Expected key or key=value, got: ${text}`
  key .= match[1]
  value: string | boolean | undefined .= match[2]
  unless value?
    if key.startsWith '-'
      key = key[>=1]
      throw new Error "Config shorthand - cannot be empty" unless key#
      value = false
    else
      value = true
  { key, value }
