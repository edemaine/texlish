import type {
  ActiveCompilerOptions,
  CompilerOptions,
  PartialQuoteConfig,
  QuoteChar,
  QuoteConfig,
  QuoteRole,
  ScriptGrouping,
} from ./types.civet

export const defaultConfig: ActiveCompilerOptions = {
  colonCommands: true
  colonEnvironments: true
  citeShorthand: true
  markdownBackticks: 1
  markdownBlockquotes: true
  markdownEmphasis: true
  markdownFootnotes: true
  markdownHeadings: true
  markdownHorizontalRules: true
  markdownImages: true
  markdownLinks: true
  markdownLists: true
  markdownStrikethrough: true
  refShorthand: true
  smartQuotes: true
  scriptParens: true
  scriptGrouping: "numeric"
  quotes:
    '"':
      open: "``"
      close: "''"
    "'":
      open: "`"
      close: "'"
  styles:
    '>': 'quote'
    '`': '\\verb'
    '```*': 'verbatim'
    '*': '\\emph'
    '**': '\\textbf'
    '***': '\\defn'
    '~~': '\\sout'
    '!': '\\includegraphics'
    '---': '\\medskip\\hrule\\medskip'
    '@=': '\\label'
    '@': '\\ref'
    '@^': '\\ref'
    '@#': '\\pageref'
    '[[': '\\cite'
  set latexCompat(value: boolean)
    if value
      @scriptGrouping = "none"
      @smartQuotes = false
    @markdownStrikethrough = not value
    @scriptParens = not value
  set markdownCompat(value: boolean)
    @markdownBackticks = if value then 1 else 0
    @markdownBlockquotes = value
    @markdownEmphasis = value
    @markdownFootnotes = value
    @markdownHeadings = value
    @markdownHorizontalRules = value
    @markdownImages = value
    @markdownLinks = value
    @markdownLists = value
    @markdownStrikethrough = value
    @smartQuotes = value
}

/**
 * Build a complete compiler options object from already-parsed option values.
 * Applies defaults and clones/merges styles so callers can mutate the result.
 */
export function makeCompilerOptions(options: CompilerOptions = {}): ActiveCompilerOptions
  merged := Object.create defaultConfig
  Object.assign merged, options
  if options.markdownBackticks?
    merged.markdownBackticks = parseBacktickThreshold "markdownBackticks", options.markdownBackticks
  merged.quotes = mergeQuotes options.quotes
  merged.styles = {
    ...defaultConfig.styles
    ...options.styles
  }
  merged

function mergeQuotes(quotes?: PartialQuoteConfig): QuoteConfig
  {
    for each quote of quoteChars
      [quote]: {
        for each role of quoteRoles
          [role]: quoteOutput quotes?[quote]?[role] ?? defaultConfig.quotes[quote][role]
      }
  } as QuoteConfig

function quoteOutput(output: string): string
  output.replace /\\[A-Za-z@]+$/u, "$&{}"

function normalizeWord(word: string): string
  word
  |> .trim()
  |> .toLowerCase()
  |> .replace /[-_\s]/g, ''

scriptGroupingValues := [
  "numeric"
  "alphanumeric"
  "alpha"
  "none"
] satisfies ScriptGrouping[]
scriptGroupingValueSet: Set<string> := new Set scriptGroupingValues
quoteChars := ['"', "'"] satisfies QuoteChar[]
quoteRoles := ["open", "close"] satisfies QuoteRole[]

type ParsedCompilerOption
  | { key: "markdownBackticks", value: number }
  | { key: "quotes", value: PartialQuoteConfig }
  | { key: "scriptGrouping", value: ScriptGrouping }
  | { key: BooleanCompilerOption, value: boolean }
  | { key: "styles", value: Record<string, string> }

type BooleanCompilerOption
  | "colonCommands"
  | "colonEnvironments"
  | "citeShorthand"
  | "scriptParens"
  | "latexCompat"
  | "markdownCompat"
  | "markdownBlockquotes"
  | "markdownEmphasis"
  | "markdownFootnotes"
  | "markdownHeadings"
  | "markdownHorizontalRules"
  | "markdownImages"
  | "markdownLinks"
  | "markdownLists"
  | "markdownStrikethrough"
  | "refShorthand"
  | "smartQuotes"

booleanCompilerOptions := new Map<string, BooleanCompilerOption>
  . ["coloncommands", "colonCommands"]
  . ["colonenvironments", "colonEnvironments"]
  . ["citeshorthand", "citeShorthand"]
  . ["scriptparens", "scriptParens"]
  . ["latexcompat", "latexCompat"]
  . ["markdowncompat", "markdownCompat"]
  . ["markdownblockquotes", "markdownBlockquotes"]
  . ["markdownemphasis", "markdownEmphasis"]
  . ["markdownfootnotes", "markdownFootnotes"]
  . ["markdownheadings", "markdownHeadings"]
  . ["markdownhorizontalrules", "markdownHorizontalRules"]
  . ["markdownimages", "markdownImages"]
  . ["markdownlinks", "markdownLinks"]
  . ["markdownlists", "markdownLists"]
  . ["markdownstrikethrough", "markdownStrikethrough"]
  . ["refshorthand", "refShorthand"]
  . ["smartquotes", "smartQuotes"]

function setCompilerOption<K extends keyof CompilerOptions>(
  options: CompilerOptions
  option: { key: K, value: CompilerOptions[K] }
): void
  options[option.key] = option.value

function keyPath(key: string | string[]): string[]
  path := if key <? "string" then key.split('.') else key
  unless path#
    throw new Error "Config option key cannot be empty"
  for each segment of path
    unless segment <? "string" and segment.trim()#
      throw new Error "Config option key cannot contain empty path segments"
  path

function parseBoolean(key: string, value: ???): boolean
  return value if value is like true, false
  unless value <? "string"
    throw new Error `Config option ${key} must be a boolean, got ${typeof value}`
  switch normalizeWord value
    when "true", "1", "yes", "on"
      true
    when "false", "0", "no", "off"
      false
    else
      throw new Error `Invalid ${key} value: ${value}; expected true or false`

function parseString(key: string, value: ???): string
  unless value <? "string"
    throw new Error `Config option ${key} must be a string, got ${typeof value}`
  value

function isQuoteChar(value: string): value is QuoteChar
  value is '"' or value is "'"

function isQuoteRole(value: string): value is QuoteRole
  value is "open" or value is "close"

function parseQuoteOption(path: string[], value: ???): ParsedCompilerOption
  [, quote, role] := path
  unless path# is 3 and isQuoteChar(quote) and isQuoteRole(role)
    throw new Error `Unknown config option: ${path.join '.'}`
  stringValue := parseString `quotes.${quote}.${role}`, value
  return
    key: "quotes"
    value: { [quote]: { [role]: stringValue } }

export function parseBacktickThreshold(key: string, value: ???): number
  return 1 if value is true
  return 0 if value is false
  number := switch value
    <? "number"
      value
    /^\s*\d+\s*$/
      Number value.trim()
    /^\s*(?:true|yes|on)\s*$/i
      1
    /^\s*(?:false|no|off)\s*$/i
      0
    else
      throw new Error `Config option ${key} must be a nonnegative integer, got ${typeof value}`
  unless Number.isSafeInteger(number) and number >= 0
    throw new Error `Invalid ${key} value: ${value}; expected a nonnegative integer`
  number

/**
 * Parse one already-tokenized config option key/value pair.
 * Checks that the option name is known, the path shape is valid, and the value
 * has the expected type/range; returns the canonical compiler option key.
 */
export function parseCompilerOption(key: string | string[], value: ???): ParsedCompilerOption
  path := keyPath key
  // `-key` shorthand for `key: false`
  if path[0].startsWith '-'
    unless path# is 1 and value is true
      throw new Error `Config shorthand ${path[0]} cannot have a value or nested path`
    path[0] = path[0][>=1]
    throw new Error "Config shorthand - cannot be empty" unless path[0]#
    value = false

  function rejectNestedOption(): void
    throw new Error `Unknown config option: ${path.join '.'}` if path# > 1
  option := normalizeWord path[0]
  if booleanKey := booleanCompilerOptions.get option
    rejectNestedOption()
    return
      key: booleanKey
      value: parseBoolean booleanKey, value
  switch option
    when "markdownbackticks"
      rejectNestedOption()
      key: "markdownBackticks"
      value: parseBacktickThreshold "markdownBackticks", value
    when "scriptgrouping"
      rejectNestedOption()
      stringValue := parseString "scriptGrouping", value
      unless scriptGroupingValueSet.has stringValue
        throw new Error `Invalid scriptGrouping value: ${stringValue}; expected ${scriptGroupingValues.join ', '}`
      key: "scriptGrouping"
      value: stringValue as ScriptGrouping
    when "quotes"
      parseQuoteOption path, value
    when "styles"
      if path# < 2
        throw new Error `Config option ${path.join '.'} must include a style key`
      styleKey := path[>=1].join '.'
      stringValue := parseString `styles.${styleKey}`, value
      key: "styles"
      value: { [styleKey]: stringValue }
    else
      throw new Error `Unknown config option: ${path.join '.'}`

/**
 * Apply one already-tokenized config option key/value pair to an options object.
 * Performs the same validation as parseCompilerOption and mutates the target,
 * merging style entries into the existing style map.
 */
export function applyCompilerOption(options: CompilerOptions, key: string | string[], value: ???): void
  option := parseCompilerOption key, value
  if option.key is "styles"
    options.styles ?= {}
    for subkey, subvalue in option.value
      options.styles[subkey] = subvalue
  else if option.key is "quotes"
    options.quotes ?= {}
    for each quote of quoteChars
      continue unless quoteStyle := option.value[quote]
      options.quotes[quote] ?= {}
      for each role of quoteRoles
        if output := quoteStyle[role]
          options.quotes[quote][role] = quoteOutput output
  else
    setCompilerOption options, option

/**
 * Parse one raw CLI --config argument of the form key or key=value.
 * This only splits the string and treats a missing value as true; option names,
 * value types, and allowed values are checked later by applyCompilerOption.
 */
export function parseConfigAssignment(text: string): { key: string, value: string | boolean }
  match := /^\s*([^=\s]+)(?:\s*=\s*(.+?))?\s*$/.exec text
  unless match
    throw new Error `Expected key or key=value, got: ${text}`
  key .= match[1]
  value: string | boolean | undefined .= match[2]
  unless value?
    if key.startsWith '-'
      key = key[>=1]
      throw new Error "Config shorthand - cannot be empty" unless key#
      value = false
    else
      value = true
  { key, value }
