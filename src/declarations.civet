  "\\subincludefrom": directoryFilenamePattern
  "\\crefrange": firstLastPattern
  "\\crefrange*": firstLastPattern
  "\\Crefrange": firstLastPattern
  "\\Crefrange*": firstLastPattern
  "\\cpagerefrange": firstLastPattern
  "\\cpagerefrange*": firstLastPattern
  "\\Cpagerefrange": firstLastPattern
  "\\Cpagerefrange*": firstLastPattern
  "\\verb": delimitedTextPattern
  "\\verb*": delimitedTextPattern
  "\\Verb": optionsVerbatimTextPattern
  "\\Verb*": optionsVerbatimTextPattern
  "\\EscVerb": optionsRawTextPattern
  "\\EscVerb*": optionsRawTextPattern
  "\\lstinline": optionsVerbatimTextPattern
  "\\mintinline": optionsLanguageCodePattern
  "\\mintinline*": optionsLanguageCodePattern
  "\\mint": optionsLanguageCodePattern
  "\\mint*": optionsLanguageCodePattern

/**
 * Built-in environments and the modes of their body.
 * An absent or `inherit` value preserves the surrounding text or math mode.
 */
export builtinEnvironmentModes := new Map<string, ArgumentMode> Object.entries
  "math": "math"
  "displaymath": "math"
  "equation": "math"
  "equation*": "math"
  "alignat": "math"
  "alignat*": "math"
  "align": "math"
  "align*": "math"
  "gather": "math"
  "gather*": "math"
  "multline": "math"
  "multline*": "math"
  "flalign": "math"
  "flalign*": "math"
  "eqnarray": "math"
  "eqnarray*": "math"
  "verbatim": "verbatim"
  "verbatim*": "verbatim"
  "comment": "verbatim"
  "python": "verbatim"
  "Verbatim": "verbatim"
  "Verbatim*": "verbatim"
  "BVerbatim": "verbatim"
  "BVerbatim*": "verbatim"
  "LVerbatim": "verbatim"
  "LVerbatim*": "verbatim"
  "SaveVerbatim": "verbatim"
  "SaveVerbatim*": "verbatim"
  "VerbatimOut": "verbatim"
  "VerbatimOut*": "verbatim"
  "lstlisting": "verbatim"
  "minted": "verbatim"
  "filecontents": "verbatim"
  "filecontents*": "verbatim"

/** Core (`""`) and package-specific built-in declarations. */
export builtinPackageDeclarations := new Map<string, PackageDeclarations> Object.entries
  "": // built-in core LaTeX
    commands: builtinCommandPatterns
    environments: builtinEnvironmentModes
    preamble: ""
  "texlish:defn": // \defn as needed by default *** style
    preamble: "\\providecommand\\defn[1]{\\textbf{\\textit{\\boldmath #1}}}"
  ulem:
    commands: new Map Object.entries
      "\\uline": textPattern
      "\\sout": textPattern
    autoimportOptions: "normalem"
  amssymb:
    commands: new Map Object.entries
      "\\square": noArguments
      "\\boxtimes": noArguments

/** Preamble support automatically added for used commands and environments. */
export builtinAutoimports: Autoimports =
  commands: new Map<string, string> Object.entries
    "\\defn": "texlish:defn"
    "\\sout": "ulem"
    "\\square": "amssymb"
    "\\boxtimes": "amssymb"
  environments: new Map

/** Active package declarations with cached command/environment lookup. */
export class Declarations
  loadedPackages: PackageDeclarations[]
  loadedPackageNames: Set<string>
  commandCache: Map<string, CommandPattern?> = new Map
  environmentCache: Map<string, ArgumentMode?> = new Map

  constructor(
    @packages: Map<string, PackageDeclarations> = builtinPackageDeclarations
    @autoimports: Autoimports = builtinAutoimports
  )
    @loadedPackages = []
    @loadedPackageNames = new Set
    @loadPackage ""

  /** Activate a known package, with later packages taking precedence. */
  loadPackage(name: string): PackageDeclarations?
    return unless declarations := @packages.get name
    unless @loadedPackageNames.has name
      @loadedPackageNames.add name
      @loadedPackages.push declarations
      @commandCache.clear()
      @environmentCache.clear()
    declarations

  /** Find a command, autoimporting its package when necessary. */
  getCommand(name: string): CommandPattern?
    // `has` distinguishes a cached miss (`undefined`) from no cache entry.
    return @commandCache.get name if @commandCache.has name
    pattern .= @findCommand name
    unless pattern?
      if packageName? := @autoimports.commands?.get name
        if declarations := @loadPackage packageName
          pattern = declarations.commands?.get name
    @commandCache.set name, return = pattern

  /** Find an environment among the currently loaded declarations. */
  getEnvironment(name: string): ArgumentMode?
    // `has` distinguishes a cached miss (`undefined`) from no cache entry.
    return @environmentCache.get name if @environmentCache.has name
    mode .= @findEnvironment name
    unless mode?
      if packageName? := @autoimports.environments?.get name
        if declarations := @loadPackage packageName
          mode = declarations.environments?.get name
    @environmentCache.set name, return = mode

  hasCommand(name: string): boolean
    @getCommand(name)?

  hasEnvironment(name: string): boolean
    @getEnvironment(name)?

  findCommand(name: string): CommandPattern?
    for first i of [@loadedPackages#>..0]
      continue unless pattern := @loadedPackages[i].commands?.get name
      pattern

  findEnvironment(name: string): ArgumentMode?
    for first i of [@loadedPackages#>..0]
      continue unless mode := @loadedPackages[i].environments?.get name
      mode
