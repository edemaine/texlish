  "\\BVerbatimInput": optionsFilenamePattern
  "\\LVerbatimInput": optionsFilenamePattern
  "\\lstinputlisting": optionsFilenamePattern
  "\\cite": prenotePostnoteKeysPattern
  "\\citep": prenotePostnoteKeysPattern
  "\\citep*": prenotePostnoteKeysPattern
  "\\citet": prenotePostnoteKeysPattern
  "\\citet*": prenotePostnoteKeysPattern
  "\\Citep": prenotePostnoteKeysPattern
  "\\Citep*": prenotePostnoteKeysPattern
  "\\Citet": prenotePostnoteKeysPattern
  "\\Citet*": prenotePostnoteKeysPattern
  "\\citealt": prenotePostnoteKeysPattern
  "\\citealt*": prenotePostnoteKeysPattern
  "\\citealp": prenotePostnoteKeysPattern
  "\\citealp*": prenotePostnoteKeysPattern
  "\\Citealt": prenotePostnoteKeysPattern
  "\\Citealt*": prenotePostnoteKeysPattern
  "\\Citealp": prenotePostnoteKeysPattern
  "\\Citealp*": prenotePostnoteKeysPattern
  "\\citeauthor": prenotePostnoteKeysPattern
  "\\citeauthor*": prenotePostnoteKeysPattern
  "\\Citeauthor": prenotePostnoteKeysPattern
  "\\Citeauthor*": prenotePostnoteKeysPattern
  "\\citeyear": prenotePostnoteKeysPattern
  "\\citeyearpar": prenotePostnoteKeysPattern
  "\\parencite": prenotePostnoteKeysPattern
  "\\textcite": prenotePostnoteKeysPattern
  "\\autocite": prenotePostnoteKeysPattern
  "\\footcite": prenotePostnoteKeysPattern
  "\\supercite": prenotePostnoteKeysPattern
  "\\text": textPattern
  "\\textnormal": textPattern
  "\\textrm": textPattern
  "\\textsf": textPattern
  "\\texttt": textPattern
  "\\textbf": textPattern
  "\\textmd": textPattern
  "\\textit": textPattern
  "\\textsl": textPattern
  "\\textsc": textPattern
  "\\textup": textPattern
  "\\textsuperscript": textPattern
  "\\textsubscript": textPattern
  "\\href": optionsUrlTextPattern
  "\\hyperimage": urlTextPattern
  "\\hyperref": labelTextPattern
  "\\frac": numeratorDenominatorPattern
  // Standard Greek letter commands are variables with no arguments.
  "\\alpha": noArguments
  "\\beta": noArguments
  "\\gamma": noArguments
  "\\delta": noArguments
  "\\epsilon": noArguments
  "\\varepsilon": noArguments
  "\\zeta": noArguments
  "\\eta": noArguments
  "\\theta": noArguments
  "\\vartheta": noArguments
  "\\iota": noArguments
