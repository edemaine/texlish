  "\\nolinkurl": urlPattern
  "\\path": pathPattern
  "\\inputminted": optionsLanguageFilenamePattern
  "\\import": directoryFilenamePattern
  "\\subimport": directoryFilenamePattern
  "\\inputfrom": directoryFilenamePattern
  "\\subinputfrom": directoryFilenamePattern
