  "\\Cpagerefrange": firstLastPattern
  "\\Cpagerefrange*": firstLastPattern
  "\\verb": delimitedTextPattern
  "\\verb*": delimitedTextPattern
  "\\Verb": optionsVerbatimTextPattern
  "\\Verb*": optionsVerbatimTextPattern
  "\\EscVerb": optionsRawTextPattern
  "\\EscVerb*": optionsRawTextPattern
  "\\lstinline": optionsVerbatimTextPattern
  "\\mintinline": optionsLanguageCodePattern
  "\\mintinline*": optionsLanguageCodePattern
  "\\mint": optionsLanguageCodePattern
  "\\mint*": optionsLanguageCodePattern

/**
 * Built-in argument patterns and body modes.
 * Undeclared environments inherit the surrounding mode for both.
 */
export builtinEnvironments := new Map<string, EnvironmentDeclaration> Object.entries
  "math": { args: noArguments, body: "math" }
  "displaymath": { args: noArguments, body: "math" }
  "equation": { args: noArguments, body: "math" }
  "equation*": { args: noArguments, body: "math" }
  "alignat": { args: pairsPattern, body: "math" }
  "alignat*": { args: pairsPattern, body: "math" }
  "align": { args: noArguments, body: "math" }
  "align*": { args: noArguments, body: "math" }
  "gather": { args: noArguments, body: "math" }
  "gather*": { args: noArguments, body: "math" }
  "multline": { args: noArguments, body: "math" }
  "multline*": { args: noArguments, body: "math" }
  "flalign": { args: noArguments, body: "math" }
  "flalign*": { args: noArguments, body: "math" }
  "eqnarray": { args: noArguments, body: "math" }
  "eqnarray*": { args: noArguments, body: "math" }
  "verbatim": { args: noArguments, body: "verbatim" }
  "verbatim*": { args: noArguments, body: "verbatim" }
  "comment": { args: noArguments, body: "verbatim" }
  "python": { args: noArguments, body: "verbatim" }
  "Verbatim": { args: optionsPattern, body: "verbatim" }
  "Verbatim*": { args: optionsPattern, body: "verbatim" }
  "BVerbatim": { args: optionsPattern, body: "verbatim" }
  "BVerbatim*": { args: optionsPattern, body: "verbatim" }
  "LVerbatim": { args: optionsPattern, body: "verbatim" }
  "LVerbatim*": { args: optionsPattern, body: "verbatim" }
  "SaveVerbatim": { args: optionsNamePattern, body: "verbatim" }
  "SaveVerbatim*": { args: optionsNamePattern, body: "verbatim" }
  "VerbatimOut": { args: optionsFilenamePattern, body: "verbatim" }
  "VerbatimOut*": { args: optionsFilenamePattern, body: "verbatim" }
  "lstlisting": { args: optionsPattern, body: "verbatim" }
  "minted":
    args: [{ name: "options", ...rawOptional }, { name: "language", ...rawRequired }]
    body: "verbatim"
  "filecontents": { args: optionsFilenamePattern, body: "verbatim" }
  "filecontents*": { args: optionsFilenamePattern, body: "verbatim" }

  "itemize": { args: optionsPattern, body: "text" }
  // Accommodate enumitem options and Beamer's overlay/label options.
  "enumerate":
    args: [{ name: "options", ...rawOptional }, { name: "label", ...rawOptional }]
    body: "text"
  "description": { args: optionsPattern, body: "text" }
  "list":
    args: [{ name: "label", ...textRequired }, { name: "settings", ...textRequired }]
    body: "text"
  "tabular": { args: positionColumnsPattern, body: "text" }
  "tabular*":
    args: [
      { name: "width", ...rawRequired }
      ...positionColumnsPattern
    ]
    body: "text"
  "array": { args: positionColumnsPattern, body: "math" }

/** Core (`""`) and package-specific built-in declarations. */
builtinPackageDeclarations: PackageDeclarations[] :=
  . name: "" // built-in core LaTeX
    commands: builtinCommandPatterns
    environments: builtinEnvironments
    preamble: ""
  . name: "texlish:defn" // \defn as needed by default *** style
    preamble: "\\providecommand\\defn[1]{\\textbf{\\textit{\\boldmath #1}}}"
  . name: "ulem"
    commands: new Map Object.entries
      "\\uline": textPattern
      "\\sout": textPattern
    autoimportOptions: "normalem"
  . name: "amssymb"
    commands: new Map Object.entries
      "\\square": noArguments
      "\\boxtimes": noArguments

/** Built-in package declarations indexed by name */
export builtinPackages := new Map<string, PackageDeclarations>
for declarations of builtinPackageDeclarations
  builtinPackages.set declarations.name, declarations

/** Preamble support automatically added for used commands and environments. */
export builtinAutoimports: Autoimports =
  commands: new Map<string, string> Object.entries
    "\\defn": "texlish:defn"
    "\\sout": "ulem"
    "\\square": "amssymb"
    "\\boxtimes": "amssymb"
  environments: new Map

/** Active package declarations with cached command/environment lookup. */
export class Declarations
  loadedPackages: PackageDeclarations[]
  loadedPackageNames: Set<string>
  commandCache: Map<string, CommandResolution?> = new Map
  environmentCache: Map<string, EnvironmentDeclaration?> = new Map

  constructor(
    @packages: Map<string, PackageDeclarations> = builtinPackages
    @autoimports: Autoimports = builtinAutoimports
  )
    @loadedPackages = []
    @loadedPackageNames = new Set
    @loadPackage ""

  /** Activate a known package, with later packages taking precedence. */
  loadPackage(name: string): PackageDeclarations?
    return unless declarations := @packages.get name
    unless @loadedPackageNames.has name
      @loadedPackageNames.add name
      @loadedPackages.push declarations
      @commandCache.clear()
      @environmentCache.clear()
    declarations

  /** Find a command, autoimporting its package when necessary. */
  getCommand(name: string): CommandResolution?
    // `has` distinguishes a cached miss (`undefined`) from no cache entry.
    return @commandCache.get name if @commandCache.has name
    resolution .= @findCommand name
    unless resolution?
      if packageName? := @autoimports.commands?.get name
        if declarations := @loadPackage packageName
          if args := declarations.commands?.get name
            resolution = { args, package: declarations }
    @commandCache.set name, return = resolution

  /** Find an environment among the currently loaded declarations. */
  getEnvironment(name: string): EnvironmentDeclaration?
    // `has` distinguishes a cached miss (`undefined`) from no cache entry.
    return @environmentCache.get name if @environmentCache.has name
    declaration .= @findEnvironment name
    unless declaration?
      if packageName? := @autoimports.environments?.get name
        if declarations := @loadPackage packageName
          declaration = declarations.environments?.get name
    @environmentCache.set name, return = declaration

  hasCommand(name: string): boolean
    @getCommand(name)?

  hasEnvironment(name: string): boolean
    @getEnvironment(name)?

  findCommand(name: string): CommandResolution?
    for first i of [@loadedPackages#>..0]
      declarations := @loadedPackages[i]
      continue unless args := declarations.commands?.get name
      { args, package: declarations }

  findEnvironment(name: string): EnvironmentDeclaration?
    for first i of [@loadedPackages#>..0]
      continue unless declaration := @loadedPackages[i].environments?.get name
      declaration
