/**
 * How Texlish parses argument contents and environment bodies:
 * - `text` processes the argument as Texlish text
 * - `math` processes the argument as Texlish math
 * - `inherit` resolves to the surrounding text or math mode
 * - `raw` preserves raw TeX, where `%` starts a comment (like `::tex`)
 * - `verbatim` preserves every character literally, including `%`
 */
export type ArgumentMode = "text" | "math" | "raw" | "verbatim" | "inherit"

/** An argument mode after resolving `inherit` against its surrounding mode. */
export type ResolvedArgumentMode = Exclude<ArgumentMode, "inherit">

export function assertResolvedArgumentMode(mode: unknown): asserts mode is ResolvedArgumentMode
  unless mode is like "text", "math", "raw", "verbatim"
    throw new Error "Expected a resolved argument mode"

/** Namespace in which an argument introduces a definition */
export type DefinitionKind = "command" | "environment"

/**
 * The LaTeX delimiter(s) surrounding a command argument:
 * - `optional` uses square brackets: `[argument]`
 * - `required` uses paired braces: `{argument}`
 * - `delimited` uses the same non-whitespace character on both sides
 *   (like `\verb`)
 * - `required-or-delimited` accepts either paired braces or matching
 *   non-whitespace delimiters (like `\url`)
 */
export type ArgumentDelimiter =
  | "optional"
  | "required"
  | "delimited"
  | "required-or-delimited"

/** Fields shared by all declared command arguments */
interface ArgumentSpecBase
  name: string
  /** The argument's value defines a symbol in this namespace. */
  defines?: DefinitionKind

/** A paired command argument, whose contents can use any parsing mode */
interface PairedArgumentSpec extends ArgumentSpecBase
  delimiter: "optional" | "required"
  mode: ArgumentMode

/** An arbitrary-delimiter argument, whose contents must stay verbatim. */
interface DelimitedArgumentSpec extends ArgumentSpecBase
  delimiter: "delimited" | "required-or-delimited"
  mode: "verbatim"

/** The parsing specification for one named command argument. */
export type ArgumentSpec = PairedArgumentSpec | DelimitedArgumentSpec

/** Ordered argument specifications for a LaTeX command or environment. */
export type ArgumentsPattern = ArgumentSpec[]

/** Arguments and body are parsed independently for a LaTeX environment. */
export interface EnvironmentDeclaration
  args: ArgumentsPattern
  body: ArgumentMode

/** Declarations and autoimport behavior for a package. */
export interface PackageDeclarations
  /** Package name; empty string identifies core declarations */
  name: string
  /** Command declarations activated by loading this package. */
  commands?: Map<string, ArgumentsPattern>
  /** Environment declarations activated by loading this package. */
  environments?: Map<string, EnvironmentDeclaration>
  /** Default \usepackage options used when Texlish automatically loads this package. */
  autoimportOptions?: string
  /** Preamble text inserted instead of `\usepackage` when Texlish automatically loads this package. */
  preamble?: string

/** Commands and environments that automatically load declaration packages. */
export interface Autoimports
  /** "\\command" -> "packageName" */
  commands?: Map<string, string>
  /** "environment" -> "packageName" */
  environments?: Map<string, string>

/** The declaration and package selected by a command lookup */
export interface CommandResolution
  args: ArgumentsPattern
  package: PackageDeclarations

/**
 * Compact parse-cache key; argument names do not affect parsing.
 *
 * A generic repeated mode starts with `*`, followed by its mode code.
 * A finite pattern concatenates one delimiter code and one mode code per
 * argument:
 * - delimiter: `o` optional, `r` required, `d` delimited,
 *   `b` both required or delimited
 * - mode: `t` text, `m` math, `i` inherit, `r` raw, `v` verbatim
 *
 * Codes must remain unique within each position; the same character can be
 * used in both positions, as `r` is for required delimiters and raw mode.
 */
export function argumentPatternKey(
  pattern: ArgumentsPattern | ResolvedArgumentMode
): string
  return "*" + pattern[0] if pattern <? "string"
  for join each {delimiter, mode} of pattern
    if delimiter is "required-or-delimited"
      "b"
    else
      delimiter[0]
    + mode[0]

// Reusable parsing behavior for the named built-in arguments below.
rawRequired := { delimiter: "required", mode: "raw" } as const
rawOptional := { delimiter: "optional", mode: "raw" } as const
verbatimRequired := { delimiter: "required", mode: "verbatim" } as const
verbatimDelimited := { delimiter: "delimited", mode: "verbatim" } as const
verbatimRequiredOrDelimited :=
  { delimiter: "required-or-delimited", mode: "verbatim" } as const
textOptional := { delimiter: "optional", mode: "text" } as const
textRequired := { delimiter: "required", mode: "text" } as const
mathRequired := { delimiter: "required", mode: "math" } as const
inheritRequired := { delimiter: "required", mode: "inherit" } as const

// Shared patterns group commands/environments with the same argument meanings.
noArguments: ArgumentsPattern := []
optionsPattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
optionsNamePattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
  . { name: "name", ...rawRequired }
pairsPattern: ArgumentsPattern :=
  . { name: "pairs", ...rawRequired }
positionColumnsPattern: ArgumentsPattern :=
  . { name: "position", ...textOptional }
  . { name: "columns", ...rawRequired }
environmentPattern: ArgumentsPattern :=
  . { name: "environment", ...rawRequired }
filenamePattern: ArgumentsPattern :=
  . { name: "filename", ...rawRequired }
filenamesPattern: ArgumentsPattern :=
  . { name: "filenames", ...rawRequired }
stylePattern: ArgumentsPattern :=
  . { name: "style", ...rawRequired }
directoriesPattern: ArgumentsPattern :=
  . { name: "directories", ...rawRequired }
labelPattern: ArgumentsPattern :=
  . { name: "label", ...rawRequired }
keysPattern: ArgumentsPattern :=
  . { name: "keys", ...rawRequired }
textPattern: ArgumentsPattern :=
  . { name: "text", ...textRequired }
numeratorDenominatorPattern: ArgumentsPattern :=
  . { name: "numerator", ...mathRequired }
  . { name: "denominator", ...mathRequired }
inheritedContentPattern: ArgumentsPattern :=
  . { name: "content", ...inheritRequired }
optionsFilenamePattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
  . { name: "filename", ...rawRequired }
prenotePostnoteKeysPattern: ArgumentsPattern :=
  . { name: "prenote", ...textOptional }
  . { name: "postnote", ...textOptional }
  . { name: "keys", ...rawRequired }
optionsUrlTextPattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
  . { name: "url", ...verbatimRequired }
  . { name: "text", ...textRequired }
urlTextPattern: ArgumentsPattern :=
  . { name: "url", ...verbatimRequired }
  . { name: "text", ...textRequired }
labelTextPattern: ArgumentsPattern :=
  . { name: "label", ...rawOptional }
  . { name: "text", ...textRequired }
targetTextPattern: ArgumentsPattern :=
  . { name: "target", ...rawRequired }
  . { name: "text", ...textRequired }
urlPattern: ArgumentsPattern :=
  . { name: "url", ...verbatimRequiredOrDelimited }
pathPattern: ArgumentsPattern :=
  . { name: "path", ...verbatimRequiredOrDelimited }
bracedUrlPattern: ArgumentsPattern :=
  . { name: "url", ...verbatimRequired }
optionsLanguageFilenamePattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
  . { name: "language", ...rawRequired }
  . { name: "filename", ...rawRequired }
directoryFilenamePattern: ArgumentsPattern :=
  . { name: "directory", ...rawRequired }
  . { name: "filename", ...rawRequired }
firstLastPattern: ArgumentsPattern :=
  . { name: "first", ...rawRequired }
  . { name: "last", ...rawRequired }
delimitedTextPattern: ArgumentsPattern :=
  . { name: "text", ...verbatimDelimited }
optionsVerbatimTextPattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
  . { name: "text", ...verbatimRequiredOrDelimited }
optionsRawTextPattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
  . { name: "text", ...rawRequired }
optionsLanguageCodePattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
  . { name: "language", ...rawRequired }
  . { name: "code", ...verbatimRequiredOrDelimited }
packagesPattern: ArgumentsPattern :=
  . { name: "options", ...rawOptional }
  . { name: "packages", ...rawRequired }
commandDefinitionPattern: ArgumentsPattern :=
  . { name: "command", ...rawRequired, defines: "command" }
latexCommandDefinitionPattern: ArgumentsPattern :=
  . { name: "command", ...rawRequired, defines: "command" }
  . { name: "arguments", ...rawOptional }
  . { name: "default", ...textOptional }
  . { name: "definition", ...textRequired }
latexEnvironmentDefinitionPattern: ArgumentsPattern :=
  . { name: "environment", ...rawRequired, defines: "environment" }
  . { name: "arguments", ...rawOptional }
  . { name: "default", ...textOptional }
  . { name: "begin", ...textRequired }
  . { name: "end", ...textRequired }
documentCommandDefinitionPattern: ArgumentsPattern :=
  . { name: "command", ...rawRequired, defines: "command" }
  . { name: "arguments", ...rawRequired }
  . { name: "definition", ...textRequired }
documentEnvironmentDefinitionPattern: ArgumentsPattern :=
  . { name: "environment", ...rawRequired, defines: "environment" }
  . { name: "arguments", ...rawRequired }
  . { name: "begin", ...textRequired }
  . { name: "end", ...textRequired }
theoremDefinitionPattern: ArgumentsPattern :=
  . { name: "environment", ...rawRequired, defines: "environment" }
  . { name: "counter", ...rawOptional }
  . { name: "caption", ...textRequired }
  . { name: "within", ...rawOptional }

/** Built-in command declarations. */
export builtinCommandPatterns := new Map<string, ArgumentsPattern> Object.entries
  "\\begin": environmentPattern
  "\\end": environmentPattern
  "\\usepackage": packagesPattern
  "\\RequirePackage": packagesPattern
  "\\def": commandDefinitionPattern
  "\\gdef": commandDefinitionPattern
  "\\edef": commandDefinitionPattern
  "\\xdef": commandDefinitionPattern
  "\\newcommand": latexCommandDefinitionPattern
  "\\newcommand*": latexCommandDefinitionPattern
  "\\renewcommand": latexCommandDefinitionPattern
  "\\renewcommand*": latexCommandDefinitionPattern
  "\\providecommand": latexCommandDefinitionPattern
  "\\providecommand*": latexCommandDefinitionPattern
  "\\newenvironment": latexEnvironmentDefinitionPattern
  "\\newenvironment*": latexEnvironmentDefinitionPattern
  "\\renewenvironment": latexEnvironmentDefinitionPattern
  "\\renewenvironment*": latexEnvironmentDefinitionPattern
  "\\provideenvironment": latexEnvironmentDefinitionPattern
  "\\provideenvironment*": latexEnvironmentDefinitionPattern
  "\\NewDocumentCommand": documentCommandDefinitionPattern
  "\\RenewDocumentCommand": documentCommandDefinitionPattern
  "\\ProvideDocumentCommand": documentCommandDefinitionPattern
  "\\DeclareDocumentCommand": documentCommandDefinitionPattern
  "\\NewDocumentEnvironment": documentEnvironmentDefinitionPattern
  "\\RenewDocumentEnvironment": documentEnvironmentDefinitionPattern
  "\\ProvideDocumentEnvironment": documentEnvironmentDefinitionPattern
  "\\DeclareDocumentEnvironment": documentEnvironmentDefinitionPattern
  "\\newtheorem": theoremDefinitionPattern
  "\\newtheorem*": theoremDefinitionPattern
  "\\include": filenamePattern
  "\\input": filenamePattern
  "\\verbatiminput": filenamePattern
  "\\bibliography": filenamesPattern
  "\\bibliographystyle": stylePattern
  "\\includeonly": filenamesPattern
  "\\graphicspath": directoriesPattern
  "\\label": labelPattern
  "\\ref": labelPattern
  "\\ref*": labelPattern
  "\\pageref": labelPattern
  "\\pageref*": labelPattern
  "\\eqref": labelPattern
  "\\autoref": labelPattern
  "\\autoref*": labelPattern
  "\\autopageref": labelPattern
  "\\autopageref*": labelPattern
  "\\nameref": labelPattern
  "\\nameref*": labelPattern
  "\\vref": labelPattern
  "\\Vref": labelPattern
  "\\cref": labelPattern
  "\\cref*": labelPattern
  "\\Cref": labelPattern
  "\\Cref*": labelPattern
  "\\cpageref": labelPattern
  "\\cpageref*": labelPattern
  "\\Cpageref": labelPattern
  "\\Cpageref*": labelPattern
  "\\labelcref": labelPattern
  "\\labelcref*": labelPattern
  "\\labelcpageref": labelPattern
  "\\labelcpageref*": labelPattern
  "\\namecref": labelPattern
  "\\nameCref": labelPattern
  "\\lcnamecref": labelPattern
  "\\namecrefs": labelPattern
  "\\nameCrefs": labelPattern
  "\\lcnamecrefs": labelPattern
  "\\nocite": keysPattern
  "\\includegraphics": optionsFilenamePattern
  "\\includegraphics*": optionsFilenamePattern
  "\\addbibresource": optionsFilenamePattern
  "\\VerbatimInput": optionsFilenamePattern
  "\\BVerbatimInput": optionsFilenamePattern
  "\\LVerbatimInput": optionsFilenamePattern
  "\\lstinputlisting": optionsFilenamePattern
  "\\cite": prenotePostnoteKeysPattern
  "\\citep": prenotePostnoteKeysPattern
  "\\citep*": prenotePostnoteKeysPattern
  "\\citet": prenotePostnoteKeysPattern
  "\\citet*": prenotePostnoteKeysPattern
  "\\Citep": prenotePostnoteKeysPattern
  "\\Citep*": prenotePostnoteKeysPattern
  "\\Citet": prenotePostnoteKeysPattern
  "\\Citet*": prenotePostnoteKeysPattern
  "\\citealt": prenotePostnoteKeysPattern
  "\\citealt*": prenotePostnoteKeysPattern
  "\\citealp": prenotePostnoteKeysPattern
  "\\citealp*": prenotePostnoteKeysPattern
  "\\Citealt": prenotePostnoteKeysPattern
  "\\Citealt*": prenotePostnoteKeysPattern
  "\\Citealp": prenotePostnoteKeysPattern
  "\\Citealp*": prenotePostnoteKeysPattern
  "\\citeauthor": prenotePostnoteKeysPattern
  "\\citeauthor*": prenotePostnoteKeysPattern
  "\\Citeauthor": prenotePostnoteKeysPattern
  "\\Citeauthor*": prenotePostnoteKeysPattern
  "\\citeyear": prenotePostnoteKeysPattern
  "\\citeyearpar": prenotePostnoteKeysPattern
  "\\parencite": prenotePostnoteKeysPattern
  "\\textcite": prenotePostnoteKeysPattern
  "\\autocite": prenotePostnoteKeysPattern
  "\\footcite": prenotePostnoteKeysPattern
  "\\supercite": prenotePostnoteKeysPattern
  "\\text": textPattern
  "\\textnormal": textPattern
  "\\textrm": textPattern
  "\\textsf": textPattern
  "\\texttt": textPattern
  "\\textbf": textPattern
  "\\textmd": textPattern
