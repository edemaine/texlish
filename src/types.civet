export type ScriptGrouping = "numeric" | "alphanumeric" | "alpha" | "none"
export type QuoteChar = '"' | "'"
export type QuoteRole = "open" | "close"
export type QuoteStyle = Record QuoteRole, string
export type QuoteConfig = Record QuoteChar, QuoteStyle
export type PartialQuoteConfig = Partial Record QuoteChar, Partial QuoteStyle

type { ArgumentDelimiter, ArgumentsPattern } from ./declarations.civet

export type CompilerOptions
  filename?: string
  ast?: boolean
  trace?: string
  fragment?: boolean
  scriptGrouping?: ScriptGrouping
  scriptParens?: boolean
  colonCommands?: boolean
  colonEnvironments?: boolean
  citeShorthand?: boolean
  latexCompat?: boolean
  markdownCompat?: boolean
  markdownBackticks?: number | boolean
  markdownBlockquotes?: boolean
  markdownChecklists?: boolean
  markdownEmphasis?: boolean
  markdownFootnotes?: boolean
  markdownHeadings?: boolean
  markdownHorizontalRules?: boolean
  markdownImages?: boolean
  markdownLinks?: boolean
  markdownLists?: boolean
  markdownStrikethrough?: boolean
  refShorthand?: boolean
  smartQuotes?: boolean
  quotes?: PartialQuoteConfig
  styles?: Record<string, string>

export type ActiveCompilerOptions = Omit<CompilerOptions, "markdownBackticks" | "quotes" | "styles"> & {
  markdownBackticks: number
  quotes: QuoteConfig
  styles: Record<string, string>
}

export type ConfigValue = string | number | boolean
export type ConfigEntry = [string[], ConfigValue]

export type AST =
  | undefined
  | string
  | ASTObject

/** AST content with identity, suitable for aliases shared with children */
export type ASTObject =
  | ASTParent
  | ASTToken
  | AST[]
  | ASTNode

export interface ASTParent
  children: AST[]

/** Shared structure for semantic nodes with an emitted TeX style */
export interface Styled extends ASTParent
  style: string

export interface ASTToken
  token: string
  $loc?: Loc
type Loc = ???

export type ASTNode
  | Argument
  | BlockQuote
  | Enclosed
  | Call
  | Checklist
  | Citation
  | CodeBlock
  | CodeSpan
  | Command
  | Comment
  | Delimiter
  | Environment
  | EOL
  | FootnoteDefinition
  | FootnoteRef
  | Heading
  | HorizontalRule
  | Image
  | Indent
  | List
  | ListItem
  | Preamble
  | Raw
  | Ref
  | SmartQuote
  | Tex
  | Use
  | Uses
  | Verbatim

/**
 * Physical syntax used for a parsed command argument:
 * - `bracketed`: a LaTeX optional argument, `[argument]`
 * - `parenthesized`: a parenthesized argument, `(argument)`
 * - `braced`: a LaTeX required argument, `{argument}`
 * - `unbraced`: a single control sequence `\command` as a required argument
 * - `delimited`: matching arbitrary delimiters, as in `\verb|argument|`
 * - `colon`: the argument directly introduced by `\command: argument`
 * - `bullet`: an item in an indented command-argument list
 * - `final`: an unbulleted final required argument after such a list
 */
export type ArgumentForm =
  | "bracketed"
  | "parenthesized"
  | "braced"
  | "unbraced"
  | "delimited"
  | "colon"
  | "bullet"
  | "final"

/** One parsed command or environment argument */
export interface Argument extends ASTParent
  type: "Argument"
  /** Index in the declared pattern; undefined for generic or extra arguments */
  specIndex?: number?
  /** How this occurrence was physically expressed */
  form: ArgumentForm
  /** The argument delimiter, independent of shorthand syntax */
  delimiter: ArgumentDelimiter
  /** Argument content, aliased within `children` */
  body: ASTObject

export interface BlockQuote extends ASTParent
  type: "BlockQuote"
  /** Environment selected by the blockquote style */
  env: string

/** Content enclosed in braces, brackets, parentheses, or matching delimiters. */
export interface Enclosed extends ASTParent
  type: "Enclosed"
  open: string
  body: ASTObject
  close: string

/** A recognized call to a declared command */
export interface Call extends ASTParent
  type: "Call"
  command: Command
  /** Argument declaration selected when this call was parsed */
  argsSpec: ArgumentsPattern
  /** Package whose declaration supplied `argsSpec`; empty string means core */
  package: string
  /** Parsed arguments, aliased as the second entry of `children` */
  args: Argument[]
  /** Whether all remaining declared arguments are optional */
  complete: boolean

/** Checklist marker whose style supplies the optional LaTeX label for `\item` */
export interface Checklist extends Styled
  type: "Checklist"

export interface Citation extends Styled
  type: "Citation"
  /** Citation keys, with surrounding whitespace removed */
  keys: string[]

export interface CodeBlock extends Styled
  type: "CodeBlock"
  env: string
  /** Trimmed opening-fence info string */
  info: string
  /** Literal content after fence indentation removal; aliased in children */
  body: Verbatim

export interface CodeSpan extends Styled
  type: "CodeSpan"
  /** Matching output delimiter; omitted when the body uses braces */
  delimiter?: string
  /** Literal content after code-span whitespace normalization; aliased in children */
  body: Verbatim

export interface Command extends ASTToken
  type: "Command"

export interface Comment extends ASTToken
  type: "Comment"
  /** Generated by parser to suppress whitespace; not present in source. */
  implicit?: boolean

export interface Delimiter
  type: "Delimiter"
  open: boolean
  close: boolean
  styles: Record<string, string>
  /** Original delimiter symbol, such as `*`, `**`, or `~~`. */
  symbol: string
  /** Remaining literal delimiter text while unmatched or partially matched. */
  token?: string
  /** Generated content once any part of the delimiter has been matched. */
  children?: AST[]
  /**
   * Index into children where the delimiter started acting as an opener,
   * when some children were already generated while closing another span.
   */
  openIndex?: number
  /** Style selected when this delimiter successfully opens a span. */
  style?: string

export interface Environment extends ASTParent
  type: "Environment"
  env: string

export interface EOL extends ASTToken
  type: "EOL"

export interface FootnoteDefinition extends ASTParent
  type: "FootnoteDefinition"
  id: string
  body: AST[]

export interface FootnoteRef extends ASTParent
  type: "FootnoteRef"
  id: string
  /** Is the footnote reference followed by an end-of-line? */
  eolNext: boolean

export interface Heading extends ASTParent
  type: "Heading"
  /**
   * "\part", "\chapter", "\section", "\subsection", "\subsubsection",
   * "\paragraph", "\subparagraph", and starred versions "\part*" etc.
   */
  subtype: string

export interface HorizontalRule extends Styled
  type: "HorizontalRule"
  /** Source marker used to select the configured style */
  marker: string

export interface Image extends Styled
  type: "Image"
  url: string
  /** Parsed alternative text, aliased within children when emitted */
  alt: ASTObject

export interface Indent extends ASTToken
  type: "Indent"
  level: number

export interface List extends ASTParent
  type: "List"
  /** List environment, e.g. "itemize" or "enumerate" */
  env: string
  /** First source number for bare ordered lists; absent for explicit directives. */
  start?: number
  /** Environment arguments, aliased within children. */
  args: AST[]
  /** List items, aliased within children. */
  items: AST[]

export interface ListItem extends ASTParent
  type: "ListItem"
  /** Source number for ordered items; absent for unordered items. */
  number?: number

export interface Preamble extends ASTParent
  type: "Preamble"
  textBody: AST[]

/**
 * TeX source preserved without representing its internal structure in the AST.
 * Raw argument and environment modes produce these nodes. TeX commands and
 * comments retain their meaning and may be analyzed with the appropriate context.
 * Texlish transformations must leave the source unchanged.
 */
export interface Raw extends ASTToken
  type: "Raw"

export interface Ref extends Styled
  type: "Ref"
  /** Shorthand variant: `@`, `@=`, `@#`, or `@^` */
  variant: string
  /** Emitted reference label, including any implicit namespace prefix */
  target: string

export interface SmartQuote extends ASTToken
  type: "SmartQuote"
  /** Original source quote; token is rewritten to the configured output. */
  quote: QuoteChar
  /** Configured replacement if the quote is opening. */
  open: string
  /** Configured replacement if the quote is closing. */
  close: string

export interface Tex extends ASTParent
  type: "Tex"

export interface Use extends ASTParent
  type: "Use"
  packages: string[]

export interface Uses extends ASTParent
  type: "Uses"

/**
 * Literal content from verbatim argument and environment modes.
 * Apparent TeX commands and comments are literal text, not TeX to analyze.
 * Preserve the content unchanged without command discovery or comment stripping.
 */
export interface Verbatim extends ASTToken
  type: "Verbatim"
