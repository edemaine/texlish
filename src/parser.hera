} from ./types.civet
{
  applyCompilerOption,
  makeCompilerOptions,
} from ./config.civet
{
  type ArgumentDelimiter
  type ArgumentMode
  type ArgumentSpec
  type ArgumentsPattern
  type ResolvedArgumentMode
  assertResolvedArgumentMode
  Declarations
  argumentPatternKey
} from ./declarations.civet
{ assertTexlishVersion } from ./version.civet
{
  commentForBody,
  commentForTextBody,
  getEndComment,
  getLeadingIndent,
  isEmpty,
  isNumeric,
  reduceVisualIndent,
  removeLeadingIndent,
  visualWidth,
} from ./util.civet

type ParserState
  /** Stack of active indentation baselines for nested blocks. */
  indents: Indent[]
  /** Current block indentation baseline = top of `indents` stack. */
  currentIndent: Indent
  /** Indentation most recently parsed or temporarily installed for this line. */
  thisLineIndent: Indent
  /** Stack for restoring `thisLineIndent` after temporary parser-state changes. */
  savedLineIndents: Indent[]
  /** Synthetic baseline immediately after the current list item marker. */
  listItemIndent: Indent
  /** One-shot override consumed by the next Indent parse. */
  pendingLineIndent: Indent?
  /** Opening delimiter/fence for the code span/block currently being parsed. */
  codeMarker: string?
  /** Active compiler options, including options changed by ::config. */
  compilerOptions: ActiveCompilerOptions
  /** Active declared command and environment declarations. */
  declarations: Declarations
  /** Stack of finite command patterns or repeated generic colon-argument modes. */
  argumentPatterns: ActiveArgumentPattern[]

/**
 * A finite declared command pattern or a repeating generic argument mode.
 * Mode strings allow unlimited colon arguments for undeclared commands and
 * environments; unlike command patterns, they do not advance an argument index.
 */
type ActiveArgumentPattern = ActiveCommandPattern | ResolvedArgumentMode

type ActiveCommandPattern
  args: ArgumentsPattern
  index: number
  parentMode: ResolvedArgumentMode

initialIndent: Indent := { type: "Indent", token: '', level: 0 }

export state: ParserState := {
  indents: [ initialIndent ]
  get currentIndent(): Indent
    state.indents.-1
  thisLineIndent: initialIndent
  savedLineIndents: []
  listItemIndent: initialIndent
  pendingLineIndent: undefined
  codeMarker: undefined
  compilerOptions: makeCompilerOptions()
  declarations: new Declarations
  argumentPatterns: []
}

export function getCompilerOptions(): ActiveCompilerOptions
  state.compilerOptions

export function setCompilerOptions(options: ActiveCompilerOptions): void
  state.compilerOptions = options

export function getDeclarations(): Declarations
  state.declarations

export function getStateKey(): string
  state.currentIndent.level +
  for join each pattern of state.argumentPatterns
    if pattern <? "string"
      "/" + argumentPatternKey pattern
    else
      "/" + argumentPatternKey(pattern.args[>=pattern.index]) +
      ":" + pattern.parentMode

/**
 * Prefix generated labels for shorthand references with special namespaces.
 * Returns undefined to reject shorthand meaning it should be left alone.
 */
function labelPrefix(style: string, label: string): string?
  if style is '@^'
    return if isNumeric label
    return 'footnote:'
  ''

function setListItemIndent(marker: string): void
  state.listItemIndent = {
    ...state.thisLineIndent
    token: state.thisLineIndent.token + marker.replace /[^\t]/g, " "
    level: state.thisLineIndent.level + visualWidth marker
  }

export { ParseError }
```

## DOCUMENT

Main ::AST[]
  Init Content -> $2

Init
  "" ->
    state.indents = [ initialIndent ]
    state.thisLineIndent = initialIndent
    state.savedLineIndents = []
    state.listItemIndent = initialIndent
    state.pendingLineIndent = undefined
    state.codeMarker = undefined
    state.declarations = new Declarations
    state.argumentPatterns = []

Content ::AST[]
  Statement ( EOL Statement )* ->
    return [ $1, ...$2.flat() ]
  "" -> []

# First line starts mid-line, so uses Text; following lines assume start of line
# No Nested requirement; used in TextBracedContent where indentation doesn't matter
TextAndContent ::AST[]
  Text:first ( EOL Statement )*:rest -> [ first, ...rest.flat() ]
  "" -> []

Space ::string
  /[ \t]*/

ActualSpace ::string
  /[ \t]+/

EOL ::EOL
  /[ \t]*(\n|\r\n?|$)/ ->
    return {
      type: "EOL",
      token: $0,
      $loc,
    }

ActualEOL ::EOL
  EOL:eol ->
    return $skip unless eol.token.endsWith("\n") or eol.token.endsWith("\r")
    eol

Statement ::AST
  TextStatement
  TextLine

TextStatement ::AST
  TextOrMathStatement
  TextCommandWithColonArguments
  ColonEnvironmentsEnabled TextEnvironment -> $2
  MarkdownHeadingsEnabled Heading -> $2
  MarkdownBackticksEnabled CodeBlock -> $2
  MarkdownBlockquotesEnabled BlockQuote -> $2
  MarkdownHorizontalRulesEnabled HorizontalRule -> $2
  MarkdownFootnotesEnabled FootnoteDefinition -> $2
  MarkdownListsEnabled UnorderedList -> $2
  MarkdownListsEnabled OrderedList -> $2
  ListDirective

# Statement forms valid in both text and math mode.
TextOrMathStatement ::AST
  MetaBlock

# Detect whether the next line is a text-mode statement, for deciding whether
# to continue a text field like a Markdown bracketed link.
IsTextStatement
  PushLineIndent (&TextStatement)?:statement PopLineIndent ->
    return $skip unless statement

## TEXT

# Text starting at the beginning of a line.
# Can be empty. Nested constructs may span lines, but the final newline is not consumed.
TextLine ::AST[]
  Indent Text ->
    return [ $1, ...$2 ]

# Text starting in the middle of a line, for inline uses.
# Can be empty. Nested constructs may span lines, but the final newline is not consumed.
Text ::AST[]
  TextPart*

# TextPart treats parens/brackets as literal; BracketTextPart balances nested
# brackets for Markdown link text.
TextPart ::AST
  TextOrMathPart
  TextOnlyPart
  [()\[\]]

EnterMathMode ::AST[]
  "$$" MathContent "$$"
  "$" MathContent "$"
  "\\(" MathContent "\\)"
  "\\[" MathContent "\\]"

# Rules for TextPart that apply only in text mode.
TextOnlyPart ::AST
  # Recognize math delimiters before command and literal-text fallbacks.
  EnterMathMode
  !EndTextEnvironment TextCommandWithArguments -> $2
  TextBracedContent
  MarkdownFootnotesEnabled FootnoteRef -> $2
  MarkdownBackticksEnabled CodeSpan -> $2
  RefShorthandEnabled RefShorthand -> $2
  CiteShorthandEnabled CiteShorthand -> $2
  MarkdownImagesEnabled MarkdownImage -> $2
  MarkdownLinksEnabled ( Autolink / MarkdownLink ) -> $2
  SmartQuotesEnabled SmartQuote -> $2
  MarkdownStrikethroughEnabled StrikethroughDelimiter -> $2
  MarkdownEmphasisEnabled EmphasisDelimiter -> $2
  /['"]/
  # Skip to next interesting text-mode character.
  /[^\r\n'"\\()\[\]{}%][^\r\n!'"@#<`\\()\[\]{}%$*~]*/

RefShorthand ::Ref
  # @'long ref'
  /(?<=(?:^|\s|[\p{Punctuation}\p{Symbol}]))(@[=#^]?)('[^']*'|"[^"]*"|\{[^{}]*\})/ ->
    label := $2[<..<]
    prefix := labelPrefix $1, label
    return $skip unless prefix?
    style := state.compilerOptions.styles[$1]
    target := prefix + label
    return { type: "Ref", style, variant: $1, target, children: [style, "{", target, "}"] }
  # @ref without spaces and without grabbing trailing punctuation
  /(?<=(?:^|\s|[\p{Punctuation}\p{Symbol}]))(@[=#^]?)([^()\[\]\s'"{}=~][^()\[\]\s{}~]*)(?<!\p{Punctuation})/ ->
    prefix := labelPrefix $1, $2
    return $skip unless prefix?
    style := state.compilerOptions.styles[$1]
    target := prefix + $2
    return { type: "Ref", style, variant: $1, target, children: [style, "{", target, "}"] }

CiteShorthand ::Citation
  /\[\[(.*?)\]\]/ ->
    style := state.compilerOptions.styles['[[']
    content: string := $1
    keys := content.split(',').map .trim()
    return { type: "Citation", style, keys, children: [style, "{", content, "}"] }

```
// These predicates run just after capture group 1, the delimiter run.
// Including `\1` in lookbehind makes it test the character before that run.

// https://spec.commonmark.org/0.31.2/#emphasis-and-strong-emphasis
// defines "left-flanking delimiter run" as (1) not followed by a space, and
// (2a) not followed by punctuation, or (2b) [followed by punctuation and]
// preceded by whitespace or punctuation.
punctuationPattern := String.raw`[\p{Punctuation}\p{Symbol}]`
leftFlankingPattern := String.raw`(?:(?!${punctuationPattern})|(?<=(?:^|\s|${punctuationPattern})\1))`
// "Right-flanking delimiter run" is (1) not preceded by a space, and
// (2a) not preceded by punctuation, or (2b) [preceded by punctuation and]
// followed by whitespace or punctuation.
rightFlankingPattern := String.raw`(?:(?<!${punctuationPattern}\1)|(?=$|\s|${punctuationPattern}))`
```

EmphasisDelimiter ::Delimiter
  # Left- *and* right-flanking delimiter according to above definitions.
  ///
    (?<![\*\s]|^) (\*+) (?![\*\s]|$)
    ${const leftFlankingPattern}
    ${const rightFlankingPattern}
  /// -> delimiter $1, true, true
  ///
    (?<!\*) (\*+) (?![\*\s]|$)
    ${const leftFlankingPattern}
  /// -> delimiter $1, true, false
  ///
    (?<![\*\s]|^) (\*+) (?!\*)
    ${const rightFlankingPattern}
  /// -> delimiter $1, false, true

StrikethroughDelimiter ::Delimiter
  ///
    (?<![~\s]|^) (~~) (?![~\s]|$)
    ${const leftFlankingPattern}
    ${const rightFlankingPattern}
  /// -> delimiter $1, true, true
  ///
    (?<!~) (~~) (?![~\s]|$)
    ${const leftFlankingPattern}
  /// -> delimiter $1, true, false
  ///
    (?<![~\s]|^) (~~) (?!~)
    ${const rightFlankingPattern}
  /// -> delimiter $1, false, true

```
function delimiter(token: string, open: boolean, close: boolean): Delimiter
  {
    type: "Delimiter"
    open
    close
    state.compilerOptions.styles
    symbol: token
    token
  }
```

# Inline tokens shared between text mode (TextPart) and math mode (MathPart).
TextOrMathPart ::AST
  BeginEndMathEnvironment
  BeginEndTextEnvironment
  Comment
  VerbatimEnvironment
  RawEnvironment
  $( Csname / CharCommand ):token -> { type: "Raw", token }

Csname ::AST[]
  /\\csname(?![a-zA-Z@])/ CsnamePart* /\\endcsname(?![a-zA-Z@])/

CsnamePart ::AST
  Csname
  !/\\endcsname(?![a-zA-Z@])/ Command -> $2
  Comment ActualEOL
  /[^\\%]+/

CharCommand ::AST[]
  /\\char(?![a-zA-Z@])/ Space "`" ( Command / /[^\\%\r\n]/ )

## MATH

# Content inside e.g. `$...$` that respects indentation
MathContent ::AST[]
  MathText:text NestedMathStatement*:body -> [ text, ...body.flat() ]

# No Nested requirement; used in MathBracedContent where braces delimit the
# argument and indentation should not matter.
MathAndContent ::AST[]
  MathText:text ( EOL MathStatement )*:body ->
    [ text, ...body.flat() ]
  "" -> []

NestedMathStatement ::AST[]
  Nested MathStatement

MathStatement ::AST
  MathModeStatement
  Indent MathText

MathModeStatement ::AST
  TextOrMathStatement
  MathCommandWithColonArguments
  ColonEnvironmentsEnabled MathEnvironment -> $2

# Detect whether the next line is a math-mode statement, for deciding whether
# to continue balanced parenthesized script content.
IsMathStatement
  PushLineIndent (&MathModeStatement)?:statement PopLineIndent ->
    return $skip unless statement

MathText ::AST[]
  MathPart*

MathPart ::AST
  MathOnlyPart
  !MathCloseDelimiter TextOrMathPart -> $2
  !MathCloseDelimiter MathCommandWithArguments -> $2
  MathLiteral
  [()\[\]]

MathCloseDelimiter
  # These closers could otherwise parse as Commands.
  "\\)"
  "\\]"
  EndMathEnvironment
  # `$` cannot be consumed by MathPart, so dollar math stops without lookahead.

MathLiteral ::string
  # Skip to next interesting math-mode character.
  /[^\r\n\\()\[\]{}%$][^\r\n\\\^_()\[\]{}%$]*/

# Rules for MathPart that apply only in math mode.
MathOnlyPart ::AST
  ScriptGroupingEnabled ScriptCommand -> $2
  MathBracedContent
  ScriptGroupingNumeric /([\^_])(\d{2,})/:script ->
    return `${script[1]}{${script[2]}}`
  ScriptGroupingAlpha /([\^_])([a-zA-Z]{2,})/:script ->
    return `${script[1]}{${script[2]}}`
  ScriptGroupingAlphanumeric /([\^_])([a-zA-Z0-9]{2,})/:script ->
    return `${script[1]}{${script[2]}}`
  ScriptParensEnabled [\^_]:script &/\((?![ \t]*[\^_])/ MathParenthesizedText:body ->
    // body[1] strips the parens
    return [ script[0], '{', body[1], '}' ]

ScriptCommand ::AST[]
  [\^_]:script PushMathCommandPattern:head CommandArgument*:args CommandPatternComplete:complete PopCommandPattern ->
    return $skip unless complete
    [ script[0], "{", buildCall(head, { args, complete }), "}" ]

CommandPatternComplete ::boolean
  "" ->
    pattern := state.argumentPatterns.-1
    return false if pattern <? "string"
    pattern.args[>=pattern.index].every .delimiter.startsWith "optional"

MathParenthesizedText ::AST[]
  "(" MathParenContent ")"

MathParenContent ::AST[]
  MathParenText:text MathParenContinuation*:body -> [ text, ...body ]

MathParenContinuation ::AST[]
  Nested !IsMathStatement Indent MathParenText -> [ $1, $3, $4 ]

MathParenText ::AST[]
  MathParenPart*

MathParenPart ::AST
  MathOnlyPart
  !MathCloseDelimiter TextOrMathPart -> $2
  MathLiteral
  [\[\]]
  # Keep parentheses balanced
  MathParenthesizedText

## CONTENT PRIMITIVES

TrimmedText ::AST[]
  Text:t -> trimContent t

TrimmedMathText ::AST[]
  MathText:t -> trimContent t

```
function trimContent(t: AST[]): AST[]
  t = [...t]
  t[0] = t[0].trimStart() if t[0] <? 'string'
  last := t# - 1
  t[last] = t[last].trimEnd() if t[last] <? 'string'
  t
```

# Analog of Text but with no Texlish processing, used e.g. for ::tex
TexText ::{text: string, comment: Comment?, children: AST[]}
  $/[^%\r\n]*/:text Comment?:comment ->
    {
      text
      comment
      children: $0
    }

TrimmedTexText ::AST[]
  TexText:t ->
    { text, comment } := t
    [
      if comment then text.trimStart() else text.trim()
      comment
    ]

TextBracedContent ::Enclosed
  "{":open TextAndContent:body "}":close ->
    enclosedContent open, body, close

MathBracedContent ::Enclosed
  "{":open MathAndContent:body "}":close ->
    enclosedContent open, body, close

```
function enclosedContent(
  open: string
  body: ASTObject
  close: string
  comment?: Comment
): Enclosed
  if not comment and Array.isArray body
    [body, comment] = commentForBody body
    comment = undefined if comment.implicit
  {
    type: "Enclosed"
    open
    body
    close
    children: [
      open
      body
      close
      comment
    ]
  }
```

# TeX optional arguments stop at the first unbraced ], rather than balancing
# brackets. TextBracedContent/MathBracedContent protects any ] inside braces.
TextBracketedContent ::Enclosed
  "[":open TextBracketedPart*:body "]":close -> enclosedContent open, body, close

TextBracketedPart ::AST
  !"]" ( TextPart / EOL ) -> $2

MathBracketedContent ::Enclosed
  "[":open MathBracketedPart*:body "]":close -> enclosedContent open, body, close

MathBracketedPart ::AST
  !"]" ( MathPart / EOL ) -> $2

# TeX-mode arguments stay opaque to Texlish, but TeX comments hide delimiters
# until the end of their line and commands stay opaque.
RawBracedContent ::AST[]
  "{" RawBracedPart* "}"

RawBracedPart ::AST
  Command
  Comment
  RawBracedContent
  /[^\\{}%]+/

RawBracketedContent ::AST[]
  "[" RawBracketedPart* "]"

RawBracketedPart ::AST
  Command
  Comment
  RawBracedContent
  /[^\\\]{}%]+/

# TeX parenthesized arguments stop at the first unbraced ), rather than balancing
# parentheses. Braced content protects any ) inside braces.
TextParenthesizedContent ::Enclosed
  "(":open TextParenthesizedPart*:body ")":close -> enclosedContent open, body, close

TextParenthesizedPart ::AST
  !")" ( TextPart / EOL ) -> $2

MathParenthesizedContent ::Enclosed
  "(":open MathParenthesizedPart*:body ")":close -> enclosedContent open, body, close

MathParenthesizedPart ::AST
  !")" ( MathPart / EOL ) -> $2

RawParenthesizedContent ::AST[]
  "(" ( Command / Comment / RawBracedContent / /[^\\){}%]+/ )* ")"

VerbatimParenthesizedContent ::AST[]
  "(" ( Command / VerbatimBracedContent / /[^\\){}]+/ )* ")"

# Verbatim-mode arguments treat % literally, so comments never hide delimiters.
VerbatimBracedContent ::AST[]
  "{" VerbatimBracedPart* "}"

VerbatimBracedPart ::AST
  Command
  VerbatimBracedContent
  /[^\\{}]+/

VerbatimBracketedContent ::AST[]
  "[" VerbatimBracketedPart* "]"

VerbatimBracketedPart ::AST
  Command
  VerbatimBracedContent
  /[^\\\]{}]+/

Comment ::Comment
  /%[^\r\n]*/ ->
    return {
      type: "Comment",
      token: $0,
      $loc,
    }

NestedComment ::AST[]
  Nested Indent Comment -> $0

## MARKDOWN

BracketedText ::[open: string, content: AST[], close: string]
  "[" BracketContent "]"

BracketContent ::AST[]
  BracketText:text BracketContinuation*:body -> [ text, ...body ]

BracketContinuation ::AST[]
  Nested !IsTextStatement Indent BracketText -> [ $1, $3, $4 ]

BracketText ::AST[]
  BracketTextPart*

BracketTextPart ::AST
  TextOrMathPart
  TextOnlyPart
  [()]
  # Keep brackets balanced
  BracketedText

MarkdownImage ::Image
  "!" BracketedText:alt "(" MarkdownLinkDestination:url ")" ->
    altText := alt[1]
    style := state.compilerOptions.styles['!']
    {
      type: "Image"
      style
      url
      alt: altText
      children: [
        style
        ...if isEmpty trimContent altText then [] else
          ["[alt={", altText, "}]"]
        "{", url, "}"
      ]
    }

# https://spec.commonmark.org/0.31.2/#autolinks
Autolink ::AST
  # "An absolute URI, for these purposes, consists of a scheme [any sequence of 2–32 characters beginning with an ASCII letter and followed by any combination of ASCII letters, digits, or the symbols plus, period, or hyphen] followed by a colon (:) followed by zero or more characters other than ASCII control characters, space, <, and >."
  /<([a-zA-Z][a-zA-Z0-9\+\.\-]{1,31}:[^\x00-\x1f\x7f\s<>]*)>/ ->
    return `\\protect\\url{${$1}}`
  # "An email address, for these purposes, is anything that matches the non-normative regex from the HTML5 spec"
  # Texlish additionally allows {a,b} in the userid, which is common in papers
  /<([a-zA-Z0-9.!#$%&'\*\+\/=\?\^_`{\|}~\-,]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*)>/ ->
    email .= $1
    // Convert {a,b}@domain to mailto:a@domain,b@domain
    if match := /\{([a-zA-Z0-9.!#$%&'\*\+\/=\?\^_`\|~\-,]+)\}/.exec email
      email = match[1].split(',').map (part) =>
        email[< match.index] + part + email[>= match.index + match[0]#]
      .join(',')
    // commonmark.js dingus escapes as follows:
    email = email
    .replace /&/g, '&amp;'
    .replace /[%^`|]/g, (m: string) => `%${m.charCodeAt(0).toString(16).toUpperCase()}`
    return `\\protect\\href{mailto:${email}}{\\protect\\nolinkurl{${$1}}}`

MarkdownLink ::AST
  /(?<!!)(?=\[)/ BracketedText:body "(" MarkdownLinkDestination:url ")" ->
    {
      children: [
        "\\protect\\href{"
        url
        "}{"
        // [1] strips the brackets
        body[1]
        "}"
      ]
    }

MarkdownLinkDestination ::string
  "<" MarkdownAngleLinkDestinationPart*:parts ">" -> parts.join ''
  MarkdownBareLinkDestinationPart+:parts -> parts.join ''

MarkdownAngleLinkDestinationPart ::string
  MarkdownBackslashEscape
  [^\x00-\x1f\x7f\r\n<>\\]+

MarkdownBareLinkDestinationPart ::string
  "(" MarkdownBareLinkDestinationPart*:parts ")" -> `(${parts.join ''})`
  [^\x00-\x1f\x7f\s()<>\\]+
  MarkdownBackslashEscape

MarkdownBackslashEscape ::string
  /\\([!-\/:-@\[-`{-~])/ -> $1
  "\\"

SmartQuote ::SmartQuote
  ['"] ->
    quote := $0 as QuoteChar
    style := state.compilerOptions.quotes[quote]
    {
      type: "SmartQuote"
      token: quote
      quote
      style.{open,close}
      $loc
    }

CodeSpan ::CodeSpan
  CodeSpanOpen:marker CodeSpanBody:content CodeSpanClose ->
    state.codeMarker = undefined
    // CommonMark code spans convert line endings to spaces.
    // Texlish also absorbs indentation after line endings,
    // similar to LaTeX line endings and better behaved with indentation model.
    content = content.replace /(?:\r\n?|\n)[ \t]*/g, " "
    // CommonMark code spans strip exactly one leading/trailing space.
    if content.startsWith(" ") and content.endsWith(" ") and /[^ ]/.test content
      content = content[<..<]
    body: Verbatim := { type: "Verbatim", token: content }
    style .= for first length of [marker# >=..1]
      continue unless style := state.compilerOptions.styles["`".repeat length]
      style
    style ?= "\\verb"
    let arg: ArgumentSpec?
    if command := /\\(?:[a-zA-Z@]+|[^\r\n])\*?$/.exec(style)?[0]
      if resolution := state.declarations.getCommand command
        arg = resolution.args.-1
    unless arg?.mode is "verbatim" and
           arg.delimiter is like "delimited", "required-or-delimited"
      return {
        type: "CodeSpan"
        style
        body
        children: [style, "{", body, "}"]
      }
    // Delimited arguments use matching before/after delimiters. Find one absent
    // from the body.
    let delimiter: string?
    unless "`" is in content
      delimiter = "`"
    else unless "|" is in content
      delimiter = "|"
    else
      for char of ["!".."~"] // 33..126 printable ASCII
        unless content.includes char
          delimiter = char
          break
      unless delimiter?
        throw new Error `Could not find printable ASCII delimiter for \\verb in ${JSON.stringify content}`
    return {
      type: "CodeSpan"
      style
      body
      delimiter
      children: [style, delimiter, body, delimiter]
    }

CodeSpanOpen ::string
  /// (?<!`) `{${Math.max(1, state.compilerOptions.markdownBackticks)},} (?!`) /// ->
    state.codeMarker = $0

CodeSpanBody ::string
  CodeSpanBodyPart*:parts -> parts.join ''

CodeSpanBodyPart ::string
  /[^`\r\n]+/
  !CodeSpanClose "`" -> $2
  # Forbid paragraph breaks in the middle of code spans (like CommonMark).
  # Also require respecting current level of indentation.
  &EOL !(EOL EOL) $Nested -> $3

CodeSpanClose ::string
  /// (?<!`) ${state.codeMarker} (?!`) ///

CodeBlock ::CodeBlock
  CodeBlockOpen:blockOpen CodeBlockBody:content CodeBlockClose ->
    state.codeMarker = undefined
    { indent, marker, info } .= blockOpen
    info = info.trim()
    suffix := info or "*"
    option := if info.startsWith "[" then info else ""
    style .= for first length of [marker# >=..3]
      ticks := "`".repeat length
      continue unless style := state.compilerOptions.styles[ticks + suffix] ??
        state.compilerOptions.styles[ticks + "*"]
      style
    style ?= "\\begin{verbatim}"
    env := environmentStyle style, "code block", option
    if indent.level > 0
      // CommonMark fenced code blocks remove up to the opening fence
      // indentation from each content line:
      // https://spec.commonmark.org/0.31.2/#fenced-code-blocks
      content = content.replace /(^|\r\n?|\n)([ \t]*)/g, (_, lineStart, lineIndent) =>
        lineStart + reduceVisualIndent lineIndent, indent.level
    body: Verbatim := { type: "Verbatim", token: content }
    {
      type: "CodeBlock"
      style
      info
      body
      env.env
      children: [
        indent
        env.open
        "\n"
        body
        if content# and not /(?:\r\n?|\n)$/.test content then "\n"
        env.close
      ]
    }

```
/**
 * Interpret a configured style value as a LaTeX environment.
 * Supports a bare environment name, Texlish `: environment` shorthand,
 * or a literal `\begin{environment}` prefix; optional text is appended to
 * the opening environment for fenced-code options.
 */
function environmentStyle(style: string, description: string, option: string = ""): {env: string, open: string, close: string}
  style = style.trim()
  style = style[>=2].trimStart() if /^:[ \t]/.test style
  if match := /^\\begin\s*\{([^}]+)\}(.*)$/.exec style
    return {
      env: match[1]
      open: style + option
      close: `\\end{${match[1]}}`
    }
  if match := /^([^\s(\[\{]+)(.*)$/.exec style
    return {
      env: match[1]
      open: `\\begin{${match[1]}}${match[2]}${option}`
      close: `\\end{${match[1]}}`
    }
  throw new Error `Invalid ${description} style ${JSON.stringify style}; expected environment name or \\begin{environment}`
```

CodeBlockOpen ::{indent: Indent, marker: string, info: string}
  Indent:indent /// (`{${Math.max(3, state.compilerOptions.markdownBackticks)},}) [ \t]* ([^\r\n`]*) [ \t]* (?:\r\n?|\n|$) ///:match ->
    [, marker, info] := match
    state.codeMarker = marker
    { indent, marker, info }

CodeBlockBody ::string
  CodeBlockBodyLine*:lines -> lines.join ''

CodeBlockBodyLine ::string
  # Blank lines don't need to be indented
  $EOL
  # Content lines must be indented within current indent scope
  !CodeBlockClose &IndentedAtLeast $( /[^\r\n]+/ EOL ):line -> line

CodeBlockClose ::string
  &IndentedAtLeast /// [ \t]* ${state.codeMarker}`* [ \t]* /// &EOL -> ""

BlockQuote ::BlockQuote
  &( Space BlockQuoteMarker ) Indent:indent PushIndent BlockQuoteSegment:first BlockQuoteContinuation*:rest PopIndent ->
    style := state.compilerOptions.styles['>'] or "quote"
    env := environmentStyle style, "blockquote"
    {
      type: "BlockQuote"
      env.env
      children: [
        indent
        env.open
        "\n"
        first
        ...rest
        "\n"
        indent
        env.close
      ]
    }

BlockQuoteMarker
  />([ \t])/ -> " " + $1
  />(?=[\r\n]|$)/ -> ""

BlockQuoteSegment ::AST[]
  BlockQuoteMarker Text NestedBody

BlockQuoteContinuation ::AST[]
  NestedComment*:comments SameLevel:eol Indent:indent BlockQuoteSegment:segment ->
    [ comments, eol, indent, segment ]

Heading ::Heading
  /(!+|\.*)(#+)(\*?)\s+/ TrimmedText:title ->
    [, dot, hash, star] .= $1
    dots := dot#
    hashes := hash#
    command .=
      if dot[0] is "!"
        if dots > 1 or hashes > 1 then '\\part' else '\\chapter'
      else if dots
        if dots > 1 or hashes > 1 then '\\subparagraph' else '\\paragraph'
      else
        `\\${'sub'.repeat(hashes-1)}section`
    command += '*' if star
    return {
      type: "Heading",
      subtype: command,
      children: [ command, '{', title, '}' ],
    }

HorizontalRule ::AST[]
  Indent:indent $/-(?:[ \t]*-){2,}/:marker Space Comment?:comment &EOL ->
    function rule(style: string): AST[]
      [ indent, { type: "HorizontalRule", style, marker, children: [style] }, comment ]
    if style := state.compilerOptions.styles[marker]
      return rule style
    // For rules consisting of just -, use the closest configured shorter style
    unless /[ \t]/.test marker
      for length of [marker# >..3]
        if style := state.compilerOptions.styles['-'.repeat length]
          return rule style
    rule state.compilerOptions.styles['---'] ?? "\\hrule"

FootnoteRef ::FootnoteRef
  /\[\^([^\]\r\n]+)\]/:marker (&EOL)?:eolNext ->
    return {
      type: "FootnoteRef",
      id: marker[1].trim(),
      eolNext: Boolean(eolNext),
      children: [marker[0]],
    }

FootnoteDefinition ::FootnoteDefinition
  Indent:indent /\[\^([^\]\r\n]+)\]/:marker Colon:colon TextArgumentAfterColon:arg ->
    body: AST[] :=
      if Array.isArray arg.body
        arg.body
      else
        [arg.body]
    return {
      type: "FootnoteDefinition"
      id: marker[1].trim()
      body
      // In case this footnote definition isn't used, its fallback text is
      // roughly the original.
      children: [
        indent
        marker[0]
        colon
        // Unwrap TextArgumentAfterColon
        if body?.[0] is "%" then body[>=1] else [ " ", body ]
      ]
    }

## META COMMANDS

MetaBlock ::AST[]
  &/[ \t]*::/ Indent:indent "::" /\s*/ MetaCommand:cmd -> [indent, cmd]

MetaCommand ::AST
  MetaVersion
  MetaConfig
  MetaStyles
  MetaUse
  MetaTex
  MetaPreamble

MetaVersion ::AST
  "version" ActualSpace /([^\r\n%]+)/:range Comment? ->
    assertTexlishVersion range[1].trim()
    return '\0'  // eat following newline

MetaConfig ::AST
  "config" ActualSpace ConfigAssignment:body ->
    applyConfigAssignments body
    return '\0'  // eat following newline
  "config" NestedConfigAssignments:body ->
    applyConfigAssignments body
    return '\0'  // eat following newline

```
function applyConfigAssignments(body: ConfigEntry[]): void
  if body.some [key] => key[0] is "styles"
    // Avoid aliasing so that we can copy by reference in Delimiters
    state.compilerOptions.styles = {...state.compilerOptions.styles}
  for [key, value] of body
    applyCompilerOption state.compilerOptions, key, value
```

MetaStyles ::AST
  # One-line assignment `::styles key = value`
  "styles" ActualSpace ConfigAssignment:body ->
    applyStyleAssignments body
    '\0'  // eat following newline
  "styles" NestedConfigAssignments:body ->
    applyStyleAssignments body
    '\0'  // eat following newline

```
function applyStyleAssignments(body: ConfigEntry[]): void
  // Avoid aliasing so that we can copy by reference in Delimiters
  state.compilerOptions.styles = {...state.compilerOptions.styles}
  for [key, value] of body
    applyCompilerOption state.compilerOptions, ["styles", ...key], value
```

NestedConfigAssignments ::ConfigEntry[]
  PushStrictIndent NestedConfigAssignment*:items PopIndent ->
    return items.flat()

NestedConfigAssignment ::ConfigEntry[]
  # Note: Discarding comments within ::config.
  # These comments are Texlish specific,
  # so might not be relevant to LaTeX output anyway.
  NestedComment -> []
  Nested Indent ConfigAssignment:assignment -> assignment

ConfigAssignment ::ConfigEntry[]
  # Spaced `key = value`: split at whitespace before `=`, so style keys may
  # themselves contain `=` (for example `@= = \label`).
  $/[^:%\r\n]+?[ \t]+(?==)/:key ConfigRHS:value ->
    return value.map [subpath, value] => [[...key.trimEnd().split('.'), ...subpath], value]
  # Tight `key=value`: forbid `=` in key
  $/[^\s:=%]+/:key NestedConfigRHS:value ->
    return value.map [subpath, value] => [[...key.split('.'), ...subpath], value]

NestedConfigRHS ::ConfigEntry[]
  # `key:` for nested config
  Space ":" Space NestedConfigAssignments:items ->
    return items
  ConfigRHS:rhs -> rhs

ConfigRHS ::ConfigEntry[]
  # `key=value`
  Space "=" TrimmedTexText:value ->
    return [[[], generate(value)]]
  # `key` alone enables option
  "" ->
    return [[[], true]]

MetaUse ::AST
  "use" ActualSpace UseItem:item -> item
  "use" NestedUseList:list -> list

MetaTex ::Tex
  "tex" /\b[ \t]?/ TexText:text TexNestedBody:body ->
    {
      type: "Tex"
      children: [text, body]
    }

MetaPreamble ::Preamble
  "preamble" ( ActualSpace Text )?:text NestedBody:body ->
    preambleText := text?[1]
    textBody := [ preambleText, body ]
    return {
      type: "Preamble"
      textBody
      children: [ textBody ]
    }

UseItem ::Use
  Bullet? $(/[^:%\r\n]+/):name Comment?:comment UseColonArgument?:arg ->
    match := /\s*$/.exec(name)!
    space := match[0]
    name = name[< match.index]
    packages := name.split(',').map .trim()
    state.declarations.loadPackage packageName for packageName of packages
    return {
      type: "Use"
      packages
      children: [
        '\\usepackage'
        arg
        `{${name}}`
        space
        comment
      ]
    }

NestedUseList ::Uses
  ( Space Comment )?:comment PushStrictIndent NestedUseItem*:items PopIndent ->
    return $skip unless items#
    return {
      type: "Uses"
      children: [ comment, items ]
    }

NestedUseItem ::AST[]
  NestedComment
  Nested Indent UseItem

UseColonArgument ::AST[]
  SaveIndent:indent Colon UseArgument:arg ->
    return [
      "["
      arg
      if getEndComment(arg) then [ "\n", indent ]
      "]"
    ]

UseArgument ::AST
  TrimmedTexText ( NestedUseArgumentList / NonEmptyTexNestedBody )?

NestedUseArgumentList ::AST[]
  PushIndent UseArgumentList?:content PopIndent ->
    return $skip unless content
    return content

UseArgumentList ::AST[]
  NestedComment*:comments Nested:eol &/\s*[*\-~]/ &Indent PushIndent ( UseArgumentBullet UseArgumentListContinuation* )?:content PopIndent ->
    return $skip unless content
    return [ comments, eol, content ]

UseArgumentListContinuation ::AST[]
  NestedComment*:comments SameLevel:eol UseArgumentBullet:bullet ->
    // Add a comma before the next bullet, after intervening comments/indent.
    [ indent, , ...rest ] .= bullet
    return [ comments, eol, [ indent, ",", ...rest ] ]

UseArgumentBullet ::AST[]
  Indent:indent /([*\-~])([ \t]+)/ TexText:text TexNestedBody:body ->
    [ , , space ] .= $2
    return [
      indent
      " ", space // indent the same as the bullet
      text
      body
    ]

## NESTED BODIES

NonEmptyNestedBody ::AST[]
  NestedBody ->
    return $skip unless $1#
    return $1

# can be empty; if not desired, use NonEmptyNestedBody
NestedBody ::AST[]
  PushStrictIndent NestedStatement* PopIndent -> $2

NestedStatement ::{eols: AST[], statement: AST, children: AST[]}
  Nested:eols Statement:statement ->
    {
      eols
      statement
      children: $0
    }

# Tex versions of above
NonEmptyTexNestedBody ::AST[]
  TexNestedBody ->
    return $skip unless $1#
    return $1

TexNestedBody ::AST[]
  PushStrictIndent ( Nested Indent TexText )* PopIndent -> $2

## LISTS

```
function buildList(indent: Indent, env: string, items: AST[], args: AST[] = [], eols: AST[] = ["\n"]): List
  {
    type: "List"
    env
    args
    items
    children: [
      indent
      `\\begin{${env}}`
      args
      ...[eols, indent, items] if items#
      "\n"
      indent
      `\\end{${env}}`
    ]
  }
```

UnorderedList ::List
  &/[ \t]*[*\-~]/ Indent:indent PushIndent ( UnorderedBullet UnorderedListContinuation* )?:items PopIndent ->
    return $skip unless items
    buildList indent, "itemize", items

UnorderedBullet ::ListItem
  MarkdownChecklistsEnabled Bullet ChecklistMarker:checklist $( ActualSpace / &EOL ):space ListItemLine:text NestedBody:body ->
    { type: "ListItem", children: [ checklist, space, text, body ] }
  Bullet:bullet ListItemLine:text NestedBody:body ->
    space := bullet[1]
    { type: "ListItem", children: [ '\\item', space, text, body ] }

ChecklistMarker ::Checklist
  # Hera compiles grammar regexes with the Unicode `u` flag, so this character
  # class matches Unicode code points, including astral characters such as
  # emoji. Require a nonempty marker while excluding `]` and newlines.
  /// \[ [^\]\r\n]+ \] /// ->
    return $skip unless style? := state.compilerOptions.styles[$0]
    {
      type: "Checklist"
      style
      children: ["\\item[", style, "]"]
    }

UnorderedListContinuation ::AST[]
  NestedComment*:comments SameLevel:eol Indent:indent UnorderedBullet:bullet ->
    return [ comments, eol, indent, bullet ]

Bullet ::[symbol: string, space: string]
  $( OptionalBullet / RequiredBullet ):symbol $( ActualSpace / &ActualEOL ):space ->
    setListItemIndent(symbol + space)
    [ symbol, space ]

OptionalBullet ::string
  "~"

RequiredBullet ::string
  [*\-]

OrderedList ::List
  &/[ \t]*\d+\./ Indent:indent PushIndent ( OrderedBullet OrderedListContinuation* )?:items PopIndent ->
    return $skip unless items
    list := buildList indent, "enumerate", items
    list.start = items[0].number
    list

OrderedBullet ::ListItem & {number: number}
  NumberBullet:bullet ListItemLine:text NestedBody:body ->
    { type: "ListItem", bullet.number, children: [ '\\item', bullet.space, text, body ] }

NumberBullet ::{number: number, space: string}
  /(\d+)\.([ \t]+|(?=[\r\n]))/ ->
    setListItemIndent $0
    { number: Number($1), space: $2 }

OrderedListContinuation ::AST[]
  NestedComment*:comments SameLevel:eol Indent:indent OrderedBullet:bullet ->
    return [ comments, eol, indent, bullet ]

# First line of every list item, immediately after the bullet.
ListItemLine ::AST[]
  PushListItemPendingIndent ListItemStatement?:statement PopListItemIndent ->
    return $skip unless statement
    if Array.isArray statement
      return removeLeadingIndent statement
    throw new Error "Expected parent statement" unless statement is like { children }
    [ removeLeadingIndent statement as ASTParent ]
  # Note: Text always matches, so we don't need `?`/`$skip` here
  PushListItemIndent Text:text PopListItemIndent -> text

ListItemStatement ::AST
  # Alternatives must reject before Indent unless they are really matching:
  # Indent consumes pendingLineIndent, which later alternatives need.
  ColonEnvironmentsEnabled TextEnvironment -> $2
  MetaBlock
  MarkdownListsEnabled UnorderedList -> $2
  MarkdownListsEnabled OrderedList -> $2
  ListDirective

ListDirective ::List
  &/[ \t]*::[ \t]*list(?=[ \t:[{%\r\n]|$)/ Indent:indent /::[ \t]*list[ \t]*/ PushIndent PushListEnvironmentPattern:env ListDirectiveArguments?:args PopCommandPattern ( Nested ( UnorderedList / OrderedList ) )?:body PopIndent ->
    return $skip unless args?
    if body?
      [eols, list] := body
      buildList getLeadingIndent(list), env, list.items, args, eols
    else
      buildList indent, env, [], args

PushListEnvironmentPattern ::string
  # `::list env` parses arguments like `: env`
  EnvironmentName:env ->
    pushEnvironmentPattern env, "text"
    env
  # `::list` without environment name needs to figure out itemize or enumerate.
  # Probe with enumerate's declaration, then restore state and select the
  # actual pattern. Empty lists default to itemize.
  PushLineIndent PushEnumerateArgumentPattern (&( ListDirectiveArguments Nested /[ \t]*\d+\.([ \t]+|(?=[\r\n]))/ ))?:ordered PopCommandPattern PopLineIndent ->
    env := if ordered then "enumerate" else "itemize"
    pushEnvironmentPattern env, "text"
    env

PushEnumerateArgumentPattern
  "" -> pushEnvironmentPattern "enumerate", "text"

ListDirectiveArguments ::AST[]
  CommandArgument*:args ( ListColonArguments / TrimmedText ):tail NestedComment*:comments &EOL ->
    [
      ...args
      ...tail
      ...comments
    ]

# Like command/environment colon arguments, but list argument bullets must be
# strictly indented, and unbulleted indented content is never an argument.
# Also allow an empty trailing colon and preserve a comment after it.
ListColonArguments ::AST[]
  Space Colon Space !( Comment / EOL ) InlineCommandArgumentAfterColon:arg -> [arg]
  Space Colon ( Space Comment )?:comment &EOL PushStrictIndent ArgumentList?:args PopIndent ->
    [
      ...comment if comment
      ...args if args
    ]

## COMMANDS

Command ::Command
  CommandWithoutNewline
  /\\(?=[\r\n]|$)/ ->
    return {
      type: "Command",
      token: $0,
    }

# Forbids \ followed by newline
CommandWithoutNewline ::Command
  /\\([a-zA-Z@]+|[^\r\n])/ ->
    return {
      type: "Command",
      token: $0,
    }

# Command that can be followed by a colon argument
# Forbids \ followed by newline
# Allows whitespace before *, but keeps only * in the token for declaration lookup.
StarredCommand ::Command
  CommandWithoutNewline ( Space "*" )?:star ->
    return $1 unless star
    return { ...$1, token: $1.token + "*" }

TextCommandWithArguments ::AST
  # Declared commands push their pattern on the argumentPatterns stack.
  PushTextCommandPattern:head CommandArguments:parsed ->
    buildCall head, parsed
  # Undeclared commands get a generic pattern only when using colon shorthand;
  # otherwise the plain Command fallback leaves their groups alone.
  PushGenericTextColonCommandPattern:command InlineCommandColonArguments?:colonArgs PopCommandPattern ->
    return $skip unless colonArgs?
    [ command, ...colonArgs ]
  Command

MathCommandWithArguments ::AST
  PushMathCommandPattern:head CommandArguments:parsed ->
    buildCall head, parsed
  PushGenericMathColonCommandPattern:command InlineCommandColonArguments?:colonArgs PopCommandPattern ->
    return $skip unless colonArgs?
    [ command, ...colonArgs ]
  Command

```
type PendingCall =
  command: Command
  argsSpec: ArgumentsPattern
  package: string

type ParsedCallArguments =
  args: Argument[]
  complete: boolean

function buildCall(
  head: PendingCall
  { args, complete }: ParsedCallArguments
): Call
  {
    type: "Call"
    head.{command,argsSpec,package}
    args
    complete
    children: [ head.command, args ]
  }
```

# Parse LaTeX-style arguments, optionally switch to inline colon arguments,
# and pop the active command pattern.
CommandArguments ::ParsedCallArguments
  CommandArgument*:args InlineCommandColonArguments?:colonArgs CommandPatternComplete:complete PopCommandPattern ->
    args = [ ...args, ...colonArgs ] if colonArgs?
    { args, complete }

# Colon arguments for a command in the middle of a line in text or math.
# Accept either indented argument bullets, or one argument that is same-line
# or indented, but not both (unlike statement-level `\command`).
InlineCommandColonArguments ::Argument[]
  ColonCommandsEnabled Colon NestedCommandArgumentList:args -> args
  ColonCommandsEnabled Colon InlineCommandArgumentAfterColon:arg -> [ arg ]

PushTextCommandPattern ::PendingCall
  StarredCommand:command -> pushCommandPattern(command, "text") ?? $skip
  CommandWithoutNewline:command -> pushCommandPattern(command, "text") ?? $skip

PushMathCommandPattern ::PendingCall
  StarredCommand:command -> pushCommandPattern(command, "math") ?? $skip
  CommandWithoutNewline:command -> pushCommandPattern(command, "math") ?? $skip

```
function pushCommandPattern(
  command: Command
  parentMode: ResolvedArgumentMode
): PendingCall?
  return unless resolution := state.declarations.getCommand command.token
  pushArgumentPattern resolution.args, parentMode
  {
    command
    argsSpec: resolution.args
    package: resolution.package.name
  }

function pushArgumentPattern(args: ArgumentsPattern, parentMode: ResolvedArgumentMode): void
  if (arg.mode is "inherit" for some each arg of args)
    args = for each arg of args
      if arg.mode is "inherit"
        { ...arg, mode: parentMode }
      else
        arg
  state.argumentPatterns.push { args, index: 0, parentMode }
```

PopCommandPattern
  "" -> state.argumentPatterns.pop()

CommandArgument ::Argument
  OptionalArgumentPossible CommandSpace:space OptionalArgumentContent:content ->
    commandArgument "optional", "bracketed", content.body,
      [ space, content ]
  RequiredArgumentPossible CommandSpace:space RequiredArgumentContent:content ->
    commandArgument "required", "braced", content.body,
      [ space, content ]
  ParenthesizedArgumentPossible:delimiter CommandSpace:space ParenthesizedArgumentContent:content ->
    commandArgument delimiter, "parenthesized", content.body, [space, content]
  # Prefer colon shorthand over `:` as a verbatim delimiter when a required
  # argument remains, e.g. `\url: ...`, but preserve `\verb:...:`.
  !(Colon ColonCommandsEnabled RequiredArgumentPossible) DelimitedVerbatimArgument Space:space $DelimitedVerbatim:arg ->
    content := unparsedArgument arg, "Verbatim"
    commandArgument "delimited", "delimited", content.body, [space, content]
  # Try delimiters first so a backslash-delimited verbatim argument stays literal.
  # TeX undelimited required arguments can be single control-sequence tokens.
  DeclaredRequiredArgumentPossible CommandSpace:space CommandWithoutNewline:body ->
    commandArgument "required", "unbraced", body, [ space, body ]

```
type SelectedArgument
  arg: ArgumentSpec
  /** Index in the declared pattern; omitted for generic or extra arguments */
  index?: number

function consumeCommandArgument(delimiter: ArgumentDelimiter, allowFallback = false, colon = false): SelectedArgument
  unless state.argumentPatterns#
    throw new Error "No current command pattern"
  unless selected := selectCommandArgument delimiter, allowFallback, colon
    throw new Error "No current command argument"
  // Entering fallback skips any remaining optional declarations permanently.
  pattern := state.argumentPatterns.-1
  unless pattern <? "string"
    pattern.index = if selected.index? then selected.index + 1 else pattern.args#
  selected

function selectCommandArgument(delimiter: ArgumentDelimiter, allowFallback = false, colon = false): SelectedArgument?
  return unless pattern := state.argumentPatterns.-1
  if pattern <? "string"
    // Generic colon arguments use only paired optional/required syntax.
    return unless delimiter is like "optional", "required"
    return arg: { name: "argument", delimiter, mode: pattern }
  for index .= pattern.index; index < pattern.args#; index++
    arg := pattern.args[index]
    if arg.delimiter is delimiter or
       // Colon syntax selects required/optional roles as needed
       colon and arg.delimiter is `${delimiter}-parenthesized` or
       arg.delimiter is "required-or-delimited" and
       delimiter is like "required", "delimited"
      return { arg, index }
    // Only allow skipping over optional arguments
    break unless arg.delimiter.startsWith "optional"
  if allowFallback and delimiter is like "optional", "required" and
     pattern.args[>=pattern.index].every .delimiter.startsWith "optional"
    return arg: { name: "argument", delimiter, mode: pattern.parentMode }

function commandArgument(
  delimiter: ArgumentDelimiter
  form: Argument["form"]
  body: ASTObject
  children: AST[]
): Argument
  colon := form is like "colon", "bullet", "final"
  selected := consumeCommandArgument delimiter, form is "bullet", colon
  delimiter = selected.arg.delimiter if colon and selected.arg.delimiter.endsWith "-parenthesized"
  {
    type: "Argument"
    specIndex: selected.index
    delimiter
    form
    body
    children
  }
```

OptionalArgumentPossible
  "" -> $skip unless selectCommandArgument "optional"
RequiredArgumentPossible
  "" -> $skip unless selectCommandArgument "required"
ParenthesizedArgumentPossible ::ArgumentDelimiter
  "" ->
    selected := selectCommandArgument("optional-parenthesized") ?? selectCommandArgument("required-parenthesized")
    selected?.arg.delimiter ?? $skip
ParenthesizedRawArgument
  "" -> $skip unless parenthesizedArgumentIs "raw"
ParenthesizedVerbatimArgument
  "" -> $skip unless parenthesizedArgumentIs "verbatim"
ParenthesizedTextArgument
  "" -> $skip unless parenthesizedArgumentIs "text"
ParenthesizedMathArgument
  "" -> $skip unless parenthesizedArgumentIs "math"
# Only a declaration can distinguish an unbraced argument from a body command.
DeclaredRequiredArgumentPossible
  "" ->
    arg := selectCommandArgument "required"
    $skip unless arg?.index?
DelimitedVerbatimArgument
  "" -> $skip unless commandArgumentIs "delimited", "verbatim"
DelimitedVerbatim ::string
  /([^\s])[^\r\n]*?\1/

CommandSpace ::AST[]
  Space CommandCommentContinuation*
CommandCommentContinuation ::AST[]
  Comment:comment EOL:eol &IndentedAtLeast Indent:indent -> [ comment, eol, indent ]

OptionalArgumentContent ::Enclosed
  OptionalRawArgument $RawBracketedContent:arg -> unparsedArgument arg, "Raw"
  OptionalVerbatimArgument $VerbatimBracketedContent:arg -> unparsedArgument arg, "Verbatim"
  OptionalTextArgument TextBracketedContent:arg -> arg
  OptionalMathArgument MathBracketedContent:arg -> arg

RequiredArgumentContent ::Enclosed
  RequiredRawArgument $RawBracedContent:arg -> unparsedArgument arg, "Raw"
  RequiredVerbatimArgument $VerbatimBracedContent:arg -> unparsedArgument arg, "Verbatim"
  RequiredTextArgument TextBracedContent:arg -> arg
  RequiredMathArgument MathBracedContent:arg -> arg

ParenthesizedArgumentContent ::Enclosed
  ParenthesizedRawArgument $RawParenthesizedContent:arg -> unparsedArgument arg, "Raw"
  ParenthesizedVerbatimArgument $VerbatimParenthesizedContent:arg -> unparsedArgument arg, "Verbatim"
  ParenthesizedTextArgument TextParenthesizedContent:arg -> arg
  ParenthesizedMathArgument MathParenthesizedContent:arg -> arg

```
/**
 * Exclude the opening and closing delimiter characters from the body.
 * Preserve those delimiters in children alongside the raw or verbatim body.
 */
function unparsedArgument(
  source: string
  type: "Raw" | "Verbatim"
): Enclosed
  body := { type, token: source[<..<] }
  enclosedContent source[0], body, source.-1
```

OptionalRawArgument
  "" -> $skip unless commandArgumentIs "optional", "raw"
RequiredRawArgument
  "" -> $skip unless commandArgumentIs "required", "raw", false, true
OptionalVerbatimArgument
  "" -> $skip unless commandArgumentIs "optional", "verbatim"
RequiredVerbatimArgument
  "" -> $skip unless commandArgumentIs "required", "verbatim", false, true
OptionalTextArgument
  "" -> $skip unless commandArgumentIs "optional", "text"
RequiredTextArgument
  "" -> $skip unless commandArgumentIs "required", "text", false, true
OptionalMathArgument
  "" -> $skip unless commandArgumentIs "optional", "math"
RequiredMathArgument
  "" -> $skip unless commandArgumentIs "required", "math", false, true

```
function parenthesizedArgumentIs(mode: ArgumentMode): boolean
  selected := selectCommandArgument("optional-parenthesized") ?? selectCommandArgument("required-parenthesized")
  selected?.arg.mode is mode

function commandArgumentIs(delimiter: ArgumentDelimiter, mode: ArgumentMode, allowFallback = false, colon = allowFallback): boolean
  return false unless selected := selectCommandArgument delimiter, allowFallback, colon
  selected.arg.mode is mode
```

# These statement rules handle commands that actually have colon arguments,
# possibly after other arguments. If no colon argument is present, they skip
# and let the inline Text/Math parser handle the command instead.
# This allows other content on the same line after a non-colon command.
TextCommandWithColonArguments ::AST[]
  ColonCommandsEnabled Indent:indent PushTextCommandPattern:head CommandArgument*:args CommandColonArguments?:colonArgs CommandPatternComplete:complete PopCommandPattern ->
    return $skip unless colonArgs?
    [ indent, buildCall(head, { args: [ ...args, ...colonArgs ], complete }) ]
  ColonCommandsEnabled Indent:indent PushGenericTextColonCommandPattern:command CommandColonArguments?:colonArgs PopCommandPattern ->
    return $skip unless colonArgs?
    [ indent, command, ...colonArgs ]
MathCommandWithColonArguments ::AST[]
  ColonCommandsEnabled Indent:indent PushMathCommandPattern:head CommandArgument*:args CommandColonArguments?:colonArgs CommandPatternComplete:complete PopCommandPattern ->
    return $skip unless colonArgs?
    [ indent, buildCall(head, { args: [ ...args, ...colonArgs ], complete }) ]
  ColonCommandsEnabled Indent:indent PushGenericMathColonCommandPattern:command CommandColonArguments?:colonArgs PopCommandPattern ->
    return $skip unless colonArgs?
    [ indent, command, ...colonArgs ]

# Undeclared colon commands repeat the surrounding text/math mode for unlimited
# arguments. Declared commands skip these rules in favor of their declaration.
PushGenericTextColonCommandPattern ::Command
  StarredCommand:command &Colon ->
    pushGenericColonCommandPattern(command, "text") ?? $skip
PushGenericMathColonCommandPattern ::Command
  StarredCommand:command &Colon ->
    pushGenericColonCommandPattern(command, "math") ?? $skip

```
function pushGenericColonCommandPattern(command: Command, mode: ResolvedArgumentMode): Command?
  return if state.declarations.hasCommand command.token
  state.argumentPatterns.push mode
  command
```

# ":", but don't treat :: as :
Colon
  /:(?!:)/

# Colon arguments for a command starting a statement.
# Accepts either indented argument bullets, or
# one argument that can continue same-line and/or indented following lines.
CommandColonArguments ::Argument[]
  Colon NestedCommandArgumentList:args -> args
  Colon CommandArgumentAfterColon:arg -> [ arg ]

# Parse and consume one required colon argument according to the next remaining
# declared mode.
CommandArgumentAfterColon ::Argument
  RequiredRawArgument RawArgumentAfterColon:arg ->
    consumeRequiredCommandArgument arg
  RequiredVerbatimArgument VerbatimArgumentAfterColon:arg ->
    consumeRequiredCommandArgument arg
  RequiredTextArgument TextArgumentAfterColon:arg ->
    consumeRequiredCommandArgument arg
  RequiredMathArgument MathArgumentAfterColon:arg ->
    consumeRequiredCommandArgument arg

```
function consumeRequiredCommandArgument(arg: Enclosed): Argument
  commandArgument "required", "colon", arg.body, [arg]
```

TextArgumentAfterColon ::Enclosed
  TrimmedText:text NestedBody:body ->
    argumentAfterColon text, body
MathArgumentAfterColon ::Enclosed
  TrimmedMathText:text MathArgumentNestedBody:body ->
    argumentAfterColon text, body

```
function argumentAfterColon(
  text: AST[]
  body: AST[]
  verbatimMode = false
  delimiter: ArgumentDelimiter = "required"
): Enclosed
  if not text# and body#
    if verbatimMode
      body = trimVerbatimNestedBody body
    else
      text = ["%"]
  let comment
  [text, body, comment] = commentForTextBody text, body
  [open, close] := colonDelimiters delimiter
  enclosedContent open, [text, body], close, comment

/** Choose declared delimiters without advancing the argument pattern. */
function colonDelimiters(delimiter: ArgumentDelimiter = "required"): [string, string]
  declared := selectCommandArgument(delimiter, true, true)?.arg.delimiter
  return ["(", ")"] if declared?.endsWith "-parenthesized"
  if delimiter is "optional" then ["[", "]"] else ["{", "}"]
```

RawArgumentAfterColon ::Enclosed
  TrimmedRawText:text RawNestedBody:body ->
    argumentAfterColon text, body
VerbatimArgumentAfterColon ::Enclosed
  TrimmedVerbatimText:text VerbatimNestedBody:body ->
    argumentAfterColon text, body, true

MathArgumentNestedBody ::AST[]
  PushStrictIndent NestedMathStatement* PopIndent -> $2
RawNestedBody ::AST[]
  PushStrictIndent ( Nested Indent RawText )* PopIndent -> $2
VerbatimNestedBody ::AST[]
  PushStrictIndent ( Nested Indent VerbatimText )* PopIndent -> $2

RawText ::{text: string, comment: Comment?, children: AST[]}
  RawTextPart*:parts Comment?:comment ->
    text := parts.join ''
    {
      text
      comment
      children: unparsedTextChildren { text, comment }, "Raw"
    }

VerbatimText ::{text: string, comment: undefined, children: AST[]}
  VerbatimTextPart*:parts ->
    text := parts.join ''
    {
      text
      comment: undefined
      children: unparsedTextChildren { text }, "Verbatim"
    }

```
function unparsedTextChildren(
  content: {text: string, comment?: Comment?}
  type: "Raw" | "Verbatim"
  trim = false
): AST[]
  text :=
    if trim
      content.text.trim()
    else if content.comment
      content.text.trimEnd()
    else
      content.text
  return [] unless text or content.comment
  [ { type, token: text } if text, content.comment ]
```

RawTextPart ::string
  $RawBracedContent
  /\\[^\r\n]|[^\\{}%\r\n]+/

VerbatimTextPart ::string
  $VerbatimBracedContent
  /\\[^\r\n]|[^\\{}\r\n]+/

# Parse and consume one required inline colon argument according to the next
# remaining declared mode, without combining same-line and indented content.
InlineCommandArgumentAfterColon ::Argument
  RequiredRawArgument InlineRawArgumentAfterColon:arg ->
    consumeRequiredCommandArgument arg
  RequiredVerbatimArgument InlineVerbatimArgumentAfterColon:arg ->
    consumeRequiredCommandArgument arg
  RequiredTextArgument InlineTextArgumentAfterColon:arg ->
    consumeRequiredCommandArgument arg
  RequiredMathArgument InlineMathArgumentAfterColon:arg ->
    consumeRequiredCommandArgument arg

InlineTextArgumentAfterColon ::Enclosed
  NonEmptyNestedBody:body -> buildColonArgument ["%", body]
  TrimmedText:body -> buildColonArgument body

InlineMathArgumentAfterColon ::Enclosed
  MathArgumentNestedBody:body ->
    return $skip unless body#
    buildColonArgument ["%", body]
  TrimmedMathText:body -> buildColonArgument body

InlineRawArgumentAfterColon ::Enclosed
  RawNestedBody:body ->
    return $skip unless body#
    buildColonArgument ["%", body]
  TrimmedRawText:body -> buildColonArgument body

InlineVerbatimArgumentAfterColon ::Enclosed
  VerbatimNestedBody:body ->
    return $skip unless body#
    buildColonArgument trimVerbatimNestedBody(body)
  TrimmedVerbatimText:body -> buildColonArgument body

```
function buildColonArgument(body: AST[]): Enclosed
  [open, close] := colonDelimiters()
  let comment
  [body, comment] = commentForBody body
  enclosedContent open, body, close, comment

function trimVerbatimNestedBody(body: AST[]): AST[]
  first := body[0]
  return body unless Array.isArray first
  return body unless first[1] is like { type: "Indent" }
  eols := first[0]
  return body unless Array.isArray eols
  [ [ eols[>=1], ...first[>=2] ], ...body[>=1] ]
```

TrimmedRawText ::AST[]
  RawText:text -> unparsedTextChildren text, "Raw", true
TrimmedVerbatimText ::AST[]
  VerbatimText:text -> unparsedTextChildren text, "Verbatim", true

# Argument bullets plus an optional final nested body block,
# which becomes another braced command argument.
NestedCommandArgumentList ::Argument[]
  PushIndent ( ArgumentList CommandFinalArgument? )?:content PopIndent ->
    return $skip unless content
    [listArguments, final] := content
    [ ...listArguments, ...[final] if final? ]

StrictNestedStatements ::{eols: AST[], statement: AST, children: AST[]}[]
  PushStrictCurrentIndent NestedStatement*:body PopIndent -> body

ArgumentList ::Argument[]
  NestedComment*:comments Nested:eol &/\s*[*\-~]/ &Indent PushIndent ( ArgumentBullet ArgumentListContinuation* )?:content PopIndent ->
    return $skip unless content
    [first, continuations] := content
    [ { ...first, children: [ comments, eol, first.children ] }, ...continuations ]

ArgumentListContinuation ::Argument
  NestedComment*:comments SameLevel:eol ArgumentBullet:bullet ->
    { ...bullet, children: [ comments, eol, bullet.children ] }

ArgumentBullet ::Argument
  RawArgumentBullet Indent:indent Bullet:bullet RawArgumentListItemLine:text RawNestedBody:body ->
    commandArgumentBullet indent, bullet, text, body
  VerbatimArgumentBullet Indent:indent Bullet:bullet VerbatimArgumentListItemLine:text VerbatimNestedBody:body ->
    commandArgumentBullet indent, bullet, text, body, true
  TextArgumentBullet Indent:indent Bullet:bullet ListItemLine:text NestedBody:body ->
    commandArgumentBullet indent, bullet, text, body
  MathArgumentBullet Indent:indent Bullet:bullet MathArgumentListItemLine:text MathArgumentNestedBody:body ->
    commandArgumentBullet indent, bullet, text, body

```
function commandArgumentBullet(
  indent: Indent
  bullet: [string, string]
  text: AST[]
  body: AST[]
  verbatimMode = false
): Argument
  [ symbol, space ] := bullet
  delimiter: ArgumentDelimiter := if symbol is '~' then "optional" else "required"
  content := argumentAfterColon text, body, verbatimMode, delimiter
  commandArgument delimiter, "bullet", content.body, [indent, space, content]
```

RawArgumentBullet
  &(Space OptionalBullet) -> $skip unless commandArgumentIs "optional", "raw", true
  &(Space RequiredBullet) -> $skip unless commandArgumentIs "required", "raw", true

VerbatimArgumentBullet
  &(Space OptionalBullet) -> $skip unless commandArgumentIs "optional", "verbatim", true
  &(Space RequiredBullet) -> $skip unless commandArgumentIs "required", "verbatim", true

TextArgumentBullet
  &(Space OptionalBullet) -> $skip unless commandArgumentIs "optional", "text", true
  &(Space RequiredBullet) -> $skip unless commandArgumentIs "required", "text", true

MathArgumentBullet
  &(Space OptionalBullet) -> $skip unless commandArgumentIs "optional", "math", true
  &(Space RequiredBullet) -> $skip unless commandArgumentIs "required", "math", true

RawArgumentListItemLine ::AST[]
  PushListItemIndent RawText:text PopListItemIndent -> unparsedTextChildren text, "Raw"

VerbatimArgumentListItemLine ::AST[]
  PushListItemIndent VerbatimText:text PopListItemIndent -> unparsedTextChildren text, "Verbatim"

MathArgumentListItemLine ::AST[]
  PushListItemIndent MathText:text PopListItemIndent -> text

CommandFinalArgument ::Argument
  RequiredRawArgument NonEmptyStrictRawArgumentStatements:body ->
    finalCommandArgument body
  RequiredVerbatimArgument NonEmptyStrictVerbatimArgumentStatements:body ->
    finalCommandArgument body, true
  RequiredTextArgument NonEmptyStrictNestedStatements:body ->
    finalCommandArgument body
  RequiredMathArgument NonEmptyStrictMathArgumentStatements:body ->
    finalCommandArgument body

```
type ArgumentBodyStatement =
  { eols: AST[], statement: AST, children: AST[] }

function finalCommandArgument(
  body: ArgumentBodyStatement[]
  verbatimMode = false
): Argument
  { eols: [ eol ], statement: firstStatement } := body[0]
  indent := getLeadingIndent firstStatement
  let finalBody, comment
  [finalBody, comment] = commentForBody body
  if verbatimMode
    first := finalBody[0] as ArgumentBodyStatement
    unless Array.isArray first.statement
      throw new Error "Expected array statement for verbatim argument"
    finalBody = [
      {
        ...first
        children: [ first.eols[>=1], removeLeadingIndent first.statement ]
      }
      ...finalBody[>=1]
    ]
  else
    finalBody = ["%", ...finalBody]
  [open, close] := colonDelimiters()
  content := enclosedContent open, finalBody, close, comment
  commandArgument "required", "final", content.body, [eol, indent, " ", content]
```

NonEmptyStrictNestedStatements ::ArgumentBodyStatement[]
  StrictNestedStatements:body ->
    return $skip unless body#
    body

NonEmptyStrictRawArgumentStatements ::ArgumentBodyStatement[]
  PushStrictCurrentIndent NestedRawArgumentStatement*:body PopIndent ->
    return $skip unless body#
    body

NestedRawArgumentStatement ::ArgumentBodyStatement
  Nested:eols Indent:indent RawText:text ->
    { eols, statement: [ indent, text ], children: $0 }

NonEmptyStrictVerbatimArgumentStatements ::ArgumentBodyStatement[]
  PushStrictCurrentIndent NestedVerbatimArgumentStatement*:body PopIndent ->
    return $skip unless body#
    body

NestedVerbatimArgumentStatement ::ArgumentBodyStatement
  Nested:eols Indent:indent VerbatimText:text ->
    { eols, statement: [ indent, text ], children: $0 }

NonEmptyStrictMathArgumentStatements ::ArgumentBodyStatement[]
  PushStrictCurrentIndent NestedMathArgumentStatement*:body PopIndent ->
    return $skip unless body#
    body

NestedMathArgumentStatement ::ArgumentBodyStatement
  Nested:eols MathStatement:statement ->
    { eols, statement, children: $0 }

## ENVIRONMENTS

VerbatimEnvironment ::Environment
  &BeginVerbatimEnvironment ///
    \\begin[ \t]*\{ ([^{}\r\n]+) \}
    [^]*?
    \\end[ \t]*\{ \1 \}
  ///:match ->
    {
      type: "Environment"
      env: match[1]
      children: [{ type: "Verbatim", token: match[0] }]
    }

# Raw environments treat `%` as comments, so `%...\end` doesn't terminate
RawEnvironment ::Environment
  &BeginRawEnvironment ///
    \\begin[ \t]*\{ ([^{}\r\n]+) \}
    (?:
      [^\\%]+
      |
      %[^\r\n]*(?:\r\n?|\n|$)
      |
      (?! \\end[ \t]*\{ \1 \} ) \\[^]
    )*?
    \\end[ \t]*\{ \1 \}
  ///:match ->
    {
      type: "Environment"
      env: match[1]
      children: [{ type: "Raw", token: match[0] }]
    }

TextEnvironment ::Environment
  &/[ \t]*:[ \t]/ Indent:indent PushStrictIndent PushGenericTextArgumentPattern EnvironmentContent?:content PopCommandPattern PopIndent ->
    return $skip unless content
    environment indent, content

MathEnvironment ::Environment
  &/[ \t]*:[ \t]/ Indent:indent PushStrictIndent PushGenericMathArgumentPattern EnvironmentContent?:content PopCommandPattern PopIndent ->
    return $skip unless content
    environment indent, content

```
function environment(indent: Indent, content: {env: string, children: AST[]}): Environment
  { env, children } := content
  {
    type: "Environment"
    env
    children: [
      indent
      `\\begin{${env}}`
      children
      "\n"
      indent
      `\\end{${env}}`
    ]
  }
```

# Generic patterns for undeclared environments inherit the surrounding mode.
PushGenericTextArgumentPattern
  "" -> state.argumentPatterns.push "text"
PushGenericMathArgumentPattern
  "" -> state.argumentPatterns.push "math"

EnvironmentContent ::{env: string, children: AST[]}
  &RawEnvironmentHeader EnvironmentHeaderAndArguments:head TrimmedRawText:first NestedRawEnvironmentStatement*:rest ->
    { env: head.env, children: [ head.args, first, ...rest ] }
  &VerbatimEnvironmentHeader EnvironmentHeaderAndArguments:head TrimmedVerbatimText:first NestedVerbatimEnvironmentStatement*:rest ->
    { env: head.env, children: [ head.args, first, ...rest ] }
  &MathEnvironmentHeader EnvironmentHeaderAndArguments:head TrimmedMathText:first NestedMathStatement*:rest ->
    { env: head.env, children: [ head.args, first, ...rest ] }
  &TextEnvironmentHeader EnvironmentHeaderAndArguments:head TrimmedText:first NestedStatement*:rest ->
    { env: head.env, children: [ head.args, first, ...rest ] }

NestedRawEnvironmentStatement ::AST[]
  Nested:eols Indent:indent RawText:text ->
    [ eols, indent, text.children ]

NestedVerbatimEnvironmentStatement ::AST[]
  Nested:eols Indent:indent VerbatimText:text ->
    [ eols, indent, text.children ]

EnvironmentHeaderAndArguments ::{env: string, args: Argument[]}
  PushEnvironmentPattern:env CommandArgument*:args ( Space Colon ( NestedArgumentList / InlineCommandArgumentAfterColon ) )?:colonArgs PopCommandPattern ->
    colon := colonArgs?[2] ?? []
    {
      env
      args: [
        ...args
        ...if Array.isArray colon then colon else [colon]
      ]
    }

# Consume `: name` to select and push the environment's argument pattern before
# parsing its arguments. Resolve inherited argument modes from the surrounding
# mode, also used for arguments without a matching declaration.
# Return the name for the environment AST.
# EnvironmentHeaderAndArguments pops the pattern.
PushEnvironmentPattern ::string
  EnvironmentHeader:env ->
    parentMode := state.argumentPatterns.-1
    assertResolvedArgumentMode parentMode
    pushEnvironmentPattern env, parentMode
    env

```
// The caller supplies the surrounding mode; declarations independently choose
// argument modes and the grammar branch used for the body.
function pushEnvironmentPattern(env: string, parentMode: ResolvedArgumentMode): void
  if declaration := state.declarations.getEnvironment env
    pushArgumentPattern declaration.args, parentMode
  else
    state.argumentPatterns.push parentMode
```

NestedArgumentList ::Argument[]
  PushIndent ArgumentList?:content PopIndent ->
    return $skip unless content
    return content

EnvironmentHeader ::string
  ":" ActualSpace EnvironmentName:env -> env

EnvironmentName ::string
  /[^\s:([{%]+/

RawEnvironmentHeader ::string
  EnvironmentHeader:env ->
    return $skip unless environmentBodyMode(env) is "raw"
    env

VerbatimEnvironmentHeader ::string
  EnvironmentHeader:env ->
    return $skip unless environmentBodyMode(env) is "verbatim"
    env

TextEnvironmentHeader ::string
  EnvironmentHeader:env ->
    return $skip unless environmentBodyMode(env) is "text"
    env

MathEnvironmentHeader ::string
  EnvironmentHeader:env ->
    return $skip unless environmentBodyMode(env) is "math"
    env

```
/**
 * Resolve an environment's body mode, using the surrounding mode for
 * undeclared environments and declarations with an inherited body mode.
 * Only for colon environments: TextEnvironment/MathEnvironment has pushed
 * the surrounding mode onto argumentPatterns. Native \begin environments
 * may instead have an empty stack or a command pattern on top.
 */
function environmentBodyMode(env: string): ResolvedArgumentMode
  mode := state.declarations.getEnvironment(env)?.body
  if not mode? or mode is "inherit"
    parentMode := state.argumentPatterns.-1
    assertResolvedArgumentMode parentMode
    parentMode
  else
    mode
```

BeginEnvironment ::{env: string, children: AST[]}
  $/\\begin[ \t]*\{/ /[^{}\r\n]+/:env "}" ->
    { env: env[0], children: $0 }

EndEnvironment ::{env: string, children: AST[]}
  $/\\end[ \t]*\{/ /[^{}\r\n]+/:env "}" ->
    { env: env[0], children: $0 }

BeginRawEnvironment ::{env: string, children: AST[]}
  BeginEnvironment:environment ->
    return $skip unless state.declarations.getEnvironment(environment.env)?.body is "raw"
    environment

BeginVerbatimEnvironment ::{env: string, children: AST[]}
  BeginEnvironment:environment ->
    return $skip unless state.declarations.getEnvironment(environment.env)?.body is "verbatim"
    environment

BeginTextEnvironment ::{env: string, children: AST[]}
  BeginEnvironment:environment ->
    return $skip unless state.declarations.getEnvironment(environment.env)?.body is "text"
    environment

EndTextEnvironment ::{env: string, children: AST[]}
  EndEnvironment:environment ->
    return $skip unless state.declarations.getEnvironment(environment.env)?.body is "text"
    environment

BeginMathEnvironment ::{env: string, children: AST[]}
  BeginEnvironment:environment ->
    return $skip unless state.declarations.getEnvironment(environment.env)?.body is "math"
    environment

EndMathEnvironment ::{env: string, children: AST[]}
  EndEnvironment:environment ->
    return $skip unless state.declarations.getEnvironment(environment.env)?.body is "math"
    environment

BeginEndMathEnvironment ::Environment
  BeginMathEnvironment:open MathContent EndMathEnvironment:close ->
    return $skip unless open.env is close.env
    { type: "Environment", open.env, children: $0 }

BeginEndTextEnvironment ::Environment
  BeginTextEnvironment:open TextAndContent EndTextEnvironment:close ->
    return $skip unless open.env is close.env
    { type: "Environment", open.env, children: $0 }

