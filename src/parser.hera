```
{ generate } from ./main.civet
type {
  ActiveCompilerOptions,
  AST,
  Braced,
  Comment,
  ConfigEntry,
  Command,
  Environment,
  EOL,
  FootnoteDefinition,
  FootnoteRef,
  Heading,
  Indent,
  List,
  Preamble,
  Use,
  Uses,
} from ./types.civet
{
  applyCompilerOption,
  makeCompilerOptions,
} from ./config.civet
{ assertTexlishVersion } from ./version.civet
{
  commentForBody,
  commentForTextBody,
  getEndComment,
  isNumeric,
} from ./util.civet

type ParserState
  indents: Indent[]
  savedLineIndents: Indent[]
  compilerOptions: ActiveCompilerOptions
  thisLineIndent: Indent
  currentIndent: Indent

initialIndent: Indent := { type: "Indent", token: '', level: 0 }

export state: ParserState := {
  indents: [ initialIndent ]
  savedLineIndents: []
  compilerOptions: makeCompilerOptions()
  thisLineIndent: initialIndent
  get currentIndent(): Indent
    state.indents.-1
}

export function getCompilerOptions(): ActiveCompilerOptions
  state.compilerOptions

export function setCompilerOptions(options: ActiveCompilerOptions): void
  state.compilerOptions = options

export function getStateKey(): number
  state.currentIndent.level

/**
 * Prefix generated labels for shorthand references with special namespaces.
 * Returns undefined to reject shorthand meaning it should be left alone.
 */
function labelPrefix(style: string, label: string): string?
  if style is '@^'
    return if isNumeric label
    return 'footnote:'
  ''

function applyConfigAssignments(body: ConfigEntry[]): void
  if body.some [key] => key[0] is "styles"
    // Avoid aliasing so that we can copy by reference in Delimiters
    state.compilerOptions.styles = {...state.compilerOptions.styles}
  for [key, value] of body
    applyCompilerOption(state.compilerOptions, key, value)

export { ParseError }
```

Main ::AST[]
  Init Content -> $2

Init
  "" ->
    state.indents = [ initialIndent ]
    state.savedLineIndents = []
    state.thisLineIndent = initialIndent

Content ::AST[]
  Statement ( EOL Statement )* ->
    return [ $1, ...$2.flat() ]
  "" -> []

# First line starts mid-line, so uses Text; following lines assume start of line
# No Nested requirement; used in BracedContent where indentation doesn't matter
TextAndContent ::AST[]
  Text ( EOL Statement )* ->
    return [ $1, ...$2.flat() ]
  "" -> []

EOL ::EOL
  /[ \t]*(\n|\r\n?|$)/ ->
    return {
      type: "EOL",
      token: $0,
      $loc,
    }

Statement ::AST
  ActualStatement
  TextLine

ActualStatement ::AST
  Heading
  MarkdownHorizontalRulesEnabled HorizontalRule -> $2
  MetaBlock
  FootnoteDefinition
  Environment
  CommandWithColonArgument
  UnorderedList
  OrderedList

# Detect whether the next line is an actual statement, for deciding whether
# to continue a text field like a Markdown bracketed link.
IsActualStatement
  PushLineIndent (&ActualStatement)?:actual PopLineIndent ->
    return $skip unless actual

# One line of text at start of the line
# (can be empty, no newline consumption)
# except Markdown links [...](...) can consume multiple lines
TextLine ::AST[]
  Indent Text ->
    return [ $1, ...$2 ]

# One line of text, starting in the middle of a line, for inline uses
# (can be empty, no newline consumption)
# except Markdown links [...](...) can consume multiple lines
Text ::AST[]
  TextPart* InlineCommandWithColonArgument? ->
    return $1 unless $2
    return [ ...$1, $2 ]

TextPart ::AST
  MainTextPart
  [()\[\]]

# MainTextPart excludes parens/brackets; the surrounding text productions
# decide whether to parse those as balanced text or literal characters.
MainTextPart ::AST
  BracedContent
  Comment
  FootnoteRef
  # @'long ref'
  /(?<=(?:^|\s|[\p{Punctuation}\p{Symbol}]))(@[=#^]?)('[^']*'|"[^"]*"|\{[^{}]*\})/ ->
    label := $2[<..<]
    prefix := labelPrefix $1, label
    return $skip unless prefix?
    return `${state.compilerOptions.styles[$1]}{${prefix}${label}}`
  # @ref without spaces and without grabbing trailing punctuation
  /(?<=(?:^|\s|[\p{Punctuation}\p{Symbol}]))(@[=#^]?)([^()\[\]\s'"{}=~][^()\[\]\s{}~]*)(?<!\p{Punctuation})/ ->
    prefix := labelPrefix $1, $2
    return $skip unless prefix?
    return `${state.compilerOptions.styles[$1]}{${prefix}${$2}}`
  /\[\[(.*?)\]\]/ ->
    return `${state.compilerOptions.styles['[[']}{${$1}}`
  Autolink
  MarkdownLinksEnabled MarkdownLink -> $2
  ScriptGroupingNumeric /([\^_])(\d{2,})/:script ->
    return `${script[1]}{${script[2]}}`
  ScriptGroupingAlpha /([\^_])([a-zA-Z]{2,})/:script ->
    return `${script[1]}{${script[2]}}`
  ScriptGroupingAlphanumeric /([\^_])([a-zA-Z0-9]{2,})/:script ->
    return `${script[1]}{${script[2]}}`
  ScriptParensEnabled [\^_]:script &/\((?![ \t]*[\^_])/ ParenthesizedText:body ->
    // body[1] strips the parens
    return [ script[0], '{', body[1], '}' ]
  # Left- *and* right-flanking delimiter according to below definitions.
  /(?<![\*\s]|^)(\*+)(?![\*\s]|$)(?:(?![\p{Punctuation}\p{Symbol}])(?<![\p{Punctuation}\p{Symbol}]\1)|(?=[\p{Punctuation}\p{Symbol}])(?<=(?:[\p{Punctuation}\p{Symbol}])\1))/ ->
    return {
      type: "Delimiter",
      open: true,
      close: true,
      styles: state.compilerOptions.styles,
      symbol: $1,
      token: $1,
    }
  # https://spec.commonmark.org/0.31.2/#emphasis-and-strong-emphasis
  # defines "left-flanking delimiter run" as (1) not followed by a space, and
  # (2a) not followed by punctuation, or (2b) [followed by punctuation and]
  # preceded by whitespace or punctuation.
  /(?<!\*)(\*+)(?![\*\s]|$)(?:(?![\p{Punctuation}\p{Symbol}])|(?<=(?:^|\s|[\p{Punctuation}\p{Symbol}])\1))/ ->
    return {
      type: "Delimiter",
      open: true,
      close: false,
      styles: state.compilerOptions.styles,
      symbol: $1,
      token: $1,
    }
  # "Right-flanking delimiter run" is (1) not preceded by a space, and
  # (2a) not preceded by punctuation, or (2b) [preceded by punctuation and]
  # followed by whitespace or punctuation.
  /(?<![\*\s]|^)(\*+)(?!\*)(?:(?<![\p{Punctuation}\p{Symbol}]\1)|(?=$|\s|[\p{Punctuation}\p{Symbol}]))/ ->
    return {
      type: "Delimiter",
      open: false,
      close: true,
      styles: state.compilerOptions.styles,
      symbol: $1,
      token: $1,
    }
  # Leave trailing InlineCommandWithColonArgument for TextLine to parse
  !InlineCommandWithColonArgument Command -> $2
  # Skip to next interesting character
  /[^\r\n\\()\[\]{}%][^\r\n@#<\\\^_()\[\]{}%\*]*/

ParenthesizedText ::AST[]
  "(" ParenContent ")"

ParenContent ::AST[]
  ParenText:text ParenContinuation*:body -> [ text, ...body ]

ParenContinuation ::AST[]
  NonstrictlyNested !IsActualStatement Indent ParenText -> [ $1, $3, $4 ]

ParenText ::AST[]
  ParenTextPart*

ParenTextPart ::AST
  MainTextPart
  [\[\]]
  # Keep parentheses balanced
  ParenthesizedText

BracketedText ::AST[]
  "[" BracketContent "]"

BracketContent ::AST[]
  BracketText:text BracketContinuation*:body -> [ text, ...body ]

BracketContinuation ::AST[]
  NonstrictlyNested !IsActualStatement Indent BracketText -> [ $1, $3, $4 ]

BracketText ::AST[]
  BracketTextPart*

BracketTextPart ::AST
  MainTextPart
  [()]
  # Keep brackets balanced
  BracketedText

MarkdownLink ::AST
  BracketedText:body "(" MarkdownLinkDestination:url ")" ->
    return {
      children: [
        "\\protect\\href{"
        url
        "}{"
        // [1] strips the brackets
        body[1]
        "}"
      ]
    }

MarkdownLinkDestination ::string
  "<" MarkdownAngleLinkDestinationPart*:parts ">" -> parts.join ''
  MarkdownBareLinkDestinationPart+:parts -> parts.join ''

MarkdownAngleLinkDestinationPart ::string
  MarkdownBackslashEscape
  [^\x00-\x1f\x7f\r\n<>\\]+

MarkdownBareLinkDestinationPart ::string
  "(" MarkdownBareLinkDestinationPart*:parts ")" -> `(${parts.join ''})`
  [^\x00-\x1f\x7f\s()<>\\]+
  MarkdownBackslashEscape

MarkdownBackslashEscape ::string
  /\\([!-\/:-@\[-`{-~])/ -> $1
  "\\"

FootnoteRef ::FootnoteRef
  /\[\^([^\]\r\n]+)\]/:marker (&EOL)?:eolNext ->
    return {
      type: "FootnoteRef",
      id: marker[1].trim(),
      eolNext: Boolean(eolNext),
      children: [marker[0]],
    }

TrimmedText ::AST[]
  Text:t ->
    t = [...t]
    t[0] = t[0].trimStart() if t[0] <? 'string'
    last := t# - 1
    t[last] = t[last].trimEnd() if t[last] <? 'string'
    return t

# Analog of Text but with no Texlish processing, used e.g. for ::tex
RawText ::[string, Comment | undefined]
  /[^%\r\n]*/:text Comment?:comment -> [ text[0], comment ]

TrimmedRawText ::AST[]
  RawText:t ->
    [ text, comment ] .= t
    [
      if comment then text.trimStart() else text.trim()
      comment
    ]

BracedContent ::Braced
  "{":open TextAndContent:body "}":close ->
    let comment
    [body, comment] = commentForBody(body)
    // Drop single %
    comment = undefined if comment is like { token: "%" }
    return {
      type: "Braced"
      body
      children: [
        open
        body
        close
        comment
      ]
    }

Comment ::Comment
  /%[^\r\n]*/ ->
    return {
      type: "Comment",
      token: $0,
      $loc,
    }

CommentEOL ::AST[]
  Comment EOL

Command ::Command
  CommandWithoutNewline
  /\\(?=[\r\n]|$)/ ->
    return {
      type: "Command",
      token: $0,
    }

# Forbids \ followed by newline
CommandWithoutNewline ::Command
  /\\([a-zA-Z@]+|[^\r\n])/ ->
    return {
      type: "Command",
      token: $0,
    }

# Command that can be followed by a colon argument
# Forbids \ followed by newline
# Captures * after command name to allow e.g. \section*: Acknowledgments
StarredCommand ::Command
  CommandWithoutNewline /[ \t]*\*/? ->
    return $1 unless $2
    return { ...$1, token: $1.token + $2[0] }

Heading ::Heading
  /(!+|\.*)(#+)(\*?)\s+/ TrimmedText:title ->
    [, dot, hash, star] .= $1
    dots := dot#
    hashes := hash#
    command .=
      if dot[0] is "!"
        if dots > 1 or hashes > 1 then '\\part' else '\\chapter'
      else if dots
        if dots > 1 or hashes > 1 then '\\subparagraph' else '\\paragraph'
      else
        `\\${'sub'.repeat(hashes-1)}section`
    command += '*' if star
    return {
      type: "Heading",
      subtype: command,
      children: [ command, '{', title, '}' ],
    }

HorizontalRule ::AST[]
  Indent:indent $/-(?:[ \t]*-){2,}/:marker /[ \t]*/ Comment?:comment &EOL ->
    if style := state.compilerOptions.styles[marker]
      return [ indent, style, comment ]
    // For rules consisting of just -, use the closest configured shorter style
    unless /[ \t]/.test marker
      for length of [marker# >..3]
        if style := state.compilerOptions.styles['-'.repeat length]
          return [ indent, style, comment ]
    return [ indent, state.compilerOptions.styles['---'] ?? "\\hrule", comment ]

# https://spec.commonmark.org/0.31.2/#autolinks
Autolink ::AST
  # "An absolute URI, for these purposes, consists of a scheme [any sequence of 2–32 characters beginning with an ASCII letter and followed by any combination of ASCII letters, digits, or the symbols plus, period, or hyphen] followed by a colon (:) followed by zero or more characters other than ASCII control characters, space, <, and >."
  /<([a-zA-Z][a-zA-Z0-9\+\.\-]{1,31}:[^\x00-\x1f\x7f\s<>]*)>/ ->
    return `\\protect\\url{${$1}}`
  # "An email address, for these purposes, is anything that matches the non-normative regex from the HTML5 spec"
  # Texlish additionally allows {a,b} in the userid, which is common in papers
  /<([a-zA-Z0-9.!#$%&'\*\+\/=\?\^_`{\|}~\-,]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*)>/ ->
    email .= $1
    // Convert {a,b}@domain to mailto:a@domain,b@domain
    if match := /\{([a-zA-Z0-9.!#$%&'\*\+\/=\?\^_`\|~\-,]+)\}/.exec email
      email = match[1].split(',').map (part) =>
        email[< match.index] + part + email[>= match.index + match[0]#]
      .join(',')
    // commonmark.js dingus escapes as follows:
    email = email
    .replace /&/g, '&amp;'
    .replace /[%^`|]/g, (m: string) => `%${m.charCodeAt(0).toString(16).toUpperCase()}`
    return `\\protect\\href{mailto:${email}}{\\protect\\nolinkurl{${$1}}}`

Environment ::Environment
  # use NestedStatement* instead of NestedBody so that we can PushIndent early
  # (in case ColonArgument involves multiple lines)
  &/[ \t]*:[ \t]/ Indent:indent PushIndent ( /:[ \t]+([^:\s\[%]+)/ ( InlineColonArgument / TrimmedText ) NestedStatement* )?:content PopIndent ->
    return $skip unless content
    [ envMatch, first, body ] .= content
    env := envMatch[1].trim()
    return {
      type: "Environment",
      env,
      children: [
        indent,
        `\\begin{${env}}`,
        first,
        body,
        "\n",
        indent,
        `\\end{${env}}`,
      ]
    }

CommandWithColonArgument ::AST[]
  Indent:indent StarredCommand:command ColonArgument:arg

FootnoteDefinition ::FootnoteDefinition
  Indent:indent /\[\^([^\]\r\n]+)\]/:marker Colon:colon ArgumentAfterColon:arg ->
    body: AST[] :=
      if Array.isArray arg
        arg
      else // type: "Braced"
        if Array.isArray arg.body
          arg.body
        else
          [arg.body]
    return {
      type: "FootnoteDefinition"
      id: marker[1].trim()
      body
      // In case this footnote definition isn't used, its fallback text is
      // roughly the original.
      children: [
        indent
        marker[0]
        colon
        // Unwrap ArgumentAfterColon
        if body?.[0] is "%" then body[>=1] else [ " ", body ]
      ]
    }

# Inline version prevents combining same-line and indented content
InlineCommandWithColonArgument ::AST[]
  StarredCommand InlineColonArgument

ColonArgument ::AST
  Colon ArgumentAfterColon -> $2

InlineColonArgument ::AST
  Colon InlineArgumentAfterColon -> $2

# ":", but don't treat :: as :
Colon
  /:(?!:)/

ArgumentAfterColon ::AST[] | Braced
  NestedArgumentList
  TrimmedText:text NestedBody:body ->
    // If nothing on first line, comment out the newline
    text = ["%"] if not text# and body#
    let comment
    [text, body, comment] = commentForTextBody(text, body)
    textBody := [ text, body ]
    return {
      type: "Braced"
      body: textBody
      children: [
        "{"
        textBody
        "}"
        comment
      ]
    }

InlineArgumentAfterColon ::AST
  NestedArgumentList
  NonEmptyNestedBody:body ->
    let comment
    [body, comment] = commentForBody(body)
    return {
      type: "Braced"
      body
      children: [
        "{%"
        body
        "}"
        comment
      ]
    }
  TrimmedText:body ->
    let comment
    [body, comment] = commentForBody(body)
    return {
      type: "Braced"
      body
      children: [
        "{"
        body
        "}"
        comment
      ]
    }

MetaBlock ::AST[]
  &/[ \t]*::/ Indent:indent "::" /\s*/ MetaCommand:cmd -> [indent, cmd]

MetaCommand ::AST
  MetaVersion
  MetaConfig
  MetaStyles
  MetaUse
  MetaTex
  MetaPreamble

MetaVersion ::AST
  "version" /[ \t]+([^\r\n%]+)/:range Comment? ->
    assertTexlishVersion(range[1].trim())
    return '\0'  // eat following newline

MetaConfig ::AST
  "config" /[ \t]+/ ConfigAssignment:body ->
    applyConfigAssignments(body)
    return '\0'  // eat following newline
  "config" NestedConfigAssignments:body ->
    applyConfigAssignments(body)
    return '\0'  // eat following newline

MetaStyles ::AST
  "styles" NestedConfigAssignments:body ->
    // Avoid aliasing so that we can copy by reference in Delimiters
    state.compilerOptions.styles = {...state.compilerOptions.styles}
    for [key, value] of body
      applyCompilerOption state.compilerOptions, ["styles", ...key], value
    return '\0'  // eat following newline

NestedConfigAssignments ::ConfigEntry[]
  PushIndent NestedConfigAssignment*:items PopIndent ->
    return items.flat()

NestedConfigAssignment ::ConfigEntry[]
  Nested Indent ConfigAssignment:assignment -> assignment

ConfigAssignment ::ConfigEntry[]
  $/[^:%\r\n]+(?==)/:key ConfigRHS:value ->
    return value.map(([subpath, value]) => [[...key.trimEnd().split('.'), ...subpath], value])
  $/[^\s:=%]+/:key NestedConfigRHS:value ->
    return value.map(([subpath, value]) => [[...key.split('.'), ...subpath], value])

NestedConfigRHS ::ConfigEntry[]
  # `key:` for nested config
  /[ \t]*:[ \t]*/ NestedConfigAssignments:items ->
    return items
  ConfigRHS:rhs -> rhs

ConfigRHS ::ConfigEntry[]
  # `key=value`
  /[ \t]*=/ TrimmedRawText:value ->
    return [[[], generate(value)]]
  # `key` alone enables option
  "" ->
    return [[[], true]]

MetaUse ::AST
  "use" [ \t]+ UseItem:item -> item
  "use" NestedUseList:list -> list

MetaTex ::AST[]
  "tex" /\b[ \t]?/ RawText:text RawNestedBody:body -> [text, body]

UseItem ::Use
  Bullet? $(/[^:%\r\n]+/):name Comment?:comment UseColonArgument?:arg ->
    match := /\s*$/.exec(name)!
    space := match[0]
    name = name[< match.index]
    return {
      type: "Use"
      children: [
        '\\usepackage'
        arg
        `{${name}}`
        space
        comment
      ]
    }

NestedUseList ::Uses
  PushIndent NestedUseItem*:items PopIndent ->
    return $skip unless items#
    return {
      type: "Uses"
      children: items
    }

NestedUseItem ::AST[]
  Nested Indent UseItem ->
    return $0

UseColonArgument ::AST[]
  SaveIndent:indent Colon UseArgument:arg ->
    return [
      "["
      arg
      if getEndComment(arg) then [ "\n", indent ]
      "]"
    ]

UseArgument ::AST
  TrimmedRawText ( NestedUseArgumentList / NonEmptyRawNestedBody )?

NestedUseArgumentList ::AST[]
  PushIndent ( NonstrictlyNested UseArgumentList )?:content PopIndent ->
    return $skip unless content
    return content

UseArgumentList ::AST[]
  &/\s*[*\-~]/ &Indent PushIndent ( UseArgumentBullet ( SameLevel UseArgumentBullet )* )?:content PopIndent ->
    return $skip unless content
    // Add commas between bullets
    [ first, rest ] .= content
    rest = rest.map [ eol, [ indent, , ...rest ] ] =>
      [ eol, [ indent, ",",  ...rest ] ]
    return [ first, rest ]

UseArgumentBullet ::AST[]
  Indent:indent /([*\-~])([ \t]+)/ RawText:text RawNestedBody:body ->
    [ , , space ] .= $2
    return [
      indent
      " ", space // indent the same as the bullet
      text
      body
    ]

NonEmptyNestedBody ::AST[]
  NestedBody ->
    return $skip unless $1#
    return $1

# can be empty; if not desired, use NonEmptyNestedBody
NestedBody ::AST[]
  PushIndent NestedStatement* PopIndent -> $2

NestedStatement ::AST[]
  Nested Statement

# Raw versions of above
NonEmptyRawNestedBody ::AST[]
  RawNestedBody ->
    return $skip unless $1#
    return $1

RawNestedBody ::AST[]
  PushIndent ( Nested Indent RawText )* PopIndent -> $2

MetaPreamble ::Preamble
  "preamble" ( /[ \t]+/ Text )?:text NestedBody:body ->
    preambleText := text?[1]
    textBody := [ preambleText, body ]
    return {
      type: "Preamble"
      textBody
      children: [ textBody ]
    }

UnorderedList ::List
  &/[ \t]*[*\-~]/ Indent:indent PushIndent ( UnorderedBullet ( SameLevel Indent UnorderedBullet )* )?:items PopIndent ->
    return $skip unless items
    return {
      type: "List"
      subtype: "itemize"
      children: [
        indent
        "\\begin{itemize}"
        "\n"
        indent
        items
        "\n"
        indent
        "\\end{itemize}"
      ]
    }

UnorderedBullet ::AST[]
  Bullet:bullet Text:text NestedBody:body ->
    space := bullet[1]
    return [ '\\item', space, text, body ]

Bullet
  /([*\-~])([ \t]+|(?=[\r\n]))/ -> [ $1, $2 ]

OrderedList ::List
  &/[ \t]*\d+\./ Indent:indent PushIndent ( OrderedBullet ( SameLevel Indent OrderedBullet )* )?:items PopIndent ->
    return $skip unless items
    return {
      type: "List",
      subtype: "enumerate",
      children: [
        indent
        "\\begin{enumerate}"
        "\n"
        indent
        items
        "\n"
        indent
        "\\end{enumerate}"
      ]
    }

OrderedBullet ::AST[]
  /\d+\.([ \t]+|(?=[\r\n]))/ Text:text NestedBody:body ->
    space := $1[1]
    return [ '\\item', space, text, body ]

NestedArgumentList ::AST[]
  PushIndent ( NonstrictlyNested ArgumentList )?:content PopIndent ->
    return $skip unless content
    return content

ArgumentList ::AST[]
  &/\s*[*\-~]/ &Indent PushIndent ( ArgumentBullet ( SameLevel ArgumentBullet )* )?:content PopIndent ->
    return $skip unless content
    return content

ArgumentBullet ::AST[]
  Indent:indent Bullet:bullet Text:text NestedBody:body ->
    [ symbol, space ] .= bullet
    let comment
    [text, body, comment] = commentForTextBody text, body
    open := if symbol is '~' then '[' else '{'
    close := if symbol is '~' then ']' else '}'
    return [
      indent
      space // indent the same as the bullet, except 1 for *-~ and {
      open
      text
      body
      close
      comment
    ]

## Config

ScriptGroupingNumeric
  "" ->
    return $skip unless state.compilerOptions.scriptGrouping is "numeric"

ScriptGroupingAlpha
  "" ->
    return $skip unless state.compilerOptions.scriptGrouping is "alpha"

ScriptGroupingAlphanumeric
  "" ->
    return $skip unless state.compilerOptions.scriptGrouping is "alphanumeric"

ScriptParensEnabled
  "" ->
    return $skip unless state.compilerOptions.scriptParens

MarkdownHorizontalRulesEnabled
  "" ->
    return $skip unless state.compilerOptions.markdownHorizontalRules

MarkdownLinksEnabled
  "" ->
    return $skip unless state.compilerOptions.markdownLinks

## Indentation management, inspired by Civet's parser.hera

Indentation ::Indent
  /[ \t]*/ ->
    numTabs := $0.match(/\t/g)?# ?? 0
    level := numTabs * 8 + ($0# - numTabs)
    return {
      type: "Indent"
      token: $0
      level
      $loc
    }

Indent ::Indent
  Indentation ->
    return state.thisLineIndent = $1

PushIndent
  "" ->
    //const {level} = indent
    //if (level < state.currentIndent.level) return $skip
    state.indents.push(state.thisLineIndent)

PopIndent
  "" ->
    state.indents.pop()

# Here and below, EOL+ skips over blank lines without correct indentation
Nested ::AST[]
  EOL+ &IndentedFurther -> $1

IndentedFurther ::Indent
  Indentation:indent ->
    return $skip if indent.level <= state.currentIndent.level
    return $0

SameLevel ::AST[]
  EOL+ &IndentedSame -> $1

IndentedSame ::Indent
  Indentation:indent ->
    return $skip unless indent.level is state.currentIndent.level
    return $0

NonstrictlyNested ::AST[]
  EOL+ &IndentedNotLess -> $1

IndentedNotLess ::Indent
  Indentation:indent ->
    return $skip if indent.level < state.currentIndent.level
    return $0

SaveIndent ::Indent
  "" -> state.thisLineIndent

# When testing whether a rule matches via `&` or `!`, but the rule uses Indent
# so sets state.thisLineIndent, use these to restore the previous value.
PushLineIndent
  "" -> state.savedLineIndents.push(state.thisLineIndent)

PopLineIndent
  "" -> state.thisLineIndent = state.savedLineIndents.pop()!
