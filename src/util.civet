type { AST, ASTObject, ASTParent, Comment, Indent } from ./types.civet

/** Escape text for literal use in a regular-expression pattern. */
export function escapeRegExp(text: string): string
  text.replace /[.*+?^${}()|[\]\\]/g, "\\$&"

export function isNumeric(value: string): boolean
  /^\d+$/.test value

export function visualWidth(text: string): number
  numTabs := text.match(/\t/g)?# ?? 0
  numTabs * 8 + (text# - numTabs)

export function reduceVisualIndent(text: string, amount: number): string
  return text unless amount > 0
  for each char, i of text
    return text[>= i] unless amount > 0
    if char is "\t"
      amount -= 8
      if amount < 0
        return " ".repeat(-amount) + text[>= i + 1]
    else if char is " "
      amount--
    else
      return text[>= i]
  ""

/** Generate all nodes in the tree in prefix order. */
export function iterate(node: AST): Generator<AST>
  yield node
  return unless node <? "object"
  if Array.isArray node
    for each child of node
      yield* iterate child
  else if "children" in node
    yield* iterate node.children

/**
Generate all array nodes in the tree in prefix order,
with arrays flattened
*/
export function iterateFlatArrays(node: AST): Generator<AST[]>
  if Array.isArray node
    //@ts-ignore deep type recursion
    node = node.flat Infinity
    yield node
  return unless node <? "object"
  if Array.isArray node
    for each child of node
      yield* iterateFlatArrays child
  else if "children" in node
    yield* iterateFlatArrays node.children

/** Yield each run of consecutive strings in the flattened AST arrays. */
export function iterateTextRuns(node: AST): Generator<string>
  for parent of iterateFlatArrays node
    text .= ""
    for child of parent
      if child <? "string"
        text += child
      else if text
        yield text
        text = ""
    yield text if text

/** Generate every node twice, once before and once after recursion. */
export function iteratePrePost(node: AST): Generator<{node: AST, post: boolean}>
  yield {node, post: false}
  return unless node <? "object"
  if Array.isArray node
    for each child of node
      yield* iteratePrePost child
  else if "children" in node
    for each child of node.children
      yield* iteratePrePost child
  yield {node, post: true}

/** Find any node that matches a given condition, or undefined if not found. */
export function find<T extends AST>(node: AST, match: (candidate: AST) => candidate is T): T?
export function find(node: AST, match: (candidate: AST) => boolean): AST
export function find(node: AST, match: (candidate: AST) => boolean): AST
  for subnode of iterate node
    if match subnode
      return subnode
  return

/**
 * Check for completely empty node, in particular including empty array.
 * Any object or nonempty string is treated as nonempty.
 */
export function isEmpty(node: AST): boolean
  unless node
    true
  else if Array.isArray node
    for every child of node
      isEmpty child
  else
    false

/**
Find an "end" node (some step down the path of last nonempties)
that matches a given condition, or undefined if not found.
*/
export function getEnd<T extends AST>(node: AST, match: (candidate: AST) => candidate is T): T?
export function getEnd(node: AST, match: (candidate: AST) => boolean): AST
export function getEnd(node: AST, match: (candidate: AST) => boolean): AST
  if match node
    node
  else
    return unless node <? "object"
    if Array.isArray node
      // Ignore trailing undefined and empty string
      i .= node# - 1
      while i >= 0 and isEmpty node[i]
        i--
      if i >= 0
        getEnd node[i], match
    else if "children" in node
      getEnd node.children, match

/** Final string or token at the end of a subtree, or an empty string if absent */
export function getEndString(node: AST): string
  end := getEnd node, (node) => node <? "string" or node is like { token }
  if end <? "string"
    end
  else if { token } := end
    token
  else
    ""

/**
Modify an "end" node (some step down the path of last nonempties)
where the modify function returns something different.
*/
export function modifyEnd(node: AST, modify: (candidate: AST) => AST): AST
  replacements := new Map<ASTObject, AST>
  function recurse(node: AST): AST
    result .= modify node
    if result is node and node <? "object"
      if Array.isArray node
        children := [ ...node ]
        // Remove trailing undefined and empty string.
        while children# and isEmpty children.-1
          children.pop()
        children.-1 = recurse children.-1 if children#
        result = children
      else if "children" in node
        recurse node.children
        result = withReplacements node, replacements
    replacements.set node, result if node <? "object" and result is not node
    result
  recurse node

/** Shallow copy with matching object references replaced */
function withReplacements<T extends { children?: AST[] }>(node: T, replacements: ReadonlyMap<object, AST>): T
  copy := { ...node }
  for key, value in node
    if value? <? "object" and replacements.has value
      copy[key] = replacements.get(value) as T[typeof key]
  copy

/**
 * Replace the first occurrence in a subtree, copying ancestors and aliases.
 * Based on Civet's replaceNode, adapted to copy instead of mutate:
 * https://github.com/DanielXMoore/Civet/blob/main/source/parser/util.civet
 */
export function withNodeReplaced(node: AST, newNode: AST, parent: AST): AST
  replacements := new Map<ASTObject, AST>
  found .= false
  function recurse(current: AST): AST
    return current if found
    result .= current
    if current is node
      found = true
      result = newNode
    else if Array.isArray current
      children := current.map recurse
      result = children if children.some (child, i) => child is not current[i]
    else if current <? "object" and "children" in current
      children := recurse current.children
      result = withReplacements current, replacements if children is not current.children
    replacements.set current, result if current <? "object" and result is not current
    result
  result := recurse parent
  throw new Error "withNodeReplaced: node not found in subtree" unless found
  result

/**
 * Return the leading emitted indent.
 * Assumes/asserts the first array entry or first child is an Indent node.
 */
export function getLeadingIndent(node: AST): Indent
  if Array.isArray node
    unless node[0] is like { type: "Indent" }
      throw new Error "Expected leading indent"
    node[0] as Indent
  else if node is like { children }
    getLeadingIndent node.children
  else
    throw new Error "Expected leading indent"

/**
 * Copy an AST array or parent node with the leading emitted indent suppressed.
 * Assumes/asserts the first array entry or first child is an Indent node.
 */
export function removeLeadingIndent<T extends AST[]>(node: T): T
export function removeLeadingIndent<T extends ASTParent>(node: T): T
export function removeLeadingIndent(node: AST[] | ASTParent): AST[] | ASTParent
  indent := getLeadingIndent node
  withNodeReplaced(indent, { ...indent, token: "" }, node) as AST[] | ASTParent

/** Trim end whitespace */
export function trimEnd(node: AST[]): AST[]
export function trimEnd(node: AST): AST
export function trimEnd(node: AST): AST
  modifyEnd node, (node) =>
    if node <? "string"
      node.trimEnd()
    else
      node

export function getTrimEnd(node: AST): string
  end := getEnd node, & <? "string"
  return '' unless end
  end.match(/\s*$/)!
  |> &[0]

export function getEndComment(node: AST): Comment?
  getEnd node, (is like { type: "Comment" })

export function trimEndComment(node: AST[]): AST[]
export function trimEndComment(node: AST): AST
export function trimEndComment(node: AST): AST
  modifyEnd node, (node) =>
    if node is like { type: "Comment" }
      undefined
    else
      node

/** Extract comment at end of [text, body] pair to replace comment */
export function commentForTextBody(text: AST[], body: AST[]): [AST[], AST[], Comment]
  let comment: Comment?
  if body#
    if bodyComment := getEndComment body
      body = body |> trimEndComment |> trimEnd
      comment = bodyComment
  else
    if textComment := getEndComment text
      text = text |> trimEndComment |> trimEnd
      comment = textComment
  comment ?=
    type: "Comment"
    token: "%"
    implicit: true
  [text, body, comment]

export function commentForBody(body: AST[]): [AST[], Comment]
  let comment: Comment?
  if bodyComment := getEndComment body
    body = body |> trimEndComment |> trimEnd
    comment = bodyComment
  comment ?=
    type: "Comment"
    token: "%"
    implicit: true
  [body, comment]
