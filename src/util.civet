type { AST, ASTParent, Comment, Indent } from ./types.civet

export function isNumeric(value: string): boolean
  /^\d+/.test value

/** Generate all nodes in the tree in prefix order. */
export function iterate(node: AST): Generator<AST>
  yield node
  return unless node <? "object"
  if Array.isArray node
    for each child of node
      yield* iterate child
  else if "children" in node
    yield* iterate node.children

/**
Generate all array nodes in the tree in prefix order,
with arrays flattened
*/
export function iterateFlatArrays(node: AST): Generator<AST[]>
  if Array.isArray node
    //@ts-ignore deep type recursion
    node = node.flat Infinity
    yield node
  return unless node <? "object"
  if Array.isArray node
    for each child of node
      yield* iterateFlatArrays child
  else if "children" in node
    yield* iterateFlatArrays node.children

/** Generate every node twice, once before and once after recursion. */
export function iteratePrePost(node: AST): Generator<{node: AST, post: boolean}>
  yield {node, post: false}
  return unless node <? "object"
  if Array.isArray node
    for each child of node
      yield* iteratePrePost child
  else if "children" in node
    for each child of node.children
      yield* iteratePrePost child
  yield {node, post: true}

/** Find any node that matches a given condition, or undefined if not found. */
export function find<T extends AST>(node: AST, match: (candidate: AST) => candidate is T): T?
export function find(node: AST, match: (candidate: AST) => boolean): AST
export function find(node: AST, match: (candidate: AST) => boolean): AST
  for subnode of iterate node
    if match subnode
      return subnode
  return

/**
 * Check for completely empty node, in particular including empty array.
 * Any object or nonempty string is treated as nonempty.
 */
export function isEmpty(node: AST): boolean
  unless node
    true
  else if Array.isArray node
    for every child of node
      isEmpty child
  else
    false

/**
Find an "end" node (some step down the path of last nonempties)
that matches a given condition, or undefined if not found.
*/
export function getEnd<T extends AST>(node: AST, match: (candidate: AST) => candidate is T): T?
export function getEnd(node: AST, match: (candidate: AST) => boolean): AST
export function getEnd(node: AST, match: (candidate: AST) => boolean): AST
  if match node
    node
  else
    return unless node <? "object"
    if Array.isArray node
      // Ignore trailing undefined and empty string
      i .= node# - 1
      while i >= 0 and isEmpty node[i]
        i--
      if i >= 0
        getEnd node[i], match
    else if "children" in node
      getEnd node.children, match

/**
Modify an "end" node (some step down the path of last nonempties)
where the modify function returns something different.
*/
export function modifyEnd(node: AST, modify: (candidate: AST) => AST): AST
  mod := modify node
  if mod is not node
    mod
  else
    return node unless node <? "object"
    if Array.isArray node
      node = [ ...node ]
      // Remove trailing undefined and empty string
      while node# and isEmpty node.-1
        node.pop()
      node.-1 = modifyEnd node.-1, modify
      node
    else if "children" in node
      {
        ...node
        children: modifyEnd(node.children, modify) as AST[]
      }
    else
      node

/**
 * Copy an AST array or parent node with the leading emitted indent suppressed.
 * Assumes/asserts the first array entry or first child is an Indent node.
 */
export function removeLeadingIndent<T extends AST[]>(node: T): T
export function removeLeadingIndent<T extends ASTParent>(node: T): T
export function removeLeadingIndent(node: AST[] | ASTParent): AST[] | ASTParent
  if Array.isArray node
    unless node[0] is like { type: "Indent" }
      throw new Error "Expected leading indent"
    [ { ...node[0] as Indent, token: "" }, ...node[>=1] ]
  else
    { ...node, children: removeLeadingIndent node.children }

/** Trim end whitespace */
export function trimEnd(node: AST[]): AST[]
export function trimEnd(node: AST): AST
export function trimEnd(node: AST): AST
  modifyEnd node, (node) =>
    if node <? "string"
      node.trimEnd()
    else
      node

export function getTrimEnd(node: AST): string
  end := getEnd node, & <? "string"
  return '' unless end
  end.match(/\s*$/)!
  |> &[0]

export function getEndComment(node: AST): Comment?
  getEnd node, (is like { type: "Comment" })

export function trimEndComment(node: AST[]): AST[]
export function trimEndComment(node: AST): AST
export function trimEndComment(node: AST): AST
  modifyEnd node, (node) =>
    if node is like { type: "Comment" }
      undefined
    else
      node

/** Extract comment at end of [text, body] pair to replace comment */
export function commentForTextBody(text: AST[], body: AST[]): [AST[], AST[], Comment]
  let comment: Comment?
  if body#
    if bodyComment := getEndComment body
      body = body |> trimEndComment |> trimEnd
      comment = bodyComment
  else
    if textComment := getEndComment text
      text = text |> trimEndComment |> trimEnd
      comment = textComment
  comment ?=
    type: "Comment"
    token: "%"
  [text, body, comment]

export function commentForBody(body: AST[]): [AST[], Comment]
  let comment: Comment?
  if bodyComment := getEndComment body
    body = body |> trimEndComment |> trimEnd
    comment = bodyComment
  comment ?=
    type: "Comment"
    token: "%"
  [body, comment]
